---
import Layout from "../../../layouts/Layout.astro";
import SimpleNav from "../../../components/SimpleNav.astro";
import VideoConverterPageContent from "../../../components/VideoConverterPageContent.astro";
import { content } from "../../../content/site.js";

const t = content.es;
---

<Layout
  title={`${t.videoConverter.title} | ${t.seo.title}`}
  description={t.videoConverter.seo.description}
  bodyClass="redesign"
  lang="es"
>
  <SimpleNav t={t} />
  <VideoConverterPageContent t={t} />
</Layout>