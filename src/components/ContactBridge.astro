---
// The way out of Tools into Contacto. Contacto is the dawn: its boundary is a
// HORIZON, not a rule: over the end of Tools the champagne goes to black
// through gold, and the black rises as a very shallow dome whose rim is a thin
// line of light (the edge of a planet at dawn), with stars just under it. (The
// rule-and-scale belongs to Servicios, the lip of metal to Tools.)
//   Light: from the foot of the tools catalog a single thread goes down through
//   the gradient and the horizon to a beacon (a diamond) over the title of
//   Contacto. When it lights, a signal leaves it: a gold ring, with two fainter
//   ones behind, grows out from the beacon and uncovers the title, the line and
//   the two cards as it passes (the circle that opened Proyectos closes the
//   path here).
// The thread and the signal run by TIME once the catalog has come into view,
// only on desktop (900px and up) and with motion; otherwise only the gradient,
// the horizon and the stars are there, static. Positions are measured from the
// catalog, the section and the title.
---

<div class="cb" data-cb aria-hidden="true">
  <span class="cb-thread"><i class="cb-lit"></i><i class="cb-spark"></i></span>
  <i class="cb-node cb-node--o"></i>
  <i class="cb-node cb-node--b"></i>
  <div class="cb-rings">
    <i class="cb-ring cb-ring--3"></i>
    <i class="cb-ring cb-ring--2"></i>
    <i class="cb-ring cb-ring--1"></i>
  </div>
</div>
<!-- The boundary itself, always there. -->
<div class="cb-sheet" aria-hidden="true">
  <i class="cb-fade"></i>
  <i class="cb-theme section-theme-dark"></i>
  <i class="cb-glow"></i>
  <i class="cb-arc"></i>
</div>
<!-- Stars just under the horizon (behind the content). -->
<i class="cb-stars" aria-hidden="true"></i>

<style is:global>
  /* Until the signal passes them, the head and the cards are covered: a circle
     around the beacon (--cr, its radius; --ox/--oy, the beacon in each
     element's own box). `cb-revealed` lifts it when the signal has finished. */
  .cb-wired:not(.cb-revealed) [data-cb-reveal] {
    clip-path: circle(var(--cr, 0px) at var(--ox, 50%) var(--oy, 0px));
  }
</style>

<style>
  .cb-sheet {
    --fade-h: clamp(8rem, 12vw, 10.5rem);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 2;
    height: 0;
    /* The horizon's ellipse is wider than the page: clip it sideways only (the
       glow above the rim must still show). */
    overflow-x: clip;
    pointer-events: none;
  }

  /* Over the end of Tools: champagne to black through gold, eased. */
  .cb-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--fade-h);
    background: linear-gradient(
      180deg,
      rgb(176 138 50 / 0%) 0,
      rgb(176 138 50 / 26%) 18%,
      rgb(140 104 34 / 58%) 38%,
      rgb(88 64 22 / 84%) 58%,
      rgb(34 27 15 / 96%) 80%,
      #0b0a09 100%
    );
  }

  /* Counts as a dark section for the sidebar's per-card colour from the middle
     of the gradient (its gold), instead of only from the rule. */
  .cb-theme {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--fade-h) * 0.5);
    background: none;
  }

  /* A soft glow over the apex of the horizon. */
  .cb-glow {
    position: absolute;
    left: calc(var(--cx, 50%) - 30rem);
    width: 60rem;
    bottom: 0;
    height: var(--fade-h);
    background: radial-gradient(ellipse 50% 100% at 50% 100%, rgb(255 236 180 / 40%), rgb(239 214 131 / 14%) 45%, transparent 70%);
  }

  /* The horizon: the black rises above the section's top as a very shallow
     dome (half of an ellipse centred on the thread, wide enough to reach both
     sides of the page), and its rim is a thin line of light. */
  .cb-arc {
    --arc-h: 2.4rem;
    position: absolute;
    left: calc(var(--cx, 50%) - var(--cb-a, 60vw));
    width: calc(var(--cb-a, 60vw) * 2);
    top: calc(-1 * var(--arc-h));
    height: calc(var(--arc-h) * 2);
    border: 2px solid #d8b85a;
    border-radius: 50%;
    background: #0b0a09;
    box-shadow: 0 -10px 30px rgb(239 214 131 / 45%), inset 0 8px 18px rgb(239 214 131 / 12%);
    /* Only the upper half (the lower one is inside the dark section); the
       negative inset lets the glow above the rim show. */
    clip-path: inset(-4rem 0 50% 0);
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
  }

  /* With the thread wired the rim is dim until the thread crosses it. */
  :global(.cb-wired) .cb-arc {
    border-color: rgb(176 138 50 / 55%);
    box-shadow: none;
  }

  .cb.is-x + .cb-sheet .cb-arc {
    border-color: #f0d27a;
    box-shadow: 0 -10px 30px rgb(239 214 131 / 55%), 0 -2px 10px rgb(239 214 131 / 60%), inset 0 8px 18px rgb(239 214 131 / 14%);
  }

  /* Stars just under the horizon: two sparse layers that twinkle out of step. */
  .cb-stars {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 0;
    height: 18rem;
    pointer-events: none;
    mask-image: linear-gradient(180deg, #000, transparent 92%);
  }

  .cb-stars::before,
  .cb-stars::after {
    content: "";
    position: absolute;
    inset: 0;
    background-repeat: repeat;
    animation: cb-twinkle 6s ease-in-out infinite alternate;
  }

  .cb-stars::before {
    background-image:
      radial-gradient(circle at 12% 22%, rgb(255 244 205 / 90%) 0 1px, transparent 1.7px),
      radial-gradient(circle at 47% 61%, rgb(239 214 131 / 70%) 0 1px, transparent 1.6px),
      radial-gradient(circle at 83% 34%, rgb(255 244 205 / 80%) 0 1.2px, transparent 1.9px),
      radial-gradient(circle at 66% 88%, rgb(239 214 131 / 60%) 0 0.9px, transparent 1.5px);
    background-size: 460px 280px;
  }

  .cb-stars::after {
    background-image:
      radial-gradient(circle at 28% 74%, rgb(255 244 205 / 75%) 0 1px, transparent 1.6px),
      radial-gradient(circle at 71% 15%, rgb(239 214 131 / 65%) 0 1.1px, transparent 1.8px),
      radial-gradient(circle at 92% 70%, rgb(255 244 205 / 70%) 0 0.9px, transparent 1.5px);
    background-size: 330px 240px;
    animation-delay: -3s;
    animation-duration: 8s;
  }

  @keyframes cb-twinkle {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-stars::before,
    .cb-stars::after {
      animation: none;
    }
  }

  /* --- The light --------------------------------------------------------- */
  .cb {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 3;
    display: none;
    height: 0;
    pointer-events: none;
  }

  .cb.is-wired {
    display: block;
  }

  .cb-thread {
    position: absolute;
    left: var(--cx, 0);
    top: var(--y0, 0);
    width: 3px;
    height: calc(var(--ye, 0px) - var(--y0, 0px));
    background: rgb(176 138 50 / 62%);
    transform: translateX(-50%);
  }

  .cb-lit {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #b08a32, #c19b3d);
    transform-origin: top;
    transform: scaleY(var(--s, 1));
  }

  .cb-spark {
    position: absolute;
    left: 50%;
    top: calc(var(--s, 1) * (100% - 11px));
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #fff3c4;
    box-shadow: 0 0 16px 6px rgb(239 214 131 / 90%);
    opacity: min(1, calc(var(--s, 1) * 30), calc((1 - var(--s, 1)) * 30));
    transform: translateX(-50%);
  }

  .cb-node {
    position: absolute;
    left: var(--cx, 0);
    width: 0.95rem;
    height: 0.95rem;
    border: 2px solid #8f6c24;
    background: linear-gradient(135deg, #7d5d26, #4a3817);
    box-shadow: 0 2px 6px rgb(0 0 0 / 35%);
    transform: translate(-50%, -50%) rotate(45deg);
    transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .cb-node--o {
    top: var(--y0, 0);
    border-color: #fff0b0;
    background: linear-gradient(135deg, #fff3c4, #efd683 45%, #c9a443);
    box-shadow:
      0 0 0 1.5px #8f6c24,
      0 0 12px rgb(239 214 131 / 80%);
  }

  .cb-node--b {
    top: var(--ye, 0);
  }

  .cb.is-e .cb-node--b {
    border-color: #fff0b0;
    background: linear-gradient(135deg, #fff3c4, #efd683 45%, #c9a443);
    box-shadow:
      0 0 0 1.5px #8f6c24,
      0 0 18px rgb(239 214 131 / 95%),
      0 0 40px rgb(239 214 131 / 55%);
    animation: cb-flash 0.8s ease-out;
  }

  @keyframes cb-flash {
    0% {
      filter: brightness(2.2);
    }
    100% {
      filter: brightness(1);
    }
  }

  /* --- The signal: a gold ring that grows with --cr, two fainter behind ------ */
  .cb-rings {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--cb-h, 0px);
    overflow: hidden;
    opacity: var(--cb-o, 0);
  }

  .cb-ring {
    position: absolute;
    left: var(--cx, 0);
    top: var(--ye, 0);
    border: 2px solid #efd683;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .cb-ring--1 {
    width: calc(var(--cr, 0px) * 2);
    height: calc(var(--cr, 0px) * 2);
    box-shadow: 0 0 40px 8px rgb(239 214 131 / 45%), inset 0 0 36px 4px rgb(239 214 131 / 25%);
  }

  .cb-ring--2 {
    width: calc(var(--cr, 0px) * 1.62);
    height: calc(var(--cr, 0px) * 1.62);
    border-width: 1.5px;
    border-color: rgb(239 214 131 / 55%);
  }

  .cb-ring--3 {
    width: calc(var(--cr, 0px) * 1.28);
    height: calc(var(--cr, 0px) * 1.28);
    border-width: 1px;
    border-color: rgb(239 214 131 / 30%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const bridge = document.querySelector<HTMLElement>("[data-cb]");
  const section = bridge?.closest<HTMLElement>("section");
  const catalog = document.querySelector<HTMLElement>("#tools .tc");

  if (bridge && section && catalog) {
    const mm = gsap.matchMedia();
    mm.add("(min-width: 900px) and (prefers-reduced-motion: no-preference)", () => {
      const thread = bridge.querySelector<HTMLElement>(".cb-thread")!;
      const title = section.querySelector<HTMLElement>(".shc-art-frame");
      const targets = Array.from(section.querySelectorAll<HTMLElement>(".shc-art-frame, .ct-lead, .ct-card"));
      const rem = () => parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      let cross = 0.5; // share of the thread at which it crosses the rule
      let radius = 1200; // the signal's last radius: covers the farthest corner

      // The thread starts at the foot of the tools catalog and ends at a beacon
      // just over the title; the signal is centred on the beacon.
      const layout = () => {
        const s = section.getBoundingClientRect();
        const c = catalog.getBoundingClientRect();
        const cx = c.left + c.width / 2 - s.left;
        const y0 = c.bottom - s.top + 0.8 * rem();
        const ye = title ? title.getBoundingClientRect().top - s.top - 1.1 * rem() : 4 * rem();
        const set = (name: string, value: number) => section.style.setProperty(name, value + "px");
        set("--cx", cx);
        // Half-width of the horizon's ellipse: reaches both sides of the page.
        set("--cb-a", Math.max(cx, s.width - cx) + 40);
        set("--y0", y0);
        set("--ye", ye);
        set("--cb-h", section.offsetHeight);
        // The thread meets the rim of the horizon at the apex, 2.4rem over the top.
        cross = ye > y0 ? Math.min(1, Math.max(0, (-2.4 * rem() - y0) / (ye - y0))) : 0.5;

        // Each covered element gets the beacon in its own coordinates.
        let far = 0;
        targets.forEach((el) => {
          const r = el.getBoundingClientRect();
          const ox = cx - (r.left - s.left);
          const oy = ye - (r.top - s.top);
          el.style.setProperty("--ox", ox + "px");
          el.style.setProperty("--oy", oy + "px");
          [[0, 0], [r.width, 0], [0, r.height], [r.width, r.height]].forEach(([x, y]) => {
            far = Math.max(far, Math.hypot(x - ox, y - oy));
          });
        });
        radius = Math.ceil(far) + 60;
      };
      layout();
      ScrollTrigger.addEventListener("refresh", layout);

      bridge.classList.add("is-wired");
      section.classList.add("cb-wired");
      targets.forEach((el) => el.setAttribute("data-cb-reveal", ""));

      gsap.set(thread, { "--s": 0 });
      gsap.set(section, { "--cr": "0px" });
      gsap.set(bridge, { "--cb-o": 0 });

      const THREAD = 1.6; // s the light takes down to the beacon
      const run = gsap.timeline({
        paused: true,
        onUpdate: () => {
          const s = parseFloat(thread.style.getPropertyValue("--s")) || 0;
          bridge.classList.toggle("is-x", s >= cross && s > 0);
          bridge.classList.toggle("is-e", s >= 0.999);
          // Done: the circles come off (they would clip shadows and focus rings).
          section.classList.toggle("cb-revealed", run.progress() === 1);
        },
      });
      run
        .to(thread, { "--s": 1, duration: THREAD, ease: "none" }, 0)
        .to(bridge, { "--cb-o": 1, duration: 0.15, ease: "none" }, THREAD)
        // The signal: the radius is read when it starts (layout may have changed).
        .to(section, { "--cr": () => radius + "px", duration: 2, ease: "power2.out" }, THREAD + 0.05)
        .to(bridge, { "--cb-o": 0, duration: 0.6, ease: "none" }, THREAD + 1.5);

      const trigger = ScrollTrigger.create({
        trigger: catalog,
        start: "bottom 82%",
        end: "max",
        // After the pins above and the bridges of Servicios and Tools.
        refreshPriority: -7,
        onEnter: () => run.timeScale(1).play(),
        onLeaveBack: () => run.timeScale(2.5).reverse(),
        // Loaded already past it (restored scroll, resize): show it done.
        onRefresh: (self) => {
          if (self.isActive) run.progress(1);
        },
      });

      return () => {
        trigger.kill();
        ScrollTrigger.removeEventListener("refresh", layout);
        bridge.classList.remove("is-wired", "is-x", "is-e");
        section.classList.remove("cb-wired", "cb-revealed");
        targets.forEach((el) => el.removeAttribute("data-cb-reveal"));
      };
    });
  }
</script>
