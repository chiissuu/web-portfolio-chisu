---
import type { ContactSectionContent } from "../lib/content-types";

interface Props {
  t: ContactSectionContent;
}

const { t } = Astro.props as Props;
const f = t.contact.form;
const fields = f.fields;
---

<form
  class="rd-form"
  id="contact-form"
  data-status="idle"
  data-msg-loading={f.submitLoading}
  data-msg-success={f.submitSuccess}
  data-msg-error={f.submitError}
  novalidate
>
  <p class="rd-form-notice">{f.submitSuccess}</p>
  <!-- Keep the simulated form inert until its submit handler is installed.
       Without JS, native GET submission would put personal data in the URL. -->
  <fieldset class="rd-form-grid" disabled>
    <div class="rd-field" data-field="name">
      <label for="contact-name">{fields.name}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="rd-field" data-field="email">
      <label for="contact-email">{fields.email}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="rd-field" data-field="reason">
      <label for="contact-reason">{fields.reason}</label>
      <select id="contact-reason" name="reason" required>
        <option value="" selected disabled>{fields.reason}</option>
        {fields.reasonOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>

    <div class="rd-field" data-field="subject">
      <label for="contact-subject">{fields.subject}</label>
      <input id="contact-subject" name="subject" type="text" required />
    </div>

    <div class="rd-field rd-field-full" data-field="message">
      <label for="contact-message">{fields.message}</label>
      <textarea id="contact-message" name="message" required></textarea>
    </div>

    <div class="rd-field rd-field-full" data-field="preferredResponse">
      <label for="contact-preferred">{fields.preferredResponse}</label>
      <select id="contact-preferred" name="preferredResponse" required>
        <option value="" selected disabled>{fields.preferredResponse}</option>
        {fields.preferredResponseOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>
  </fieldset>

  <div class="rd-form-actions">
    <button class="rd-btn rd-btn-primary" type="submit" disabled>{f.submitIdle}</button>
    <p class="rd-form-status" data-role="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import type { ContactFormData } from "../lib/forms/types";
  import { validateContactForm } from "../lib/forms/validate";
  import { submitFormPlaceholder } from "../lib/forms/submit";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.querySelectorAll<HTMLElement>("[data-field]").forEach((field) => {
    const control = field.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea");
    if (!control) return;
    const error = document.createElement("p");
    error.id = `${control.id}-error`;
    error.className = "rd-field-error";
    error.hidden = true;
    control.setAttribute("aria-describedby", error.id);
    field.append(error);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (form.dataset.status === "loading") return;

    const statusEl = form.querySelector<HTMLElement>('[data-role="status"]');
    const formData = new FormData(form);

    const data: ContactFormData = {
      name: String(formData.get("name") ?? ""),
      email: String(formData.get("email") ?? ""),
      reason: String(formData.get("reason") ?? ""),
      subject: String(formData.get("subject") ?? ""),
      message: String(formData.get("message") ?? ""),
      preferredResponse: String(formData.get("preferredResponse") ?? ""),
    };

    form.querySelectorAll("[data-field]").forEach((field) => {
      field.removeAttribute("data-invalid");
      field.querySelector("input, select, textarea")?.removeAttribute("aria-invalid");
      const error = field.querySelector<HTMLElement>(".rd-field-error");
      if (error) error.hidden = true;
    });

    const errors = validateContactForm(data);

    if (errors.length > 0) {
      form.dataset.status = "error";
      if (statusEl) statusEl.textContent = form.dataset.msgError ?? "";

      errors.forEach((error) => {
        const field = form.querySelector(`[data-field="${error.field}"]`);
        field?.setAttribute("data-invalid", "true");
        const control = field?.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea");
        control?.setAttribute("aria-invalid", "true");
        const message = field?.querySelector<HTMLElement>(".rd-field-error");
        if (message) {
          message.textContent = control?.validationMessage || form.dataset.msgError || "";
          message.hidden = false;
        }
      });

      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();

      return;
    }

    form.dataset.status = "loading";
    form.setAttribute("aria-busy", "true");
    if (submitButton) submitButton.disabled = true;
    if (statusEl) statusEl.textContent = form.dataset.msgLoading ?? "";

    const result = await submitFormPlaceholder(data);

    form.dataset.status = result.ok ? "success" : "error";
    if (statusEl) {
      statusEl.textContent = result.ok
        ? form.dataset.msgSuccess ?? ""
        : form.dataset.msgError ?? "";
    }
    form.removeAttribute("aria-busy");
    if (submitButton) submitButton.disabled = false;
  });

  // Enable only after preventDefault and the accessibility setup are ready.
  if (form) {
    const fieldset = form.querySelector("fieldset");
    if (fieldset) fieldset.disabled = false;
    if (submitButton) submitButton.disabled = false;
  }
</script>

<style>
  /* Dark-section form: graphite panel, Inter, gold focus and a gold metal
     button, matching About / Servicios / Tools. Scoped to this form (the
     services form on /servicios/ keeps the shared warm styling). */
  .rd-form {
    max-width: none;
    gap: 1.25rem;
  }

  fieldset.rd-form-grid {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rd-form :global(.rd-field label) {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--theme-text-muted);
  }

  /* 50% border: form controls need 3:1 against the graphite (the card
     border at 18% is only decorative). */
  .rd-form :global(.rd-field input),
  .rd-form :global(.rd-field select),
  .rd-form :global(.rd-field textarea) {
    border: 1px solid rgb(196 204 209 / 50%);
    border-radius: 10px;
    background: rgb(255 255 255 / 5%);
    color: var(--theme-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .rd-form :global(.rd-field input),
  .rd-form :global(.rd-field select) {
    padding-inline: 0.75rem;
  }

  .rd-form :global(.rd-field input:focus),
  .rd-form :global(.rd-field select:focus),
  .rd-form :global(.rd-field textarea:focus) {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 1px;
    border-color: var(--color-brand-gold);
  }

  .rd-form :global(.rd-field[data-invalid="true"] input),
  .rd-form :global(.rd-field[data-invalid="true"] select),
  .rd-form :global(.rd-field[data-invalid="true"] textarea) {
    border-color: #ff9db9;
  }

  .rd-form[data-status="error"] .rd-form-status,
  .rd-form :global(.rd-field-error) {
    color: #ff9db9;
  }

  .rd-form :global(.rd-field-error) {
    font-size: 0.84rem;
  }

  .rd-form-notice {
    margin: 0;
    padding-inline-start: 0.8rem;
    border-inline-start: 2px solid rgb(224 197 139 / 60%);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--theme-text-muted);
  }

  .rd-form-status {
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .rd-form[data-status="success"] .rd-form-status {
    color: var(--color-brand-gold);
  }

  /* Gold metal button, same palette as the nav buttons and card arrows. */
  .rd-form .rd-btn-primary {
    min-height: 48px;
    padding: 0.8rem 1.8rem;
    border: 2px solid transparent;
    border-radius: 12px;
    color: #1a1406;
    font-family: var(--font-body);
    font-weight: 700;
    background:
      linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32) padding-box,
      linear-gradient(135deg, #efd683 8%, #b08a32 30%, #c19b3d 48%, #efd683 72%, #b08a32) border-box;
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 65%),
      inset 0 -1px 2px rgb(0 0 0 / 22%),
      0 2px 6px rgb(0 0 0 / 40%);
    cursor: pointer;
  }

  .rd-form .rd-btn-primary:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .rd-form .rd-btn-primary:not(:disabled):active {
    transform: translateY(1px);
    filter: brightness(0.94);
  }

  .rd-form button:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 3px;
  }

  @container (max-width: 340px) {
    .rd-form :global(.rd-form-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
