---
// The contact message form: four fields (name, email, reason, message). There
// is no backend: on send, the browser is asked to open the mail app with the
// message already written (`mailto:`), so nothing is stored anywhere and the
// message goes out from the visitor's own account.
import type { ContactSectionContent } from "../lib/content-types";

interface Props {
  t: ContactSectionContent;
}

const { t } = Astro.props as Props;
const f = t.contact.form;
const fields = f.fields;
---

<form
  class="rd-form"
  id="contact-form"
  data-status="idle"
  data-to={t.contact.links.email}
  data-msg-loading={f.submitLoading}
  data-msg-success={f.submitSuccess}
  data-msg-error={f.submitError}
  novalidate
>
  <p class="rd-form-notice">{f.notice}</p>
  <!-- Keep the form inert until its submit handler is installed. Without JS,
       native GET submission would put personal data in the URL. -->
  <fieldset class="rd-form-grid" disabled>
    <div class="rd-field" data-field="name">
      <label for="contact-name">{fields.name}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="rd-field" data-field="email">
      <label for="contact-email">{fields.email}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="rd-field rd-field-full" data-field="reason">
      <p class="ct-legend" id="contact-reason-label">{fields.reason}</p>
      <div class="ct-reasons" role="radiogroup" aria-labelledby="contact-reason-label">
        {fields.reasonOptions.map((option) => (
          <label class="ct-reason">
            <input type="radio" name="reason" value={option} required />
            <span>{option}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="rd-field rd-field-full" data-field="message">
      <label for="contact-message">{fields.message}</label>
      <textarea id="contact-message" name="message" maxlength="1500" required></textarea>
    </div>
  </fieldset>

  <div class="rd-form-actions">
    <button class="rd-btn ct-metal" type="submit" disabled><span>{f.submitIdle}</span></button>
    <p class="rd-form-status" data-role="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import type { ContactFormData } from "../lib/forms/types";
  import { validateContactForm } from "../lib/forms/validate";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.querySelectorAll<HTMLElement>("[data-field]").forEach((field) => {
    const control = field.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea");
    if (!control) return;
    const error = document.createElement("p");
    error.id = `${control.id || `contact-${field.dataset.field}`}-error`;
    error.className = "rd-field-error";
    error.hidden = true;
    control.setAttribute("aria-describedby", error.id);
    field.append(error);
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (form.dataset.status === "loading") return;

    const statusEl = form.querySelector<HTMLElement>('[data-role="status"]');
    const formData = new FormData(form);

    const data: ContactFormData = {
      name: String(formData.get("name") ?? ""),
      email: String(formData.get("email") ?? ""),
      reason: String(formData.get("reason") ?? ""),
      message: String(formData.get("message") ?? ""),
    };

    form.querySelectorAll("[data-field]").forEach((field) => {
      field.removeAttribute("data-invalid");
      field.querySelectorAll("input, select, textarea").forEach((control) => control.removeAttribute("aria-invalid"));
      const error = field.querySelector<HTMLElement>(".rd-field-error");
      if (error) error.hidden = true;
    });

    const errors = validateContactForm(data);

    if (errors.length > 0) {
      form.dataset.status = "error";
      if (statusEl) statusEl.textContent = form.dataset.msgError ?? "";

      errors.forEach((error) => {
        const field = form.querySelector(`[data-field="${error.field}"]`);
        field?.setAttribute("data-invalid", "true");
        const control = field?.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea");
        field?.querySelectorAll("input, select, textarea").forEach((c) => c.setAttribute("aria-invalid", "true"));
        const message = field?.querySelector<HTMLElement>(".rd-field-error");
        if (message) {
          message.textContent = control?.validationMessage || form.dataset.msgError || "";
          message.hidden = false;
        }
      });

      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    // Ask the browser to open the mail app with the message written. If the
    // visitor has no mail app nothing opens, which the success text covers.
    const name = data.name.trim();
    const subject = `${data.reason} · ${name}`;
    const body = `${data.message.trim()}\r\n\r\n—\r\n${name}\r\n${data.email.trim()}`;
    form.dataset.status = "loading";
    if (statusEl) statusEl.textContent = form.dataset.msgLoading ?? "";
    window.location.href = `mailto:${form.dataset.to ?? ""}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.setTimeout(() => {
      form.dataset.status = "success";
      if (statusEl) statusEl.textContent = form.dataset.msgSuccess ?? "";
    }, 600);
  });

  // Enable only after preventDefault and the accessibility setup are ready.
  if (form) {
    const fieldset = form.querySelector("fieldset");
    if (fieldset) fieldset.disabled = false;
    if (submitButton) submitButton.disabled = false;
  }
</script>

<style>
  /* Dark-section form: graphite panel, Inter, gold focus; the send button is the
     gold metal one (`.ct-metal`, defined in ContactSection). */
  .rd-form {
    max-width: none;
    gap: 1.25rem;
  }

  fieldset.rd-form-grid {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rd-form :global(.rd-field label),
  .ct-legend {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--theme-text-muted);
  }

  .ct-legend {
    margin: 0 0 0.5rem;
  }

  /* 50% border: form controls need 3:1 against the graphite (the card
     border at 18% is only decorative). */
  .rd-form :global(.rd-field input:not([type="radio"])),
  .rd-form :global(.rd-field select),
  .rd-form :global(.rd-field textarea) {
    border: 1px solid rgb(196 204 209 / 50%);
    border-radius: 10px;
    background: rgb(255 255 255 / 5%);
    color: var(--theme-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .rd-form :global(.rd-field input:not([type="radio"])),
  .rd-form :global(.rd-field select) {
    padding-inline: 0.75rem;
  }

  .rd-form :global(.rd-field textarea) {
    min-height: 8.5rem;
    resize: vertical;
  }

  .rd-form :global(.rd-field input:not([type="radio"]):focus),
  .rd-form :global(.rd-field select:focus),
  .rd-form :global(.rd-field textarea:focus) {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 1px;
    border-color: var(--color-brand-gold);
  }

  .rd-form :global(.rd-field[data-invalid="true"] input:not([type="radio"])),
  .rd-form :global(.rd-field[data-invalid="true"] select),
  .rd-form :global(.rd-field[data-invalid="true"] textarea) {
    border-color: #ff9db9;
  }

  .rd-form[data-status="error"] .rd-form-status,
  .rd-form :global(.rd-field-error) {
    color: #ff9db9;
  }

  .rd-form :global(.rd-field-error) {
    font-size: 0.84rem;
  }

  /* The reason: four chips (radio buttons), the chosen one in gold metal. */
  .ct-reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ct-reason {
    position: relative;
    cursor: pointer;
  }

  .ct-reason input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .ct-reason span {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(196 204 209 / 40%);
    border-radius: 999px;
    background: rgb(255 255 255 / 5%);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--theme-text);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .ct-reason:hover span {
    border-color: var(--color-brand-gold);
  }

  .ct-reason input:checked + span {
    border-color: #8f6c24;
    background: linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32);
    color: #211b0e;
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 65%), 0 1px 3px rgb(0 0 0 / 40%);
  }

  .ct-reason input:focus-visible + span {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 3px;
  }

  .rd-field[data-invalid="true"] .ct-reason span {
    border-color: #ff9db9;
  }

  .rd-form-notice {
    margin: 0;
    padding-inline-start: 0.8rem;
    border-inline-start: 2px solid rgb(224 197 139 / 60%);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--theme-text-muted);
  }

  .rd-form-status {
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .rd-form[data-status="success"] .rd-form-status {
    color: var(--color-brand-gold);
  }

  @container (max-width: 340px) {
    .rd-form :global(.rd-form-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
