---
// Shell shared by the home "Proyectos", "Servicios" and "Tools" sections:
// warm-graphite background (same recipe as About), artwork title with a static
// gold halo, an introduction slot, a card slot, an optional extra slot and an
// optional text CTA. The first of the set `blend`s in from the black of the
// section above; the rest continue the same graphite, so their seams are
// invisible.
//
// With `rail` the cards form one horizontal row instead of a grid. On desktop
// the title, introduction and row are pinned while vertical scrolling slides
// the row sideways (GSAP ScrollTrigger); below 900px, or with reduced motion,
// nothing is pinned and the row is a plain horizontally swipeable strip.
import type { TitleImage } from "../lib/content-types";
import SectionHeadingCard from "./SectionHeadingCard.astro";
import SectionBackdrop from "./SectionBackdrop.astro";

interface Props {
  id: string;
  title: string;
  titleImage?: TitleImage;
  ctaHref?: string;
  ctaLabel?: string;
  /** Backdrop (see SectionBackdrop); `blueprint` is dark, the others light. */
  backdrop: "champagne" | "blueprint" | "brushed";
  rail?: boolean;
  /** A pinned scene before the content: a point of light grows into a circle that uncovers the section. */
  iris?: boolean;
  /** Centre the title and the introduction (with a stronger introduction type). */
  center?: boolean;
}

const { id, title, titleImage, ctaHref, ctaLabel, backdrop, rail = false, iris = false, center = false } = Astro.props as Props;
const light = backdrop !== "blueprint";
---

<section
  class:list={[
    light ? "section-theme-warm" : "section-theme-dark",
    "sc-section",
    "bd-host",
    { "bd-light": light, "sc-section--rail": rail, "sc-section--center": center },
  ]}
  id={id}
  data-sc-rail-root={rail ? "" : undefined}
  data-sc-iris-root={iris ? "" : undefined}
>
  {iris && (
    <div class="sc-iris" data-sc-iris aria-hidden="true">
      <span class="sc-iris-theme section-theme-dark"></span>
      <div class="sc-iris-up">
        <div class="sc-iris-light-up"></div>
        <div class="sc-iris-dark-up"></div>
      </div>
      <div class="sc-iris-clip">
        <div class="sc-iris-dark"></div>
      </div>
      <span class="sc-iris-ring"></span>
      <span class="sc-iris-glow"></span>
      <span class="sc-iris-track"></span>
      <span class="sc-iris-line"></span>
      <span class="sc-iris-node"></span>
    </div>
  )}
  <SectionBackdrop kind={backdrop} />
  <div class="section-inner sc-inner">
    {rail ? (
      <>
        <div class:list={["sc-head", { "sc-head--center": center }]}>
          <SectionHeadingCard text={title} image={titleImage} halo={!light} as="h2" size="lg" />

          <div class="sc-intro editorial-text">
            <slot name="intro" />
          </div>
        </div>

        <div class="sc-pin" data-sc-pin>
        <div class="sc-progress" data-sc-progress aria-hidden="true">
          <span class="sc-count"><b data-sc-count>01</b> / <span data-sc-total>06</span></span>
          <span class="sc-bar"><i data-sc-bar></i></span>
        </div>

        <div class="sc-rail" data-sc-rail>
          <div class="sc-track" data-sc-track>
            <slot />
          </div>
        </div>
        </div>
      </>
    ) : (
      <>
        <SectionHeadingCard text={title} image={titleImage} halo={!light} as="h2" size="lg" />

        <div class="sc-intro editorial-text">
          <slot name="intro" />
        </div>

        <div class="sc-grid">
          <slot />
        </div>
      </>
    )}

    <slot name="after" />

    {ctaHref && ctaLabel && (
      <a class="sc-cta" href={ctaHref}>
        <span class="sc-cta-label">{ctaLabel}</span>
        <span class="sc-cta-arrow" aria-hidden="true">&#8594;</span>
      </a>
    )}
  </div>
</section>

<style>
  /* The background itself is the SectionBackdrop layer; these are the tokens
     of the dark tone (the light tone's come from `.bd-light`). */
  .sc-section.section-theme-dark {
    --theme-text: #f3f4f5;
    --theme-text-muted: #adb2b6;
    --theme-border: rgb(196 204 209 / 18%);
    --theme-surface: rgb(20 19 16 / 82%);
    --theme-surface-strong: rgb(28 26 22 / 90%);
    --theme-accent: var(--color-brand-gold);
    background: #16150f;
  }

  .sc-section.section-theme-warm {
    background: #e6dcc2;
  }

  .sc-intro {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    color: var(--theme-text-muted);
  }

  .sc-intro :global(strong) {
    color: var(--theme-text);
    font-weight: 700;
  }

  .sc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* --- Iris (Sobre mí -> Proyectos) --------------------------------------
     A dark layer covers the top of the section (the title, introduction and
     cards, up to the rail). The thread's light travels down to a point in it,
     the point ignites and grows into a circle (a hole in a radial mask) that
     uncovers the section itself, with a gold ring on the edge. It is driven by
     the scroll between "the thread's last node is at the middle of the
     screen" and "the rail starts", so nothing is pinned and the circle opens
     over the real content. Off (display: none) unless the script turned it on
     (desktop, motion allowed). */
  .sc-iris {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 3;
    display: none;
    height: var(--iris-h, 100svh);
    pointer-events: none;
    --ix: 50%;
    --iy: 50%;
    --iris-up: 700px;
    --r: 0px;
    --gap: 0px;
  }

  .sc-section[data-iris="on"] .sc-iris {
    display: block;
  }

  /* The clip keeps the ring inside the covered area; the thread and the point
     stay outside it, because the thread starts in Sobre mí. */
  .sc-iris-clip {
    position: absolute;
    inset: -2px 0 0;
    overflow: hidden;
  }

  .sc-iris-dark {
    position: absolute;
    inset: 0;
    background: #050505;
    /* The clip starts 2px above the section so no sub-pixel line of the
       backdrop shows at its edge; the hole is shifted down by the same 2px. */
    -webkit-mask-image: radial-gradient(circle at var(--ix) calc(var(--iy) + 2px), transparent var(--r), #000 calc(var(--r) + 1.5px));
    mask-image: radial-gradient(circle at var(--ix) calc(var(--iy) + 2px), transparent var(--r), #000 calc(var(--r) + 1.5px));
  }

  /* The circle must not be cut flat at the top edge of the section: above it,
     over the end of Sobre mí, the same dark layer (fading in as Sobre mí's last
     card leaves the screen) and a champagne layer (which only shows through the
     circle, and only once the circle reaches the section's edge) continue it. */
  .sc-iris-up {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: var(--iris-up);
    overflow: hidden;
  }

  .sc-iris-light-up {
    position: absolute;
    inset: 0;
    background: #ece3cb;
    opacity: 0;
  }

  .sc-iris-dark-up {
    position: absolute;
    inset: 0;
    background: #050505;
    opacity: 0;
    -webkit-mask-image: radial-gradient(circle at var(--ix) calc(var(--iy) + var(--iris-up)), transparent var(--r), #000 calc(var(--r) + 1.5px));
    mask-image: radial-gradient(circle at var(--ix) calc(var(--iy) + var(--iris-up)), transparent var(--r), #000 calc(var(--r) + 1.5px));
  }

  /* Counts as a dark section for the sidebar's per-card text colour while the
     dark layer is behind it (no background of its own). */
  .sc-iris-theme {
    position: absolute;
    top: calc(-1 * var(--iris-up));
    right: 0;
    bottom: 0;
    left: 0;
    background: none;
    pointer-events: none;
  }

  /* A soft gold glow around the point. It is its own element, not part of the
     dark layer, so it is not cut flat where the section begins. */
  .sc-iris-glow {
    position: absolute;
    left: var(--ix);
    top: var(--iy);
    width: 840px;
    height: 840px;
    margin: -420px 0 0 -420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(185 154 69 / 26%), transparent 70%);
    opacity: 0;
  }

  .sc-iris-track,
  .sc-iris-line {
    position: absolute;
    left: calc(var(--ix) - 1px);
    top: calc(-1 * var(--gap));
    width: 2px;
    height: calc(var(--gap) + var(--iy));
    transform-origin: top;
  }

  .sc-iris-track {
    background: rgb(224 197 139 / 22%);
  }

  .sc-iris-line {
    background: linear-gradient(180deg, #efd683, #c19b3d);
    box-shadow: 0 0 12px 1px rgb(239 214 131 / 60%);
    transform: scaleY(0);
  }

  .sc-iris-node {
    position: absolute;
    left: var(--ix);
    top: var(--iy);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: #efd683;
    box-shadow: 0 0 0 6px rgb(224 197 139 / 20%), 0 0 26px 6px rgb(239 214 131 / 60%);
    transform: scale(0.45);
  }

  .sc-iris-ring {
    position: absolute;
    left: var(--ix);
    top: var(--iy);
    width: 0;
    height: 0;
    border: 2px solid #efd683;
    border-radius: 50%;
    box-shadow: 0 0 40px 8px rgb(239 214 131 / 50%), inset 0 0 36px 4px rgb(239 214 131 / 30%);
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Centred head (Proyectos) ---------------------------------------- */

  .sc-head--center {
    text-align: center;
  }

  .sc-head--center :global(.shc-art) {
    margin-inline: auto;
  }

  /* Larger, heavier introduction in the body face and near-black ink, with a
     soft patch of the section's own colour behind it so the veins of the
     backdrop do not cross the letters. */
  .sc-section--center .sc-intro {
    position: relative;
    isolation: isolate;
    max-width: 44rem;
    margin-inline: auto;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-weight: 500;
    line-height: 1.55;
    color: color-mix(in srgb, var(--theme-text) 92%, transparent);
    text-wrap: balance;
  }

  .sc-section--center .sc-intro :global(strong) {
    font-weight: 700;
    color: var(--theme-text);
  }

  .sc-section--center .sc-intro::before {
    content: "";
    position: absolute;
    inset: -1.4rem -5rem;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(236 227 203 / 90%) 55%, transparent);
    filter: blur(6px);
    pointer-events: none;
  }

  /* Counter and progress line of the row (shown while it slides). */
  .sc-progress {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0 auto 1rem;
  }

  .sc-section[data-rail-on] .sc-progress {
    display: flex;
  }

  .sc-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--theme-text-muted);
  }

  .sc-count b {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--theme-text);
  }

  .sc-bar {
    position: relative;
    width: min(18rem, 40%);
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: color-mix(in srgb, var(--theme-text) 18%, transparent);
  }

  .sc-bar i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #b08a32, #efd683);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* --- Rail ------------------------------------------------------------ */

  /* The row runs past the right edge of the page while it slides; clipping
     (not hiding) keeps the page from gaining a horizontal scrollbar. */
  .sc-section--rail {
    overflow-x: clip;
  }

  .sc-rail {
    overflow-x: auto;
    padding-block: 0.5rem 1rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: rgb(224 197 139 / 45%) transparent;
  }

  .sc-track {
    display: flex;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    width: max-content;
    padding-inline-end: 2rem;
  }

  .sc-track > :global(*) {
    scroll-snap-align: start;
  }

  /* Pinned (desktop with motion): the script slides the row, no native scroll.
     The box reaches 3rem left (about the sidebar's edge) and past the right
     edge of the page, and a mask fades the cards out on the left, so they
     never slide under the translucent sidebar. */
  .sc-rail[data-pinned] {
    overflow: visible;
    scroll-snap-type: none;
    margin-inline: -3rem -100vw;
    padding-inline: 3rem 100vw;
    mask-image: linear-gradient(90deg, transparent 0, #000 3rem);
  }

  /* Large typographic CTA — full clickable block, not a small pill button. */
  .sc-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 1.1rem 0;
    border-top: 1px solid var(--theme-border);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--theme-text);
    transition: gap 0.25s ease, color 0.25s ease;
  }

  .sc-cta-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
    color: var(--theme-accent, var(--color-brand-gold));
    font-size: 1.3em;
  }

  .sc-cta:hover,
  .sc-cta:focus-visible {
    gap: 1.6rem;
    color: var(--theme-accent, var(--color-brand-gold));
  }

  .sc-cta:hover .sc-cta-arrow,
  .sc-cta:focus-visible .sc-cta-arrow {
    transform: translateX(6px);
  }

  .sc-cta:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .sc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Pins the title, introduction and row, and turns vertical scrolling into a
  // sideways slide of the row until its last card is in view.
  function initRail(root: HTMLElement) {
    // The artwork title is uncovered left to right as the section arrives,
    // continuing the thread of light that ends Sobre mí.
    const art = root.querySelector<HTMLElement>(".shc-art-frame");
    if (art && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.fromTo(
        art,
        { clipPath: "inset(0 100% 0 0)" },
        {
          clipPath: "inset(0 0% 0 0)",
          ease: "none",
          scrollTrigger: { trigger: art, start: "top 92%", end: "top 55%", scrub: true },
        }
      );
    }

    const pin = root.querySelector<HTMLElement>("[data-sc-pin]");
    const rail = root.querySelector<HTMLElement>("[data-sc-rail]");
    const track = root.querySelector<HTMLElement>("[data-sc-track]");
    if (!pin || !rail || !track) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>("[data-sc-card]"));
    const countEl = root.querySelector<HTMLElement>("[data-sc-count]");
    const totalEl = root.querySelector<HTMLElement>("[data-sc-total]");
    const barEl = root.querySelector<HTMLElement>("[data-sc-bar]");
    const pad = (value: number) => String(value).padStart(2, "0");
    let focused = -1;
    // The progress line, the counter and the card in focus follow the slide.
    const follow = (progress: number) => {
      barEl?.style.setProperty("transform", `scaleX(${progress})`);
      if (!cards.length) return;
      const index = Math.min(cards.length - 1, Math.round(progress * (cards.length - 1)));
      if (index === focused) return;
      focused = index;
      cards.forEach((card, i) => card.classList.toggle("is-focus", i === index));
      if (countEl) countEl.textContent = pad(index + 1);
    };

    const mm = gsap.matchMedia();
    mm.add("(min-width: 900px) and (prefers-reduced-motion: no-preference)", () => {
      rail.setAttribute("data-pinned", "");
      root.setAttribute("data-rail-on", "");
      if (totalEl) totalEl.textContent = pad(cards.length);
      follow(0);

      // How far the row must travel for its last card to clear the right edge.
      const distance = () =>
        Math.max(0, track.scrollWidth - (window.innerWidth - pin.getBoundingClientRect().left) + 32);
      // Only the counter and the row are pinned (the title and the introduction
      // scroll away first), a little below the top of the screen.
      const PIN_TOP = 28;

      gsap.to(track, {
        x: () => -distance(),
        ease: "none",
        scrollTrigger: {
          trigger: pin,
          start: () => `top ${PIN_TOP}px`,
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.6,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          refreshPriority: -2,
          onUpdate: (self) => follow(self.progress),
        },
      });

      return () => {
        rail.removeAttribute("data-pinned");
        root.removeAttribute("data-rail-on");
        cards.forEach((card) => card.classList.remove("is-focus"));
        focused = -1;
      };
    });

    // Images and fonts change the widths the travel is measured from.
    window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
    void document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  // The iris: see the CSS above. Between the moment the thread's last node is
  // at the middle of the screen (S0) and the moment the rail's pin starts, the
  // scroll drives: the light down the thread to the point (0-34 %), the point
  // igniting with sparks (34-42 %), and the circle opening (36-100 %).
  function initIris(root: HTMLElement) {
    const iris = root.querySelector<HTMLElement>("[data-sc-iris]");
    const pin = root.querySelector<HTMLElement>("[data-sc-pin]");
    const line = iris?.querySelector<HTMLElement>(".sc-iris-line");
    const node = iris?.querySelector<HTMLElement>(".sc-iris-node");
    const ring = iris?.querySelector<HTMLElement>(".sc-iris-ring");
    const theme = iris?.querySelector<HTMLElement>(".sc-iris-theme");
    const track = iris?.querySelector<HTMLElement>(".sc-iris-track");
    const darkUp = iris?.querySelector<HTMLElement>(".sc-iris-dark-up");
    const lightUp = iris?.querySelector<HTMLElement>(".sc-iris-light-up");
    const glow = iris?.querySelector<HTMLElement>(".sc-iris-glow");
    if (!iris || !pin || !line || !node || !ring || !theme || !track || !darkUp || !lightUp || !glow) return;

    const mm = gsap.matchMedia();
    mm.add("(min-width: 900px) and (prefers-reduced-motion: no-preference)", () => {
      root.setAttribute("data-iris", "on");

      const UP = 700; // how far the circle's layers reach above the section
      const geo = { ix: 0, iy: 0, gap: 0, rmax: 0, s0: 0, dist: 1, h: 0 };
      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
      const measure = () => {
        const exit = document.querySelector<HTMLElement>("#about .ab-marker--exit .ab-marker-dot");
        const rootTop = root.getBoundingClientRect().top + window.scrollY;
        // The pinned panel's natural position: its pin spacer's, once the rail has pinned it.
        const stage = pin.parentElement?.classList.contains("pin-spacer") ? pin.parentElement : pin;
        const stageTop = stage.getBoundingClientRect().top + window.scrollY;
        const stageH = pin.offsetHeight;
        const height = stageTop - rootTop + stageH + 150;
        // The point of light sits in the middle of the title.
        const titleBox = root.querySelector<HTMLElement>(".sc-head .shc")?.getBoundingClientRect();
        geo.h = height;
        let exitY = rootTop - 100;
        geo.ix = window.innerWidth / 2;
        if (exit) {
          const box = exit.getBoundingClientRect();
          geo.ix = box.left + box.width / 2;
          exitY = box.top + window.scrollY + box.height / 2;
        }
        geo.iy = titleBox ? titleBox.top + window.scrollY - rootTop + titleBox.height / 2 : 160;
        geo.gap = Math.max(0, rootTop - exitY);
        geo.rmax = Math.hypot(Math.max(geo.ix, window.innerWidth - geo.ix), Math.max(geo.iy + UP, height - geo.iy)) + 40;
        geo.s0 = exitY - window.innerHeight / 2;
        // Done when the section's top edge reaches the top of the screen, so no
        // strip of Sobre mí is left above the revealed section.
        geo.dist = Math.max(300, rootTop - geo.s0);
        iris.style.setProperty("--ix", `${geo.ix}px`);
        iris.style.setProperty("--iy", `${geo.iy}px`);
        iris.style.setProperty("--gap", `${geo.gap}px`);
        iris.style.setProperty("--iris-h", `${height}px`);
        iris.style.setProperty("--iris-up", `${UP}px`);
      };

      const p = { v: 0 };
      let prevIgnite = 0;
      let themeDark: boolean | null = null;
      // Sobre mí stops counting as a dark section (for the sidebar's text colour)
      // a little before the end, when its last strip is already covered.
      const about = document.getElementById("about");
      let aboutDark: boolean | null = null;
      // The scene follows the scroll, but its beats are in order and also take
      // a little time, so a fast scroll cannot skip them: the thread's last
      // node does its own animation first, then the light runs down to the
      // point, the point ignites, and only then does the circle open. These
      // gates (0 -> 1) rise in that order after the node lights; the scene
      // shows the smaller of the scroll's value and the gate's.
      const gate = { line: 0, ignite: 0, open: 0 };
      let sequence: gsap.core.Timeline | null = null;
      const onExitLit = (event: Event) => {
        const lit = (event as CustomEvent<{ lit: boolean }>).detail.lit;
        sequence?.kill();
        sequence = null;
        if (!lit) {
          gate.line = gate.ignite = gate.open = 0;
          render();
          return;
        }
        sequence = gsap.timeline({ delay: 0.7, onUpdate: render });
        sequence.to(gate, { line: 1, duration: 0.5, ease: "power1.out" });
        sequence.to(gate, { ignite: 1, duration: 0.25, ease: "none" });
        sequence.to(gate, { open: 1, duration: 0.7, ease: "none" }, ">-0.05");
      };
      window.addEventListener("ab-exit-lit", onExitLit);

      const render = () => {
        const v = p.v;
        // 1. The light runs down the thread to the point.
        const fill = Math.min(1 - Math.pow(1 - clamp01(v / 0.34), 2), gate.line);
        line.style.transform = `scaleY(${fill})`;
        // 2. The point ignites.
        const ignite = Math.min(clamp01((v - 0.34) / 0.08), gate.ignite);
        node.style.transform = `scale(${0.45 + 0.55 * ignite + 0.35 * Math.sin(ignite * Math.PI)})`;
        if (ignite >= 0.5 && prevIgnite < 0.5) burst();
        prevIgnite = ignite;
        // 3. The circle opens.
        const open = Math.min(clamp01((v - 0.36) / 0.64), gate.open);
        const r = Math.pow(open, 2) * geo.rmax;
        iris.style.setProperty("--r", `${r}px`);
        ring.style.width = ring.style.height = `${2 * r}px`;
        // The ring may cross the end of Sobre mí, but not the content below the covered area.
        ring.style.clipPath = `inset(-4000px -4000px ${Math.max(0, geo.iy + r - geo.h)}px -4000px)`;
        ring.style.opacity = open > 0.001 && open < 0.96 ? "1" : "0";
        // Nothing of the thread is drawn until the last node has done its animation,
        // and it is gone soon after the circle starts: the light became the circle.
        const appear = clamp01(gate.line * 12);
        const fade = String(appear * clamp01(1 - (open - 0.04) / 0.22));
        line.style.opacity = node.style.opacity = track.style.opacity = fade;
        glow.style.opacity = String(clamp01(gate.line * 3) * clamp01(1 - open / 0.25));
        // The extension above the section only matters once the circle gets there
        // (by then Sobre mí's last card has left the screen).
        const smooth = (a: number, b: number) => {
          const t = clamp01((v - a) / (b - a));
          return t * t * (3 - 2 * t);
        };
        darkUp.style.opacity = String(smooth(0.5, 0.62));
        lightUp.style.opacity = String(clamp01((r - geo.iy * 0.85) / (geo.iy * 0.15)));
        // The dark layer is behind the sidebar until the circle reaches it. The
        // sidebar re-reads its cards' colours when asked (the scroll may be still).
        const sidebarRight = document.querySelector<HTMLElement>(".hx-compact-sidebar")?.getBoundingClientRect().right ?? 380;
        const dark = r < geo.ix - sidebarRight + 120;
        const aboutIsDark = v < 0.9;
        if (dark !== themeDark || aboutIsDark !== aboutDark) {
          themeDark = dark;
          aboutDark = aboutIsDark;
          theme.classList.toggle("section-theme-dark", dark);
          about?.classList.toggle("section-theme-dark", aboutIsDark);
          window.dispatchEvent(new Event("hx-theme-check"));
        }
        iris.style.visibility = v >= 0.999 ? "hidden" : "visible";
      };

      const SPARKS = ["#fff3c4", "#e0c58b", "#c19b3d", "#efd683"];
      const burst = () => {
        for (let i = 0; i < 22; i++) {
          const size = 3 + Math.random() * 3.5;
          const spark = document.createElement("span");
          spark.style.cssText = `position:absolute;left:${geo.ix}px;top:${geo.iy}px;width:${size}px;height:${size}px;margin:${-size / 2}px 0 0 ${-size / 2}px;border-radius:50%;pointer-events:none;background:${SPARKS[i % SPARKS.length]};box-shadow:0 0 8px 2px rgb(255 224 140 / 80%);`;
          iris.append(spark);
          const angle = Math.random() * Math.PI * 2;
          const distance = 70 + Math.random() * 130;
          gsap.fromTo(
            spark,
            { x: 0, y: 0, scale: 1, opacity: 1 },
            {
              x: Math.cos(angle) * distance,
              y: Math.sin(angle) * distance + 10 + Math.random() * 24,
              scale: 0.1,
              opacity: 0,
              duration: 0.7 + Math.random() * 0.7,
              ease: "power2.out",
              onComplete: () => spark.remove(),
            }
          );
        }
      };

      gsap.to(p, {
        v: 1,
        ease: "none",
        onUpdate: render,
        scrollTrigger: {
          start: () => {
            measure();
            return geo.s0;
          },
          end: () => geo.s0 + geo.dist,
          scrub: 0.35,
          invalidateOnRefresh: true,
          refreshPriority: -1,
          onRefresh: render,
        },
      });

      measure();
      if (document.querySelector("#about .ab-marker--exit .ab-marker-dot.is-lit")) {
        gate.line = gate.ignite = gate.open = 1;
      }
      render();

      return () => {
        window.removeEventListener("ab-exit-lit", onExitLit);
        about?.classList.add("section-theme-dark");
        sequence?.kill();
        root.removeAttribute("data-iris");
        iris.querySelectorAll<HTMLElement>(":scope > span:not([class])").forEach((spark) => spark.remove());
      };
    });
  }

  document.querySelectorAll<HTMLElement>("[data-sc-iris-root]").forEach(initIris);
  document.querySelectorAll<HTMLElement>("[data-sc-rail-root]").forEach(initRail);
</script>
