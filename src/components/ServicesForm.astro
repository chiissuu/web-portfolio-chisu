---
import type { ServicesSectionContent } from "../lib/content-types";

interface Props {
  t: ServicesSectionContent;
}

const { t } = Astro.props as Props;
const f = t.services.page.form;
const fields = f.fields;
---

<form
  class="rd-form"
  id="services-form"
  data-status="idle"
  data-msg-loading={f.submitLoading}
  data-msg-success={f.submitSuccess}
  data-msg-error={f.submitError}
  novalidate
>
  <h3 class="rd-form-title">{f.title}</h3>

  <p class="rd-form-notice">{f.submitSuccess}</p>
  <!-- Prevent native GET submission while JS is unavailable: this form
       is a local simulation, so personal data must never enter the URL. -->
  <fieldset class="rd-form-grid" disabled>
    <div class="rd-field" data-field="name">
      <label for="services-name">{fields.name}</label>
      <input id="services-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="rd-field" data-field="email">
      <label for="services-email">{fields.email}</label>
      <input id="services-email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="rd-field" data-field="company">
      <label for="services-company">{fields.company}</label>
      <input id="services-company" name="company" type="text" />
    </div>

    <div class="rd-field" data-field="serviceType">
      <label for="services-type">{fields.serviceType}</label>
      <select id="services-type" name="serviceType" required>
        <option value="" selected disabled>{fields.serviceType}</option>
        {fields.serviceOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>

    <div class="rd-field" data-field="budget">
      <label for="services-budget">{fields.budget}</label>
      <input id="services-budget" name="budget" type="text" />
    </div>

    <div class="rd-field" data-field="timeline">
      <label for="services-timeline">{fields.timeline}</label>
      <input id="services-timeline" name="timeline" type="text" />
    </div>

    <div class="rd-field rd-field-full" data-field="problem">
      <label for="services-problem">{fields.problem}</label>
      <textarea id="services-problem" name="problem" required></textarea>
    </div>

    <div class="rd-field rd-field-full" data-field="message">
      <label for="services-message">{fields.message}</label>
      <textarea id="services-message" name="message"></textarea>
    </div>
  </fieldset>

  <div class="rd-form-actions">
    <button class="rd-btn rd-btn-primary" type="submit" disabled>{f.submitIdle}</button>
    <p class="rd-form-status" data-role="status" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .rd-form :global(.rd-field label) {
    color: var(--color-text-muted);
  }

  .rd-form .rd-btn-primary {
    color: var(--color-paper);
  }

  .rd-form[data-status="error"] .rd-form-status,
  .rd-form :global(.rd-field-error) {
    color: #8f1e53;
  }

  .rd-form :global(.rd-field-error) {
    font-size: 0.82rem;
  }

  .rd-form button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  fieldset.rd-form-grid {
    min-width: 0;
    border: 0;
  }

  .rd-form-notice {
    font-size: 0.92rem;
  }

  .rd-form-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  import type { ServicesFormData } from "../lib/forms/types";
  import { validateServicesForm } from "../lib/forms/validate";
  import { submitFormPlaceholder } from "../lib/forms/submit";

  const form = document.getElementById("services-form") as HTMLFormElement | null;
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.querySelectorAll<HTMLElement>("[data-field]").forEach((field) => {
    const control = field.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea");
    if (!control) return;
    const error = document.createElement("p");
    error.id = `${control.id}-error`;
    error.className = "rd-field-error";
    error.hidden = true;
    control.setAttribute("aria-describedby", error.id);
    field.append(error);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (form.dataset.status === "loading") return;

    const statusEl = form.querySelector<HTMLElement>('[data-role="status"]');
    const formData = new FormData(form);

    const data: ServicesFormData = {
      name: String(formData.get("name") ?? ""),
      email: String(formData.get("email") ?? ""),
      company: String(formData.get("company") ?? ""),
      serviceType: String(formData.get("serviceType") ?? ""),
      budget: String(formData.get("budget") ?? ""),
      timeline: String(formData.get("timeline") ?? ""),
      problem: String(formData.get("problem") ?? ""),
      message: String(formData.get("message") ?? ""),
    };

    form.querySelectorAll("[data-field]").forEach((field) => {
      field.removeAttribute("data-invalid");
      field.querySelector("input, select, textarea")?.removeAttribute("aria-invalid");
      const error = field.querySelector<HTMLElement>(".rd-field-error");
      if (error) error.hidden = true;
    });

    const errors = validateServicesForm(data);

    if (errors.length > 0) {
      form.dataset.status = "error";
      if (statusEl) statusEl.textContent = form.dataset.msgError ?? "";

      errors.forEach((error) => {
        const field = form.querySelector(`[data-field="${error.field}"]`);
        field?.setAttribute("data-invalid", "true");
        const control = field?.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea");
        control?.setAttribute("aria-invalid", "true");
        const message = field?.querySelector<HTMLElement>(".rd-field-error");
        if (message) {
          message.textContent = control?.validationMessage || form.dataset.msgError || "";
          message.hidden = false;
        }
      });

      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();

      return;
    }

    form.dataset.status = "loading";
    form.setAttribute("aria-busy", "true");
    if (submitButton) submitButton.disabled = true;
    if (statusEl) statusEl.textContent = form.dataset.msgLoading ?? "";

    const result = await submitFormPlaceholder(data);

    form.dataset.status = result.ok ? "success" : "error";
    if (statusEl) {
      statusEl.textContent = result.ok
        ? form.dataset.msgSuccess ?? ""
        : form.dataset.msgError ?? "";
    }
    form.removeAttribute("aria-busy");
    if (submitButton) submitButton.disabled = false;
  });

  if (form) {
    const fieldset = form.querySelector("fieldset");
    if (fieldset) fieldset.disabled = false;
    if (submitButton) submitButton.disabled = false;
  }
</script>
