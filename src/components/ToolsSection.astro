---
import { withBase } from "../lib/paths.js";
import type { ToolsHomeSectionContent } from "../lib/content-types";
import SectionHeadingCard from "./SectionHeadingCard.astro";

interface Props {
  t: ToolsHomeSectionContent;
}

const { t } = Astro.props as Props;
const toolsHref = withBase("/tools/");
const copy = t.servicesTools.tools;
const toolExample = t.tools.page.items[0];
---

<section class="section-theme-dark" id="tools">
  <div class="section-inner">
    <SectionHeadingCard text={copy.title} image={copy.titleImage} as="h2" size="lg" />

    <div class="st-col">
      <p class="st-col-label">{t.tools.eyebrow}</p>

      <p class="st-description editorial-text">{copy.description}</p>

      {toolExample && (
        <article class="st-tool-example">
          <p class="st-tool-status">{toolExample.status}</p>
          <h3 class="st-tool-title">{toolExample.title}</h3>
          <p class="st-tool-text editorial-text editorial-text-muted">{toolExample.text}</p>
          <div class="st-tool-tags">
            {toolExample.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      )}

      <a class="st-cta" href={toolsHref}>
        <span class="st-cta-label">{copy.ctaLabel}</span>
        <span class="st-cta-arrow" aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .st-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    max-width: 46rem;
  }

  .st-col-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
  }

  .st-description {
    color: var(--theme-text-muted);
  }

  .st-tool-example {
    padding: 1.25rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
  }

  .st-tool-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-gold);
    margin-bottom: 0.6rem;
  }

  .st-tool-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
    color: var(--theme-text);
  }

  .st-tool-text {
    font-size: 0.92rem;
    margin-bottom: 0.9rem;
  }

  .st-tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .st-tool-tags span {
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--theme-border);
    font-size: 0.7rem;
    color: var(--theme-text-muted);
  }

  /* Large typographic CTA — full clickable block, not a small pill button. */
  .st-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--theme-border);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--theme-text);
    transition: gap 0.25s ease, color 0.25s ease;
  }

  .st-cta-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
    color: var(--color-brand-gold);
    font-size: 1.3em;
  }

  .st-cta:hover,
  .st-cta:focus-visible {
    gap: 1.6rem;
    color: var(--color-brand-gold);
  }

  .st-cta:hover .st-cta-arrow,
  .st-cta:focus-visible .st-cta-arrow {
    transform: translateX(6px);
  }

  .st-cta:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 4px;
  }
</style>
