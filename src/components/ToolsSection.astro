---
import type { ToolsHomeSectionContent } from "../lib/content-types";
import ShowcaseSection from "./ShowcaseSection.astro";
import ToolsBridge from "./ToolsBridge.astro";
import ToolsCatalog from "./ToolsCatalog.astro";

interface Props {
  t: ToolsHomeSectionContent;
}

const { t } = Astro.props as Props;
const copy = t.servicesTools.tools;
const items = t.tools.page.items;
---

<ShowcaseSection
  id="tools"
  title={copy.title}
  titleImage={copy.titleImage}
  backdrop="brushed"
  center
  edge="flat"
  grid={false}
>
  <ToolsBridge slot="bridge" />

  <p slot="intro">{copy.description}</p>

  <ToolsCatalog slot="after" items={items} copy={copy.catalog} />
</ShowcaseSection>

<style is:global>
  /* Room under the catalog for the gradient into Contacto and for the thread
     that leaves from the foot of the catalog (see ContactBridge). */
  #tools .tc {
    margin-bottom: clamp(6rem, 9vw, 8rem);
  }
</style>
