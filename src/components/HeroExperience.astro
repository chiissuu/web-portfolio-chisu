---
import RollLink from "./RollLink.astro";
// Sidebar nav icons only — the hero's own top nav (`.hx-nav` / `RollLink`)
// and the mobile nav stay text-only, unchanged. `lucide-astro` renders
// `stroke="currentColor"` by default, which is why the icons never set an
// explicit color: they inherit whatever the parent `<a>` sets (light/dark/
// active box text color — see `.hx-compact-vertical-nav a` below).
import { House, UserRound, Mail, FolderKanban, BriefcaseBusiness, Wrench, CircleHelp } from "lucide-astro";
import type { HeroExperienceContent } from "../lib/content-types";

interface Props {
  t: HeroExperienceContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Hero's own top nav (`.hx-nav-left`/`.hx-nav-right`, RollLink) + the
// mobile nav — UNTOUCHED order/hrefs/count (still 6, no FAQ), since
// neither is part of this task's scope. `icon` here is vestigial (kept
// from an earlier pass, harmless) — neither consumer reads it.
const navItems = [
  { href: "#home", label: t.nav.home, icon: House },
  { href: "#about", label: t.nav.about, icon: UserRound },
  { href: "#contact", label: t.nav.contact, icon: Mail },
  { href: "#projects", label: t.nav.projects, icon: FolderKanban },
  { href: "#services", label: t.nav.services, icon: BriefcaseBusiness },
  { href: "#tools", label: t.nav.tools, icon: Wrench },
];

// Indexed BEFORE the left/right split so `data-morph-source="nav-{index}"`
// stays continuous (0-5) across both halves and lines up with the matching
// `morphIndex` on `sidebarNavItems` below. Slicing first (the old code)
// would reset each half's index back to 0 and collide.
const indexedNavItems = navItems.map((item, index) => ({ ...item, index }));
const navLeft = indexedNavItems.slice(0, 3);
const navRight = indexedNavItems.slice(3);

// Dedicated, independently-ordered nav model for the sidebar ONLY —
// `navItems`/`navLeft`/`navRight` above (hero's own top nav + mobile nav)
// stay completely untouched. `navId` is the stable key the active-section
// script (in the <script> below) matches against. `morphIndex` links back
// to the hero's own nav item by its ORIGINAL index in `navItems` above, so
// the hero→sidebar crossfade still works for the 5 links that have a hero
// equivalent — Servicios/Tools now point at their real subpages instead of
// an anchor, but still morph in from the same hero nav item they always
// did. FAQ has no hero-nav equivalent, so `morphIndex` is `null` and it
// simply appears static once the sidebar itself fades in (same as the
// Contacto CTA, which also has no morph source).
const sidebarNavItems = [
  { navId: "home", label: t.nav.home, icon: House, href: "#home", morphIndex: 0 },
  { navId: "about", label: t.nav.about, icon: UserRound, href: "#about", morphIndex: 1 },
  { navId: "projects", label: t.nav.projects, icon: FolderKanban, href: "#projects", morphIndex: 3 },
  { navId: "services", label: t.nav.services, icon: BriefcaseBusiness, href: `${base}/servicios/`, morphIndex: 4 },
  { navId: "tools", label: t.nav.tools, icon: Wrench, href: `${base}/tools/`, morphIndex: 5 },
  { navId: "contact", label: t.nav.contact, icon: Mail, href: "#contact", morphIndex: 2 },
  { navId: "faq", label: t.nav.faq, icon: CircleHelp, href: "#faq", morphIndex: null as number | null },
];

// Placeholder cutout — swap public/assets/images/profile-cutout-alt.png for
// the final professional portrait when it's ready. No code change needed.
// It's a low-resolution placeholder on purpose; we don't run any filter
// (sharpen/saturate/etc.) to try to disguise that — only the deliberate
// scroll-driven blur (see --portrait-blur) touches this image.
const portraitSrc = `${base}/assets/images/profile-cutout-alt.png`;

// `displayWordmark` ("CHISU") is the giant decorative hero mark's
// accessible name — NOT the site's real name (that's `siteName`,
// "CHIISSUU", used as `.hx-compact-mark`'s real text elsewhere). The mark
// itself is now a single raster image (public/assets/images/
// hero-wordmark-gold.png, trimmed to its opaque bounds, transparent
// background preserved) instead of per-letter spans. GSAP's entrance
// tween (the <script> below, untouched) still finds it via the same
// `.hx-wordmark-letter` selector — it now matches exactly one element
// instead of five, so the same wipe-in tween applies to the image as a
// whole with no JS change needed.
const wordmarkSrc = `${base}/assets/images/hero-wordmark-gold.png`;
---

<section class="hx-wrap section-theme-warm" id="home">
  <div class="hx-pin" id="hx-pin">
    <!--
      `.hx-pin-fade` is a real DOM child, NOT `.hx-pin`'s own CSS
      `background` — deliberately, since ScrollTrigger pins `.hx-pin`
      directly (see the <script> below) and its background must stay
      untouched/unanimated. This child carries the warm backdrop instead,
      painted first (z-index: 0, before `.hx-glow`) so it sits behind
      every other layer, and is the ONLY thing the scroll timeline fades
      (opacity 1->0) in the final ~12% of the timeline — revealing the
      real `AboutSection` (already scrolled up beneath the fixed pin
      thanks to `pinSpacing: false`) through it, instead of a hard,
      un-smoothed cut the instant the pin releases.
    -->
    <div class="hx-pin-fade" id="hx-pin-fade" aria-hidden="true"></div>
    <div class="hx-glow" aria-hidden="true"></div>

    <!--
      `.hx-full-hero-scroll-motion` is a pure positioning/responsibility
      boundary, never transformed as a unit. The scroll timeline instead
      writes `transform`/`opacity` on each individual element tagged
      `data-morph-source` inside it (brand, tagline, metrics, nav links —
      each travels to its own `.hx-compact-sidebar` equivalent), plus
      opacity-only fades on the elements with no sidebar equivalent
      (portrait, title, chip card, actions). `.hx-compact-sidebar` itself
      now lives outside `.hx-wrap` entirely (see below, after the closing
      `</section>`) so it can persist past the hero. There is no
      intermediate "About Me" transition screen — the hero hands off
      directly to the real `AboutSection` (`id="about"`) rendered right
      after this component; see the scroll timeline's State C below, which
      is the last state. The entrance timeline, separately, only ever
      touches elements inside `.hx-full-hero-intro-motion` — so the two
      systems never write `transform` on the same element.
    -->
    <div class="hx-full-hero-scroll-motion" id="hx-scroll-motion">
      <div class="hx-full-hero-intro-motion" id="hx-intro-motion">
        <div class="hx-wordmark" id="hx-wordmark" role="img" aria-label={t.hero.displayWordmark}>
          <img
            class="hx-wordmark-letter hx-wordmark-image"
            src={wordmarkSrc}
            data-morph-source="brand"
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            draggable="false"
            width="2142"
            height="815"
          />
        </div>

        <nav class="hx-nav hx-nav-left" aria-label="Primary">
          {navLeft.flatMap((item, i) => [
            i > 0 && (
              <span class="hx-nav-sep" aria-hidden="true">|</span>
            ),
            <span class="hx-nav-item" data-morph-source={`nav-${item.index}`}>
              <RollLink href={item.href} label={item.label} />
            </span>,
          ])}
        </nav>

        <nav class="hx-nav hx-nav-right" aria-label="Secondary">
          {navRight.flatMap((item, i) => [
            i > 0 && (
              <span class="hx-nav-sep" aria-hidden="true">|</span>
            ),
            <span class="hx-nav-item" data-morph-source={`nav-${item.index}`}>
              <RollLink href={item.href} label={item.label} />
            </span>,
          ])}
        </nav>

        <div class="hx-portrait">
          <img src={portraitSrc} alt={t.hero.imageAlt} />
        </div>

        <div class="hx-foreground" id="hx-foreground">
          <h1 class="hx-title-block">
            <span class="hx-title-mask"><span class="hx-title-line">{t.hero.title[0]}</span></span>
            <span class="hx-title-mask"><span class="hx-title-line hx-title-highlight"><mark>{t.hero.title[1]}</mark></span></span>
            <span class="hx-title-mask"><span class="hx-title-line">{t.hero.title[2]}</span></span>
          </h1>

          <div class="hx-metrics">
            {t.hero.metrics.map((metric, index) => (
              <div class="hx-metric-card hx-frosted-card" data-morph-source={`metric-${index}`}>
                <span class="hx-metric-value">{metric.value}</span>
                <span class="hx-metric-label">{metric.label}</span>
              </div>
            ))}
          </div>

          <p class="hx-personal-note">{t.hero.personalNote}</p>

          <div class="hx-aside-right">
            <div class="hx-chip-card hx-frosted-card">
              {t.hero.chips.map((chip) => (
                <span class="hx-chip">
                  <i aria-hidden="true"></i>
                  {chip}
                </span>
              ))}
            </div>

            <p class="hx-tagline" data-morph-source="tagline">{t.hero.tagline}</p>
          </div>

          <div class="hx-actions">
            <a class="hx-btn hx-btn-primary" href="#projects">{t.hero.primaryCta}</a>
            <a class="hx-btn hx-btn-ghost" href="#about">{t.hero.secondaryCta}</a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!--
  Sidebar lives OUTSIDE `.hx-wrap` on purpose: it must persist (position:
  fixed) for the rest of the page — Sobre mí, Proyectos, Servicios y Tools,
  Contacto, FAQ — well past the point where `.hx-wrap` (and its sticky
  `.hx-pin`) end. The `<aside>` itself is transparent (no background of its
  own) so the full-width section background behind it (warm/dark,
  alternating per section) shows through; each `<article>` inside carries
  its own `.hx-glass` translucent surface — the SAME finish as the hero's
  "Sobre mí" ghost button (`.hx-btn-ghost`), never a solid/near-opaque
  panel — so a section boundary crossing behind the sidebar is genuinely
  visible through a card's own background, not just at its edges. There is
  intentionally NO single `data-bg-theme` on this `<aside>` anymore — each
  `<article>` below tracks and tweens its OWN `data-theme`
  ("warm"/"dark") independently, driven by real per-article
  `getBoundingClientRect()` overlap against every `.section-theme-dark`
  section (see the per-article theme sync in the <script> below), so two
  adjacent articles can legitimately show different themes at the same
  scroll position while a section boundary is crossing between them.
  Reuses `t.hero`/`t.nav`/`t.contact` data only; no text here is
  hardcoded/duplicated from elsewhere. Starts `aria-hidden="true"`; the
  scroll timeline flips it to `"false"` (and adds `.is-active`) once the
  morph has crossed its activation threshold.
-->
<aside
  class="hx-compact-sidebar"
  id="hx-compact-sidebar"
  aria-label="Compact site navigation"
  aria-hidden="true"
>
  <article class="hx-sidebar-article hx-glass hx-sidebar-brand" data-theme="warm">
    <a class="hx-compact-mark" href="#home" aria-label={t.hero.sidebarMark}>
      <img
        class="hx-compact-wordmark-image"
        src={wordmarkSrc}
        data-morph-target="brand"
        alt=""
        aria-hidden="true"
        draggable="false"
        width="2142"
        height="815"
      />
      <span class="hx-compact-mark-registered" aria-hidden="true">&reg;</span>
    </a>
    <p class="hx-compact-tagline" data-morph-target="tagline">{t.hero.tagline}</p>
  </article>

  <article class="hx-sidebar-article hx-glass hx-sidebar-metrics" data-theme="warm">
    <div class="hx-compact-metrics">
      {t.hero.metrics.map((metric, index) => (
        <div class="hx-compact-metric" data-morph-target={`metric-${index}`}>
          <span class="hx-compact-metric-value">{metric.value}</span>
          <span class="hx-compact-metric-label">{metric.label}</span>
        </div>
      ))}
    </div>
  </article>

  <!-- Orden fijo del sidebar: Inicio -> Sobre mí -> Proyectos -> Servicios
       -> Tools -> Contacto -> FAQ. Servicios/Tools llevan a sus subpáginas
       reales (no anclas); el resto sigue anclado dentro de esta misma
       página. El orden de las SECCIONES reales de la página no cambia —
       solo el orden de este listado de enlaces. -->
  <article class="hx-sidebar-article hx-glass hx-sidebar-nav" data-theme="warm">
    <nav class="hx-compact-vertical-nav" aria-label="Compact navigation links">
      {sidebarNavItems.map((item) => {
        const Icon = item.icon;
        const morphTarget = item.morphIndex !== null ? `nav-${item.morphIndex}` : undefined;
        return (
          <a href={item.href} data-morph-target={morphTarget} data-nav-id={item.navId}>
            <Icon class="hx-compact-nav-icon" aria-hidden="true" size={18} />
            <span class="hx-compact-nav-label">{item.label}</span>
          </a>
        );
      })}
    </nav>
  </article>

  <!-- Orden fijo: LinkedIn (deshabilitado, sin URL) -> GitHub -> Redes
       Sociales -> Botón Contacto. El botón vive DENTRO de este artículo
       ahora (ya no es un elemento hermano fuera de él) para evitar una
       instancia duplicada. -->
  <article class="hx-sidebar-article hx-glass hx-sidebar-socials" data-theme="warm">
    <div class="hx-compact-socials">
      <span class="hx-compact-social-linkedin" aria-disabled="true">{t.contact.links.linkedinLabel}</span>
      <a href={t.contact.links.github} target="_blank" rel="noopener noreferrer">{t.contact.links.githubLabel}</a>
      <a href={t.contact.links.linktree} target="_blank" rel="noopener noreferrer">{t.contact.links.linktreeLabel}</a>
    </div>
    <a class="hx-btn hx-btn-primary hx-compact-cta" href="#contact">{t.nav.contact}</a>
  </article>
</aside>

<button
  type="button"
  class="hx-mobile-toggle"
  id="hx-mobile-toggle"
  aria-expanded="false"
  aria-controls="hx-mobile-nav"
  aria-label="Abrir menú"
>
  <span></span><span></span><span></span>
</button>

<nav class="hx-mobile-nav" id="hx-mobile-nav" aria-label="Mobile navigation" aria-hidden="true" inert>
  {navItems.map((item) => (
    <a href={item.href}>{item.label}</a>
  ))}
</nav>

<style>
  /* Structural fix, not another height tweak — `position: sticky` +
     `.hx-wrap` taller than the viewport was the root cause of the empty
     warm-background stretch, not the exact height chosen (300svh, then
     240svh, then 195svh, then 165svh all had the same underlying issue:
     a wrapper taller than the viewport, unpinning only once the wrapper's
     OWN bottom scrolled by, independent of whether the animation itself
     had anything left to show). Replaced with a ScrollTrigger-controlled
     `pin` (see `buildScrollTimeline()` in the <script> below):
     `.hx-wrap`/`.hx-pin` are both exactly one viewport tall, ScrollTrigger
     pins `.hx-pin` for exactly one additional viewport height of scroll
     (`end: () => `+=${window.innerHeight}`), and `pinSpacing: false` means
     `AboutSection` — immediately next in the document, no spacer, no
     provisional panel — slides up in normal flow beneath the fixed hero
     the entire time, reaching the viewport top exactly when the pin
     releases. */
  .hx-wrap {
    position: relative;
    height: 100svh;
    /* Fixes a pale/ivory horizontal band exposed during the gold<->black
       crossfade (both scroll directions), reported against a real
       recording. ROOT CAUSE, confirmed via a Playwright reproduction of
       this exact DOM/CSS wired to the real GSAP + ScrollTrigger pin
       (same `trigger: wrapEl, start: "top top", end: () =>
       `+=${window.innerHeight}`, pin: pinEl, pinSpacing: false` config as
       the <script> below, untouched here): `.hx-wrap` inherits
       `background: var(--color-bg)` (#d5cfbe, pale) from the shared
       `.section-theme-warm` class (Layout.astro) -- reused here only for
       its `--theme-*` custom properties, never because this background
       was meant to be visible. Normally it never is: `.hx-pin` (this
       element's only child) is fully opaque and exactly covers it the
       entire time. But for the final ~23% of the scroll timeline
       (75%-98%, see the `.hx-pin-fade`/`.hx-glow` opacity tween further
       down in the <script>), `.hx-pin` is still `position: fixed`
       (still pinned) while its own fade layers go transparent -- and in
       the vertical strip still ABOVE `AboutSection`'s current
       (still-sliding-up) top edge, nothing else sits behind `.hx-pin` in
       the paint order except `.hx-wrap`'s own background. Pixel-level
       screenshots confirmed the leaked color measured ~rgb(211,202,179)
       against `--color-bg`'s rgb(213,207,190) -- a near-exact match --
       appearing only in that region/timing and gone once
       `AboutSection`'s top reaches this element's own top (0) or once
       `.hx-pin-fade` is fully opaque again -- exactly the reported
       symptom, reproducible in both scroll directions since it's a pure
       function of scroll progress. Fix: give `.hx-wrap` itself the same
       dark tone already used by both `.hx-pin-fade`'s own fallback and
       `AboutSection`'s flat background (both `var(--section-dark-start)`
       -- see the analogous, already-established override pattern in
       AboutSection.astro's own scoped `.section-theme-dark` rule), so
       anything that leaks through during the crossfade reads as
       consistent dark instead of a jarring pale flash. Astro's automatic
       style scoping means this rule still only ever matches the ONE
       `.hx-wrap` this component renders -- Layout.astro's shared
       `.section-theme-warm` rule (and every other section reusing it)
       is untouched. */
    background: var(--section-dark-start);
  }

  .hx-pin {
    /* Wordmark geometry drives the nav position below it — keep every
       consumer of "where does the wordmark end" reading from these custom
       properties instead of a hardcoded number. `--hx-wordmark-font-size`
       was overwritten inline by the JS auto-fit pass once fonts were
       ready; that pass (`fitWordmarkWidth()` in the <script> below,
       untouched) now no-ops harmlessly instead (it measures
       `.hx-wordmark-row`, which no longer exists now that the wordmark is
       a single image, and returns early) — geometry is driven by
       `--hx-wordmark-height` below instead, off the image's own real
       aspect ratio via CSS alone, no JS involved. */
    --hx-wordmark-top: 4vh;
    --hx-wordmark-height: min(38svh, 36vw, 24rem);
    --hx-wordmark-line-height: 0.86;
    --hx-nav-gap: clamp(1rem, 2vw, 2rem);
    --hx-nav-top: calc(
      var(--hx-wordmark-top) + var(--hx-wordmark-height) + var(--hx-nav-gap)
    );
    --hx-figure-x: 50%;
    /* Pulled in from the viewport edge (was clamp(2rem,9vw,5.5rem)) so the
       metric/trait cards sit closer to the centered composition instead of
       hugging the sides. */
    --hx-aside-inset: clamp(1.5rem, 6vw, 4rem);
    --portrait-blur: 0px;
    /* Drives the "|" nav separators' opacity (see `.hx-nav-item` below) —
       tweened via a proxy object, same pattern as `--portrait-blur`, since
       a `::after` pseudo-element can't be a direct GSAP tween target. */
    --nav-sep-opacity: 1;

    /* Local black-gold palette for this first visual-harmonization pass.
       Scoped to `.hx-pin` only (not Layout.astro or any shared token) so
       nothing outside the Hero is affected. Purely visual — none of these
       drive geometry, position, or any existing variable above. */
    --hx-ui-black: #12100c;
    --hx-ui-black-warm: #2a1c09;
    --hx-ui-ivory: #fff2cf;
    --hx-ui-gold: #efc65b;
    --hx-ui-gold-line: rgb(249 211 119 / 46%);
    --hx-ui-dark-glass: rgb(16 13 8 / 74%);
    --hx-ui-dark-glass-soft: rgb(22 16 8 / 58%);
    --hx-ui-shadow: rgb(35 20 0 / 28%);

    /* No longer `position: sticky` — ScrollTrigger's own `pin: pinEl`
       option (see the <script> below) now does the fixing. `top: auto`
       is inert here (a `position: relative` element ignores `top` unless
       explicitly offset) but kept for clarity/parity with the pin
       geometry it replaces. */
    position: relative;
    top: auto;
    height: 100svh;
    min-height: 640px;
    overflow: clip;
    /* No `background` here anymore — that would be animating the
       background of the element ScrollTrigger pins directly. The warm
       backdrop now lives on `.hx-pin-fade`, a real child (see the markup
       above), which is what the timeline actually fades. */
  }

  /* See the markup comment above `.hx-pin-fade` — painted first (before
     `.hx-glow`) at z-index: 0 so it sits behind every other layer in the
     pin, providing the same warm backdrop `.hx-pin`'s own `background`
     used to, but as an independently animatable element. */
  .hx-pin-fade {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Solid fallback underneath the image below (shows through if the
       image is still loading, fails to load, or doesn't fully cover a
       given viewport) — matches `--section-dark-start`, the exact color
       AboutSection's own dark gradient begins at, so the gold-to-black
       crossfade (see the <script> below) never risks revealing a
       beige/light flash underneath the background image. */
    background: var(--section-dark-start);
    /* First pass of the new Hero background art. Same file the user
       verified byte-for-byte (public/assets/images/hero-background-gold.png,
       untouched PNG, no recompression/format conversion). Root-relative
       path, matching how every other `public/assets/...` asset in this
       component is already referenced. */
    background-image: url(/assets/images/hero-background-gold-alternative.png);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .hx-glow {
    position: absolute;
    inset: -10%;
    z-index: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(138, 100, 32, 0.1), transparent 45%),
      radial-gradient(circle at 82% 78%, rgba(224, 197, 139, 0.12), transparent 45%);
    pointer-events: none;
  }

  /* --- Scroll-motion wrapper: purely a positioning/responsibility
     boundary now — it is NEVER transformed as a unit by the scroll
     timeline (that was the earlier "whole hero slides/scales together"
     bug). Every element that has a sidebar equivalent (brand, tagline,
     metrics, nav links — each tagged `[data-morph-source]`) travels to its
     own target individually; everything else (portrait, title, chip card,
     actions) just fades out in place. --- */
  .hx-full-hero-scroll-motion {
    position: relative;
    z-index: 1;
    height: 100%;
  }

  /* Individually FLIP-morphed elements — each one gets its own
     translate/scale toward its sidebar target, computed from measured
     rects (see the <script> below), never from the parent wrapper. */
  [data-morph-source] {
    will-change: transform, opacity;
  }

  .hx-full-hero-intro-motion {
    position: relative;
    height: 100%;
  }

  /* Layer order: bg -> CHISU (giant display wordmark) -> portrait ->
     professional title -> nav/cards. `CHISU` is 5 letters, not the 8 of
     `CHIISSUU` — see `t.hero.displayWordmark` vs `t.hero.siteName` in
     content-types.ts for why these are separate fields. */
  /* Outer positioning shell only — spans the full width so it can CENTER
     the wordmark image inside it via `justify-content: center`. `height`
     drives `--hx-nav-top` below it (see `.hx-pin` above) instead of the
     old font-size-derived formula. */
  .hx-wordmark {
    position: absolute;
    inset-inline: 0;
    top: var(--hx-wordmark-top);
    height: var(--hx-wordmark-height);
    z-index: 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    pointer-events: none;
  }

  /* Orphaned by the image swap below (no element matches this selector
     anymore — the wordmark is a single <img>, not a row of letter spans)
     but left in place rather than removed: harmless dead CSS, not part of
     this task's authorized scope. */
  .hx-wordmark-row {
    display: inline-flex;
    width: max-content;
    gap: 0;
    white-space: nowrap;
  }

  /* `.hx-wordmark-letter` no longer carries any of its own typography —
     every property on the old rule (font-family, font-weight, font-size,
     line-height, letter-spacing, color, text-shadow) only ever made sense
     for the text spans it used to select; none of it has any effect on an
     `<img>`. The class name itself stays on the new image element purely
     so the existing GSAP entrance-tween selector (`.hx-wordmark-letter`,
     in the untouched <script> below) still finds it — now matching one
     element instead of five, so the same wipe-in tween applies to the
     whole image with zero JS changes. All actual visual sizing now comes
     from this new, image-specific class instead. */
  .hx-wordmark-image {
    display: block;
    width: auto;
    height: 100%;
    max-width: 94.4vw;
    object-fit: contain;
  }

  .hx-portrait {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: var(--hx-figure-x);
    z-index: 2;
    /* Slightly shorter than before (was min(100svh,920px)) so the head
       clears the wordmark/nav row instead of touching the top edge — the
       figure stays centered and bottom-anchored, just not stretched to the
       full viewport height. */
    height: min(92svh, 860px);
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hx-portrait img {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: 50% 100%;
    /* Only the deliberate scroll-driven blur touches this image — it's a
       low-res placeholder on purpose, and no filter should try to hide that. */
    filter: blur(var(--portrait-blur, 0px));
    will-change: filter;
  }

  .hx-foreground {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .hx-title-block {
    position: absolute;
    left: var(--hx-figure-x);
    top: calc(44% + clamp(2.9rem, 6.5svh, 3.75rem));
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
    text-align: center;
    font-family: var(--font-title);
    font-weight: 700;
    /* Was clamp(1.5rem, 3vw, 2.6rem); scaled up ~27% for the previous
       pass, then +8% again here (clamp(1.9rem, 3.8vw, 3.3rem) ->
       clamp(2.05rem, 4.1vw, 3.56rem)) — font-family/weight/color/stroke/
       paint-order/line-height/highlight all untouched. */
    font-size: clamp(2.05rem, 4.1vw, 3.56rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    /* Sits over the torso — light paper tone. Contrast against the
       portrait now comes ONLY from the thin `-webkit-text-stroke` below
       (see `.hx-title-line:not(.hx-title-highlight)`); the previous
       `text-shadow` here (a 26px-blur, 55%-opacity dark halo) was the
       actual source of the "dirty gray shadow" behind "Software
       Engineer" / "GFX" — it was inherited by every line, including the
       two non-highlighted ones, since text-shadow isn't scoped by
       `.hx-title-highlight`. Removed outright rather than just
       re-scoped: nothing in this spec calls for any shadow on line 2
       either, since the `<mark>` background already provides its own
       contrast. */
    color: var(--hx-ui-black);
    text-shadow:
      0 1px 0 rgb(255 242 207 / 24%),
      0 8px 24px rgb(35 20 0 / 18%);
  }

  .hx-title-mask {
    display: block;
    overflow: hidden;
  }

  .hx-title-line {
    display: block;
  }

  .hx-title-highlight mark {
    background: linear-gradient(
      135deg,
      rgb(18 16 12 / 96%),
      rgb(42 28 9 / 92%)
    );
    color: var(--hx-ui-gold);
    padding: 0.05em 0.35em;
    border-radius: 7px;
    border: 1px solid var(--hx-ui-gold-line);
    box-shadow:
      0 10px 24px rgb(35 20 0 / 24%),
      inset 0 1px 0 rgb(255 242 207 / 10%);
    box-decoration-break: clone;
  }

  /* Thin, near-imperceptible dark outline on the two non-highlighted title
     lines only (line 2 already gets contrast from the gold `<mark>` above).
     Purely a legibility aid against the portrait — no box, no background,
     no glow, no text-shadow, no filter. `:not(.hx-title-highlight)` keeps
     this off the highlighted line so its own treatment is untouched.
     `paint-order: stroke fill` paints the stroke BEHIND the fill instead
     of the (browser-default) fill-then-stroke, which is what was
     clogging tight glyph interiors/terminals on letters like `t`, `f`,
     `e` — with fill-on-top the stroke reads as a clean thin outline
     instead of doubling the ink at every curve. Narrowed 0.5px -> 0.4px
     at the same time for extra safety on small glyph details; the fill
     stays fully solid `var(--color-paper)` either way. */
  .hx-title-line:not(.hx-title-highlight) {
    paint-order: stroke fill;
    -webkit-text-stroke: 0.4px var(--color-ink);
  }

  /* Scoped to `:not(.hx-static)` so the reduced-motion/narrow-viewport
     fallback's own explicit reset (`.hx-pin.hx-static .hx-title-block`
     -- plain `--color-ink`, no shadow) stays completely untouched; this
     new warm-black/gold-shadow treatment only applies to the normal
     scroll-jacked composition. */
  .hx-pin:not(.hx-static) .hx-title-line:not(.hx-title-highlight) {
    color: #17130b;
    text-shadow:
      0 1px 0 rgba(224, 197, 139, 0.65),
      0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .hx-metrics {
    position: absolute;
    left: var(--hx-aside-inset);
    /* Derived from the nav row, with extra clearance (was +2.75rem) so a
       bigger, non-monospaced "Contacto" nav label can never collide with
       the metric cards below it regardless of exact rendered width. */
    top: calc(var(--hx-nav-top) + 3.5rem);
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: clamp(9rem, 12vw, 11.5rem);
  }

  /* `.hx-glass` — SIDEBAR-ONLY now (see `.hx-sidebar-article` further
     down). Kept intentionally at this very low, near-invisible opacity
     (a literal copy of the hero's "Sobre mí" ghost button finish) because
     the sidebar's own boundary-bleed-through effect depends on it: the
     warm/dark section physically behind a `.hx-sidebar-article` needs to
     show through clearly while a section boundary crosses behind the
     fixed sidebar. The 3 hero cards below use the separate, more opaque
     `.hx-frosted-card` instead — a real frosted-glass finish is what's
     wanted there, not the same bleed-through requirement. */
  .hx-glass {
    background: rgb(213 207 190 / 12%);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--color-ink);
  }

  /* `.hx-frosted-card` — the visible frosted-glass finish for the hero's
     3 foreground cards only (2 metric cards + the chip card): a
     genuinely translucent, blurred panel, never solid/opaque white,
     tuned to read clearly against the busy portrait/background instead
     of the sidebar's much lower, near-invisible `.hx-glass` opacity. */
  .hx-frosted-card {
    background: linear-gradient(
      145deg,
      var(--hx-ui-dark-glass),
      rgb(42 28 9 / 64%)
    );
    border: 1px solid var(--hx-ui-gold-line);
    border-radius: 8px;
    backdrop-filter: blur(14px) saturate(115%);
    -webkit-backdrop-filter: blur(14px) saturate(115%);
    box-shadow:
      0 18px 42px var(--hx-ui-shadow),
      inset 0 1px 0 rgb(255 242 207 / 12%);
    color: var(--color-ink);
  }

  .hx-metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
  }

  .hx-metric-card:nth-child(2) {
    align-self: flex-end;
    margin-top: -0.2rem;
  }

  .hx-metric-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--hx-ui-gold);
  }

  .hx-metric-label {
    font-size: 0.72rem;
    line-height: 1.3;
    color: rgb(255 242 207 / 78%);
    opacity: 1;
  }

  /* Groups chip-card + tagline into one flowing stack — their combined
     height varies with viewport/font, so only normal flow (anchored once,
     below the nav with generous clearance) can guarantee no collision with
     "Servicios" / "Tools" in the nav row above. */
  .hx-aside-right {
    position: absolute;
    right: var(--hx-aside-inset);
    top: calc(var(--hx-nav-top) + 3.5rem);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.1rem;
    max-width: 18rem;
  }

  /* See `.hx-frosted-card` above — same shared frosted-glass finish. */
  .hx-chip-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.2rem;
  }

  .hx-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(255 242 207 / 90%);
    opacity: 1;
    white-space: nowrap;
  }

  .hx-chip i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hx-ui-gold);
    box-shadow: 0 0 0 3px rgb(239 198 91 / 14%);
  }

  .hx-tagline {
    max-width: 20ch;
    text-align: right;
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(248, 240, 220, 0.82);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.38);
    opacity: 1;
  }

  /* No base rule existed for `.hx-personal-note` before this pass (only
     `.hx-pin.hx-static`/responsive position overrides) — it inherited its
     color from an ancestor. Added here, matching `.hx-tagline`'s new
     treatment, since it needs the same dark-on-gold contrast and the task
     calls for both to share this exact color/opacity. */
  .hx-personal-note {
    color: rgba(248, 240, 220, 0.82);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.38);
    opacity: 1;
  }

  .hx-actions {
    position: absolute;
    left: var(--hx-figure-x);
    bottom: clamp(2.25rem, 6.5vh, 3.75rem);
    z-index: 4;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .hx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid transparent;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .hx-btn-primary {
    background: var(--color-brand-gold);
    color: var(--color-ink);
  }

  .hx-btn-ghost {
    border-color: var(--color-line);
    color: var(--color-ink);
    background: rgb(213 207 190 / 12%);
    backdrop-filter: blur(6px);
  }

  .hx-btn:hover {
    transform: translateY(-2px);
  }

  /* Scoped to `.hx-actions` only — `.hx-btn`/`.hx-btn-primary`/
     `.hx-btn-ghost` are shared with the compact sidebar's own CTA
     (`.hx-compact-cta`), so unscoped edits here would leak into it. */
  .hx-actions .hx-btn {
    border-radius: 12px;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hx-actions .hx-btn-primary {
    background: linear-gradient(
      135deg,
      var(--hx-ui-black),
      var(--hx-ui-black-warm)
    );
    color: var(--hx-ui-gold);
    border-color: rgb(249 211 119 / 55%);
    box-shadow:
      0 12px 30px rgb(35 20 0 / 28%),
      inset 0 1px 0 rgb(255 242 207 / 10%);
  }

  .hx-actions .hx-btn-ghost {
    background: var(--hx-ui-dark-glass-soft);
    color: var(--hx-ui-ivory);
    border-color: rgb(249 211 119 / 32%);
    box-shadow: 0 10px 26px rgb(35 20 0 / 18%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .hx-actions .hx-btn-primary:hover {
    background: var(--hx-ui-gold);
    color: var(--hx-ui-black);
    border-color: var(--hx-ui-gold);
  }

  .hx-actions .hx-btn-ghost:hover {
    background: rgb(18 14 8 / 78%);
    color: var(--hx-ui-gold);
    border-color: rgb(249 211 119 / 58%);
  }

  .hx-actions .hx-btn:focus-visible {
    outline: 2px solid var(--hx-ui-ivory);
    outline-offset: 3px;
  }

  .hx-nav {
    position: absolute;
    top: var(--hx-nav-top);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    /* Bigger and no longer monospaced. */
    font-family: var(--font-body);
    font-size: clamp(0.92rem, 1.15vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: rgba(248, 240, 220, 0.92);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.38);
    white-space: nowrap;
  }

  .hx-nav-left {
    left: clamp(1.5rem, 4vw, 2.8vw);
  }

  .hx-nav-right {
    right: clamp(1.5rem, 4vw, 2.8vw);
  }

  /* Separators are real DOM siblings between `.hx-nav-item`s (inserted in
     the markup, not a `::after` on the link) so they can be vertically
     centered independently of text baseline metrics — a baseline-anchored
     "|" pseudo-element sat visibly low. `aria-hidden`, `align-self: center`
     + `line-height: 1` (the flex row's own `align-items: center` already
     centers it too — both are set for robustness), and NOT nested inside
     `.hx-nav-item`/`RollLink`, so it never participates in the rollover
     hover animation. Color is `--color-ink` (real black), inherited from
     `.hx-nav` — previously dimmed to a fixed 40% opacity, which read as
     gray instead of black even at rest. Opacity now reads ONLY
     `--nav-sep-opacity`, tweened by the scroll timeline (they have no
     sidebar equivalent — see Section 4 of the scroll spec) — same
     custom-property pattern as `--portrait-blur` — so alignment/fade-out
     behavior on scroll is unchanged, just fully opaque (black) at rest. */
  .hx-nav-sep {
    align-self: center;
    line-height: 1;
    opacity: var(--nav-sep-opacity, 1);
    font-weight: 400;
    color: rgba(224, 197, 139, 0.62);
  }

  .hx-nav :global(a:hover),
  .hx-nav :global(a:focus-visible) {
    color: #e0c58b;
    text-shadow: 0 2px 10px rgb(18 12 2 / 48%);
  }

  /* --- Compact sidebar: its own composition, a `position: fixed` sibling
     of `.hx-wrap` (see the markup below the hero `</section>`) so it
     persists past the end of the hero instead of disappearing with the
     sticky `.hx-pin`. TRANSPARENT — no background/border of its own — so
     the full-width section background behind it shows through completely;
     each `.hx-sidebar-article` carries the actual `.hx-glass` surface.
     Revealed by opacity ONLY — never `x`/translate, so it never reads as
     sliding in from the left. `visibility`/`pointer-events` are driven by
     the `.is-active` class (added by the scroll timeline once the morph
     crosses its activation point), NOT `display: none` — the FLIP
     measurements in the <script> below need `getBoundingClientRect()` on
     its children while still visually hidden. `--hx-sidebar-width` is
     defined once, at `body.redesign-home` scope (see Layout.astro), so the
     sidebar's width and the sections' inner-content compensation can never
     drift out of sync; the literal clamp() here is only a fallback for
     contexts where that variable isn't set. */
  /* `top`/`bottom` (not `inset-block: 0`) + `justify-content: flex-start`
     (not `center`) on purpose: with 4 articles — the nav one now holding 7
     links — the sidebar's natural content height can exceed the viewport.
     Centering a taller-than-box flex column splits the overflow evenly
     above `top` AND below `bottom`, i.e. off-screen in BOTH directions at
     once, invisibly — that was the actual cause of content reading as
     "cut off top and bottom". Anchoring to `flex-start` + a real
     `max-height` + `overflow-y: auto` means any leftover overflow (should
     the compaction below still not be enough on a given screen) becomes a
     contained, scrollable overflow at the BOTTOM only, never an invisible
     one — never `transform: scale()`, which would shrink the sidebar as a
     unit instead of fixing the actual layout cause. */
  .hx-compact-sidebar {
    position: fixed;
    top: clamp(0.75rem, 1.5vh, 1rem);
    bottom: clamp(0.75rem, 1.5vh, 1rem);
    inset-inline-start: 0;
    z-index: 90;
    width: var(--hx-sidebar-width, clamp(15.5rem, 22vw, 19.5rem));
    height: auto;
    max-height: calc(100svh - clamp(1.5rem, 3vh, 2rem));
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: clamp(0.45rem, 0.9vh, 0.75rem);
    padding: clamp(1rem, 2vh, 1.5rem) clamp(1.25rem, 2.5vw, 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .hx-compact-sidebar.is-active {
    visibility: visible;
    pointer-events: auto;
  }

  /* Per-article theme — deliberately NOT a single `data-bg-theme` on the
     `<aside>` anymore. Each `.hx-sidebar-article` carries its OWN
     `data-theme` ("warm"/"dark"), flipped independently by the per-article
     overlap check in the <script> below (real `getBoundingClientRect()`
     overlap against every `.section-theme-dark` section), so two articles
     can legitimately disagree at the same scroll position while a section
     boundary is crossing between them. `--art-text`/`--art-text-muted`/
     `--art-border` are GSAP-tweened (not just CSS-transitioned) — see
     `checkArticleThemes()` — so the ~0.3s color swap is driven the same
     way as every other scroll-linked value in this component. Same warm/
     dark color values as `.section-theme-warm`/`.section-theme-dark` in
     Layout.astro — keep in sync if those ever change. The article's own
     BACKGROUND (from `.hx-glass`) never switches with theme — it stays a
     constant translucent tan so whatever's physically behind it (warm or
     dark section) always bleeds through proportionally; only text/border
     need the discrete legibility swap. */
  .hx-sidebar-article[data-theme="warm"] {
    --art-text: #000;
    --art-text-muted: #000;
    --art-border: var(--color-line);
    --art-divider: #000;
  }

  .hx-sidebar-article[data-theme="dark"] {
    --art-text: #fff;
    --art-text-muted: #fff;
    --art-border: rgb(255 255 255 / 14%);
    --art-divider: #fff;
  }

  /* Four independent articles (brand+description, metrics, nav, socials —
     the last one also contains the Contacto CTA as its final child) — each
     its own `.hx-glass` (see above — the exact ghost-button finish), never
     nested cards inside cards. Border/text color read the per-article
     `--art-*` custom properties above; background stays the constant
     translucent `.hx-glass` tan regardless of theme. Vertical padding/gap
     kept deliberately tight (not the original 1.1rem/0.6rem) so all 4
     articles — the nav one now holding 7 links instead of 6 — fit inside
     `.hx-compact-sidebar`'s capped height without relying on `scale()`;
     see the `@media (max-height: 950px)` tier further down for an even
     tighter pass on short viewports. */
  .hx-sidebar-article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    border-color: var(--art-border, var(--color-line));
    color: var(--art-text, var(--color-ink));
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  /* Brand mark — now the same gold wordmark image used in the hero
     (`hero-wordmark-gold.png`), not a boxed text treatment: the image is
     already gold, so no background/padding/typography is needed anymore.
     `align-self: flex-start` keeps it shrink-wrapped to the image instead
     of stretching to the article's full width (the article is a column
     flexbox with default stretch). `position: relative` gives the small
     (R) mark below a positioning context scoped to just this element. */
  .hx-compact-mark {
    display: inline-flex;
    align-self: flex-start;
    position: relative;
  }

  /* Sized to ~8.25rem max width, intrinsic 2142x815 ratio preserved via
     `height: auto` — never deforms, never upscaled past its own natural
     size on a smaller container thanks to the `min()`. This is also the
     morph TARGET box (`data-morph-target="brand"` lives on this image
     directly, not the surrounding link/article), so its rendered rect is
     exactly the visible wordmark — nothing wider to compensate for. */
  .hx-compact-wordmark-image {
    display: block;
    width: min(8.25rem, 100%);
    height: auto;
    object-fit: contain;
  }

  /* Small, independent (R) mark — visually anchored to the wordmark
     image's top-right corner via absolute positioning (so it never
     inflates `.hx-compact-mark`'s own box, which stays tightly fit to the
     image above). `aria-hidden` since the link's own `aria-label` already
     carries the full accessible name ("CHISU®") for the mark as a whole. */
  .hx-compact-mark-registered {
    position: absolute;
    top: -0.05rem;
    right: -0.7rem;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-brand-gold);
  }

  .hx-compact-tagline {
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--art-text-muted, var(--color-ink));
  }

  /* Two columns, side by side (was a vertical stack of 2 rows) — each
     metric's number sits above its own centered description, with a thin
     divider between the two columns. */
  .hx-compact-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .hx-compact-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
    padding-inline: 0.4rem;
  }

  .hx-compact-metric + .hx-compact-metric {
    border-left: 1px solid var(--art-divider, var(--color-line));
  }

  /* Same brand gold as `.hx-compact-mark`/the Contacto CTA — never yellow,
     never `--art-text`. */
  .hx-compact-metric-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.1;
    color: var(--color-brand-gold);
  }

  /* Contrast fix, warm theme only: an extremely thin black outline on the
     glyph so "2+"/"10+" stay legible when the article is over a light/warm
     section. Same gold fill, same font-size/weight/line-height/box model —
     `-webkit-text-stroke` paints along the glyph outline, it doesn't add
     layout width. Dark theme is untouched (no reset needed — this selector
     simply doesn't match `[data-theme="dark"]`). */
  .hx-sidebar-article[data-theme="warm"] .hx-compact-metric-value {
    -webkit-text-stroke: 0.4px #000;
  }

  .hx-compact-metric-label {
    font-size: 0.72rem;
    line-height: 1.25;
    color: var(--art-text, var(--color-ink));
  }

  .hx-compact-vertical-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Each of the 7 links (Inicio/Sobre mí/Proyectos/Servicios/Tools/
     Contacto/FAQ) is its own rectangular box — light-gray on a warm
     section, dark-gray on a dark one, keyed off the SAME `data-theme`
     attribute the rest of the article already reads (no new detection
     logic, just a new selector on the existing mechanism). Colors here are
     deliberately literal (not `--art-text`) since they're paired 1:1 with
     the matching literal background per the spec. Consistent dimensions/
     padding across all 6 — none of this varies by link. */
  .hx-compact-vertical-nav a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    border-radius: 7px;
    background: #e7e3d9;
    color: #000;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .hx-sidebar-article[data-theme="dark"] .hx-compact-vertical-nav a {
    background: #242424;
    color: #fff;
  }

  .hx-compact-vertical-nav a:hover:not(.is-active) {
    color: var(--color-brand-gold-strong);
  }

  /* Active link: same brand gold as `.hx-compact-mark`/the Contacto CTA.
     Both selectors are needed — the plain one for a warm article, the
     `[data-theme="dark"]`-scoped one to win specificity over the dark box
     rule above — so the active state reads the same (gold bg, black text)
     no matter which theme the article is currently in. */
  .hx-compact-vertical-nav a.is-active,
  .hx-sidebar-article[data-theme="dark"] .hx-compact-vertical-nav a.is-active {
    background: var(--color-brand-gold);
    color: #000;
  }

  .hx-compact-nav-icon {
    flex-shrink: 0;
  }

  .hx-compact-nav-label {
    flex: 1;
  }

  .hx-compact-socials {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--art-text-muted, var(--color-ink));
  }

  .hx-compact-socials a:hover {
    color: var(--color-brand-gold-strong);
    opacity: 1;
  }

  /* Not a link — `aria-disabled`, no `href`, no simulated clickability.
     Only a cursor affordance is added on top of the shared
     `.hx-compact-socials` text color. */
  .hx-compact-social-linkedin {
    cursor: not-allowed;
  }

  /* Overrides `.hx-btn`/`.hx-btn-primary` (shared with the hero's own
     "Ver Proyectos"/"Sobre Mí" buttons, which stay untouched) for this
     instance only — same-specificity single-class selectors, so source
     order (this rule comes later in the stylesheet) is what makes these
     win. Rectangular (not the shared 999px pill), text forced to solid
     black regardless of theme, ≥44px clickable height. Background stays
     inherited from `.hx-btn-primary` (`--color-brand-gold`) — already
     correct, not overridden here. */
  .hx-compact-cta {
    align-self: flex-start;
    margin-top: 0.25rem;
    border-radius: 8px;
    font-size: clamp(1rem, 0.95vw, 1.1rem);
    font-weight: 700;
    color: #000;
    min-height: 44px;
  }

  .hx-mobile-toggle,
  .hx-mobile-nav {
    display: none;
  }

  /* Reduced motion / narrow viewport fallback: stacked static hero, no
     scroll-jacking, no scroll-driven layers. */
  .hx-wrap.hx-static {
    height: auto;
  }

  .hx-pin.hx-static {
    position: relative;
    height: auto;
    min-height: 100svh;
    padding: 5.5rem 1.25rem 2.5rem;
  }

  .hx-pin.hx-static .hx-full-hero-scroll-motion,
  .hx-pin.hx-static .hx-full-hero-intro-motion {
    height: auto;
    transform: none;
  }

  /* The sidebar is no longer a descendant of `.hx-pin` (it's a fixed
     sibling of `.hx-wrap` now), so it can't be reached through that
     ancestor selector — the adjacent-sibling combinator reaches it
     directly off `.hx-wrap.hx-static` instead. `display: none` here (not
     just leaving it at opacity:0/visibility:hidden) is deliberate: in
     reduced-motion/mobile-static mode it must not sit in an inert
     opacity:0 limbo indefinitely. */
  .hx-wrap.hx-static + .hx-compact-sidebar {
    display: none;
  }

  .hx-pin.hx-static .hx-wordmark {
    position: relative;
    inset: auto;
    top: auto;
    left: auto;
    width: 100%;
    margin-bottom: 0.5rem;
  }

  /* On the static/mobile layout the word is allowed to wrap across lines
     instead of forcing a single `nowrap` row that would overflow a narrow
     viewport — the desktop `.hx-wordmark-row` (max-content, nowrap) is
     reset here specifically for that reason. */
  .hx-pin.hx-static .hx-wordmark-row {
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    white-space: normal;
    gap: 0.05em;
  }

  .hx-pin.hx-static .hx-wordmark-letter {
    font-size: clamp(2.4rem, 15vw, 4.5rem);
  }

  .hx-pin.hx-static .hx-nav {
    display: none;
  }

  .hx-pin.hx-static .hx-portrait {
    position: relative;
    left: auto;
    top: auto;
    bottom: auto;
    inset-inline-start: auto;
    inset-block-end: auto;
    transform: none;
    height: 40vh;
    margin: 0 auto;
  }

  .hx-pin.hx-static .hx-foreground {
    position: relative;
    inset: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .hx-pin.hx-static .hx-title-block,
  .hx-pin.hx-static .hx-metrics,
  .hx-pin.hx-static .hx-aside-right,
  .hx-pin.hx-static .hx-actions,
  .hx-pin.hx-static .hx-personal-note {
    position: relative;
    inset: auto;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    transform: none;
  }

  .hx-pin.hx-static .hx-title-block {
    color: var(--color-ink);
    text-shadow: none;
  }

  .hx-pin.hx-static .hx-metrics {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: auto;
  }

  .hx-pin.hx-static .hx-metric-card:nth-child(2) {
    align-self: stretch;
    margin-top: 0;
  }

  .hx-pin.hx-static .hx-aside-right {
    align-items: center;
    max-width: none;
  }

  .hx-pin.hx-static .hx-chip-card {
    width: 100%;
    max-width: 22rem;
  }

  .hx-pin.hx-static .hx-tagline {
    max-width: 32ch;
    text-align: center;
  }

  .hx-pin.hx-static .hx-personal-note {
    max-width: 32ch;
    text-align: center;
  }

  /* Tablet / small-desktop tier: a deliberately different composition, not a
     uniform shrink of the desktop-large layout. */
  @media (min-width: 900px) and (max-width: 1599px) {
    .hx-pin {
      --hx-wordmark-top: 3.2vh;
      --hx-aside-inset: clamp(1.25rem, 5vw, 3rem);
    }

    .hx-title-block {
      top: calc(40% + clamp(2.9rem, 6.5svh, 3.75rem));
      font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    }

    .hx-title-line:not(.hx-title-highlight) {
      font-size: clamp(1.51rem, 2.78vw, 2.2rem);
    }

    .hx-title-highlight mark {
      font-size: clamp(1.61rem, 2.98vw, 2.36rem);
    }

    .hx-metrics {
      width: clamp(8rem, 14vw, 10rem);
    }

    .hx-chip-card {
      padding: 0.85rem 1rem;
    }

    /* Portrait: intermediate "torso/waist up" crop for tablet — bigger
       than the mobile/base full-body figure, smaller than the >=1600px
       desktop tier below. Anchored by `top` instead of the base rule's
       `inset-block-end: 0`, with `height` deliberately taller than the
       visible span so the excess (the legs/feet) runs past `.hx-pin`'s
       own bottom edge and gets cut off by its EXISTING `overflow: clip`
       (see `.hx-pin` above) — no `transform: scale`, no new clipping
       mechanism. Estimated crop ratio (the image isn't measured, so this
       is reasoned from the reference screenshot, not exact) — nudge the
       `height` value if the real photo's waist line sits higher/lower
       than expected once you see it live. Base (<900px) rule is
       untouched, so mobile stays full-body exactly as before. */
    .hx-portrait {
      top: clamp(0.5rem, 2svh, 1.5rem);
      inset-block-end: auto;
      height: min(140svh, 1250px);
    }
  }

  /* Laptop tier — between the tablet composition above and the
     large-desktop default clamp() baked into `.hx-pin` (used at
     >=1920px). The JS auto-fit pass (`fitWordmarkWidth()`) recalculates
     the exact px value on load/resize regardless, but every tier still
     gets its own explicit starting point rather than relying on one
     clamp() to cover both 1600px and 3000px viewports. */
  /* Desktop portrait tier — reuses the same 1600px threshold as the
     laptop wordmark tier above (open-ended, so it also covers >=1920px
     ultra-wide, unlike that tier's own 1919px cap) rather than inventing
     a new breakpoint. Same top-anchor + oversized-height + existing-clip
     technique as the tablet tier, just a bigger `height` for more
     presence — "retrato protagonista" per the reference. */
  @media (min-width: 1600px) {
    .hx-portrait {
      top: clamp(0.5rem, 2svh, 1.5rem);
      inset-block-end: auto;
      height: min(195svh, 1700px);
    }

    .hx-title-line:not(.hx-title-highlight) {
      font-size: clamp(2.38rem, 4.76vw, 4.13rem);
    }

    .hx-title-highlight mark {
      font-size: clamp(2.54rem, 5.08vw, 4.41rem);
    }
  }

  /* Extra compaction pass for short-but-still-desktop viewports (e.g.
     1917x906) — the base sizing above already fits comfortably on tall
     desktop screens; this tier only tightens further so the 4 articles
     (7-link nav included) have a realistic chance of fitting without the
     `overflow-y: auto` fallback ever engaging. That fallback (see
     `.hx-compact-sidebar` above) stays in place regardless, as protection
     for anything shorter than this still covers. */
  @media (max-height: 950px) and (min-width: 900px) {
    .hx-compact-sidebar {
      padding-block: clamp(0.65rem, 1.4vh, 1rem);
      gap: clamp(0.35rem, 0.7vh, 0.5rem);
    }

    .hx-sidebar-article {
      padding-block: 0.65rem;
      gap: 0.45rem;
    }

    .hx-compact-vertical-nav {
      gap: 0.3rem;
    }

    .hx-compact-tagline {
      line-height: 1.3;
    }
  }

  /* Second, more aggressive compaction tier for genuinely short desktop
     viewports (e.g. 1280x720), where the 950px tier above still leaves
     the sidebar taller than its `max-height` (measured in a real browser:
     clientHeight 696px vs scrollHeight 825px at 1280x720, ~129px of
     overflow relying on the `overflow-y: auto` fallback). Scoped to
     `max-height: 850px` so it never applies at 1917x906 or 1440x900 —
     both stay on the 950px tier above, completely unchanged. Every value
     here uses `padding-block`/`gap` (never the `padding` shorthand), so
     horizontal padding, width, and horizontal position are untouched;
     font-size, colors, border-radius, icons and the `.is-active` state
     are untouched too — only vertical rhythm changes. `overflow-y: auto`
     on `.hx-compact-sidebar` stays in place as a safety fallback; this
     tier's job is to make it stop being needed at these sizes, not to
     hide overflow. */
  @media (min-width: 900px) and (max-height: 850px) {
    .hx-compact-sidebar {
      padding-block: 0.4rem;
      gap: 0.2rem;
    }

    .hx-sidebar-article {
      padding-block: 0.35rem;
      gap: 0.25rem;
    }

    .hx-compact-vertical-nav {
      gap: 0.16rem;
    }

    .hx-compact-vertical-nav a {
      min-height: 36px;
      padding-block: 0.3rem;
    }

    .hx-compact-socials {
      gap: 0.25rem;
    }

    .hx-compact-cta {
      min-height: 42px;
      padding-block: 0.4rem;
      margin-top: 0.125rem;
    }
  }

  /* Desktop/tablet-only static composition pass: shares the metrics'
     horizontal band with the left nav, the traits card's band with the
     right nav, and keeps the tagline + new personal note anchored at the
     bottom (mirroring `.hx-actions`' own bottom clamp). Scoped to
     `min-width: 900px` — the site's existing desktop threshold — so the
     `max-width: 899px` mobile tier below (nav hidden, `.hx-mobile-nav`
     used instead) is completely untouched. `--hx-metrics-offset` /
     `--hx-traits-offset` (see below) are reasoned estimates of each nav
     group's rendered width (fixed text, `white-space: nowrap`, near-
     constant `~0.92-1.05rem` font-size) rather than per-viewport magic
     numbers — nudge either one independently if a real browser shows too
     much or too little clearance next to "Contacto" / "Tools". */
  @media (min-width: 900px) {
    .hx-pin {
      /* Two INDEPENDENT offsets, not one shared constant — the two nav
         groups ("INICIO · SOBRE MÍ · CONTACTO" vs "PROYECTOS · SERVICIOS
         · TOOLS") aren't the same rendered width, and `.hx-metrics` isn't
         the same width as `.hx-chip-card`, so a single shared value could
         never center both badges in their own free space at once — that
         was the previous bug (both badges pushed to the SAME distance
         from their nav, which read as "too close to center" once the
         title grew). Each one is still a flat rem estimate (nav text is
         fixed-width, doesn't scale with `vw` — see the previous fix),
         calibrated against the visual reference you gave (~107px left /
         ~70px right at ~1918px) rather than a from-scratch glyph-width
         guess, since that's the more reliable signal without a live
         browser. Nudge either value independently if it's still off. */
      --hx-metrics-offset: 22.625rem;
      --hx-traits-offset: 23.125rem;
    }

    .hx-metrics {
      top: var(--hx-nav-top);
      /* Anchored off `.hx-nav-left`'s own `left: clamp(1.5rem, 4vw,
         2.8vw)` (not `--hx-aside-inset`, a different/unrelated clamp) so
         the gap to the nav stays consistent across viewport widths. */
      left: calc(clamp(1.5rem, 4vw, 2.8vw) + var(--hx-metrics-offset));
    }

    .hx-personal-note {
      position: absolute;
      left: var(--hx-aside-inset);
      bottom: clamp(2.25rem, 6.5vh, 3.75rem);
      z-index: 4;
      max-width: 32ch;
      text-align: left;
      /* Was 0.86rem. */
      font-size: 0.95rem;
      line-height: 1.55;
      color: rgba(248, 240, 220, 0.82);
    }

    /* `.hx-tagline`'s own base font-size (0.86rem, further down this
       file) stays untouched — it's unscoped and also used by the mobile
       `.hx-static` fallback. This override only applies >=900px, so
       mobile keeps its current size. */
    .hx-tagline {
      font-size: 0.95rem;
    }

    /* `.hx-aside-right` still wraps the chip card + tagline as one unit
       (unchanged DOM, unchanged GSAP entrance target — still has a real
       box/height for the entrance timeline to animate) and still spans
       from the nav row down to the actions' bottom clamp. Its own `right`
       is now flush with `.hx-nav-right`'s own inset — that's `.hx-tagline`'s
       target edge, not the traits card's. `.hx-chip-card` gets pulled out
       to its own independent horizontal anchor below instead of sharing
       this container's `align-items: flex-end` edge, which is what was
       dragging the tagline along with it whenever the traits offset
       changed. `justify-content: flex-end` (was `space-between`) because
       `.hx-tagline` is now the only in-flow flex child — this pins it to
       the bottom of the span, its original visual position. */
    .hx-aside-right {
      top: var(--hx-nav-top);
      bottom: clamp(2.25rem, 6.5vh, 3.75rem);
      right: clamp(1.5rem, 4vw, 2.8vw);
      justify-content: flex-end;
    }

    /* Independent anchor, relative to `.hx-aside-right`'s own box (still
       `position: absolute`, so this doesn't escape it) — a fixed offset
       from the container's (=nav-right's) edge, same value/role as
       `--hx-metrics-offset` on the left. Taking this out of the flex flow
       (rather than `align-self`) sidesteps the container auto-width vs.
       `max-width: 18rem` conflict a large `margin-right` would have hit. */
    .hx-chip-card {
      position: absolute;
      top: 0;
      right: var(--hx-traits-offset);
    }
  }

  /* Small-tablet portrait, 641-899px.
  /* Narrow-desktop collision fix (e.g. 1280x720, 1366x768): at this width
     the metrics card's left edge and the traits card's right edge start
     overlapping the title (measured empirically via a Playwright
     reproduction of this exact CSS, since `astro dev`/`build` can't run in
     this environment -- real-browser confirmation still needed). Two
     independent levers, both scoped to ONLY this tier:
     1) `--hx-metrics-offset`/`--hx-traits-offset` are pulled in from their
        >=900px values using a `clamp()` whose middle `vw` term is a linear
        fit between two calibrated endpoints -- the maximum safe shift at
        1280px (leaves a small but real clearance from the nav text; a flat
        constant was tested and found to collide with the nav from ~1320px
        up, since the nav's own rendered width keeps growing with vw while
        a flat offset doesn't -- hence the taper) and a much smaller shift
        at 1399px (the collision is far milder there, so less correction is
        both sufficient and keeps a wide nav margin). Below 1280px the
        `clamp()` floors to the 1280px value -- still safe (verified, nav
        margin stays flat ~4px/~31px down to 900px) but the base collision
        there is severe enough (up to -173px measured at 900px) that it
        isn't fully eliminated -- out of scope, since only 1280x720 and
        1366x768 were specified as target viewports.
     2) A small additional font-size reduction (~6.5%, applied identically
        to both non-highlighted lines and the `Data Science` mark, so the
        highlighted line stays visually dominant per the existing
        hierarchy) on top of this tier's own existing sizing further down
        -- needed because the card-shift lever alone caps out a few px
        short of the requested minimum on the tighter (left) side.
     Together: leftGap/rightGap measured (Playwright, fallback system font
     since the real "Inter Tight"/"Inter" webfonts aren't reachable from
     this environment) at 16.3px/19.5px at 1280x720 and ~19px/~35px at
     1366x768, both with a positive (non-colliding) nav margin throughout
     1280-1399px. 1440x900 and 1918x907 fall outside `max-width: 1399px`
     and are untouched.
     NOTE ON PLACEMENT: this tier must stay positioned AFTER the general
     `@media (min-width: 900px)` offsets block above (not before, where it
     originally was) -- both set `--hx-metrics-offset`/`--hx-traits-offset`
     on the same `.hx-pin` selector (identical specificity), and both
     media queries match at 900-1399px widths, so without this ordering
     the general block's later `22.625rem`/`23.125rem` values would win
     the cascade tie and silently cancel this fix's offsets. Verified via
     Playwright: before this reordering, computed
     `--hx-metrics-offset`/`--hx-traits-offset` at 1280px resolved to
     `22.625rem`/`23.125rem` (the un-corrected values) despite this block
     being present; after moving it here, they correctly resolve to the
     clamp()-tapered values. */
  @media (min-width: 900px) and (max-width: 1399px) {
    .hx-pin {
      --hx-metrics-offset: clamp(17.875rem, calc(-276.598px + 43.9529vw), 21.144rem);
      --hx-traits-offset: clamp(21rem, calc(-29.714px + 28.5714vw), 23.125rem);
    }

    .hx-title-line:not(.hx-title-highlight) {
      font-size: clamp(1.412rem, 2.599vw, 2.057rem);
    }

    .hx-title-highlight mark {
      font-size: clamp(1.505rem, 2.786vw, 2.207rem);
    }
  }
 CORRECTED: real-browser measurement
     at 768x1024 (Ctrl+R reload, no reduced-motion) showed `.hx-static`
     is NOT active on normal load in this range — `tabletRule: true`,
     `staticMode: false`, `.hx-portrait` still `position: absolute`,
     height 860px = the UNSCOPED base rule's `min(92svh, 860px)`. The
     previous version of this block only targeted `.hx-pin.hx-static
     .hx-portrait`, which is why it had no visible effect. Two separate,
     clearly-labeled rules now: NORMAL load uses `.hx-pin:not(.hx-static)`
     (below), matching the same top-anchor + oversized-height + existing
     `.hx-pin` `overflow: clip` technique already used at >=900px — same
     `position: absolute` and `transform: translateX(-50%)` centering
     from the base rule, untouched. `.hx-static` (the `prefers-reduced-
     motion` fallback — still reachable in this width range via that
     media feature, just not on a normal load) keeps its own separate
     rules further below as a real, working fallback, not repurposed. */
  @media (min-width: 641px) and (max-width: 899px) {
    .hx-pin {
      --hx-wordmark-height: min(26svh, 32vw, 14rem);
    }

    .hx-pin:not(.hx-static) .hx-portrait {
      top: clamp(0.5rem, 2svh, 1.5rem);
      inset-block-end: auto;
      height: min(185svh, 1900px);
    }

    /* `prefers-reduced-motion` fallback only — NOT what a normal load
       uses in this range (see diagnosis above). Kept as a working
       fallback since `.hx-static`'s own architecture (wrapper height
       fixed at 40vh, flex-centered, `transform: none`) is fully separate
       from the normal/absolute-positioned rule above. */
    .hx-pin.hx-static .hx-portrait {
      overflow: clip;
    }

    .hx-pin.hx-static .hx-portrait img {
      height: 185%;
      width: auto;
      display: block;
      margin-inline: auto;
      object-position: 50% 0%;
    }
  }

  @media (max-width: 899px) {
    .hx-nav,
    .hx-compact-sidebar {
      display: none;
    }

    .hx-mobile-toggle {
      display: grid;
      place-content: center;
      gap: 4px;
      position: fixed;
      right: 1rem;
      top: 1rem;
      z-index: 110;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      border: 1px solid var(--color-line);
      background: rgb(213 207 190 / 70%);
      backdrop-filter: blur(8px);
    }

    .hx-mobile-toggle span {
      width: 18px;
      height: 2px;
      background: var(--color-ink);
    }

    /* Hamburger -> X, computed from the bars' own dimensions right above
       (18px wide, 2px tall, 4px gap between each): the middle bar's
       center sits exactly `height + gap` = 6px below the first bar's
       center and 6px above the third's, so translateY(6px)/translateY(-6px)
       lands the outer two bars exactly on the middle bar's line before
       rotating -- not an arbitrary guessed offset. */
    .hx-mobile-toggle.hx-open span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .hx-mobile-toggle.hx-open span:nth-child(2) {
      opacity: 0;
    }

    .hx-mobile-toggle.hx-open span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }

    /* Closed state: kept in `display: flex` (never `display: none`) so the
       open/close transition below can actually animate -- visibility +
       opacity + pointer-events is the toggle mechanism instead. The
       unscoped `.hx-mobile-toggle, .hx-mobile-nav { display: none; }`
       base rule (further up this file, outside any media query) still
       hides both completely at >=900px, untouched. */
    .hx-mobile-nav {
      position: fixed;
      inset: 0;
      z-index: 105;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: clamp(1rem, 4svh, 1.75rem);
      padding: 2rem 1.5rem;
      /* Was rgb(213 207 190 / 96%) -- pushed closer to opaque so the busy
         Hero content behind it never distracts through the panel. */
      background: rgb(213 207 190 / 98%);
      backdrop-filter: blur(14px);
      font-family: var(--font-body);
      color: var(--color-ink);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
    }

    .hx-mobile-nav.hx-open {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }

    .hx-mobile-nav a {
      width: 100%;
      max-width: 22rem;
      min-height: clamp(52px, 8svh, 60px);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-family: var(--font-title);
      font-weight: 700;
      /* Was a flat 1.2rem/600 on the old container-level rule. */
      font-size: clamp(1.5rem, 6svh, 2.2rem);
      color: var(--color-ink);
      /* Thin separators between links instead of individual cards --
         first link has none, so the stack reads as one sober list, not a
         set of boxes. */
      border-top: 1px solid var(--color-line);
    }

    .hx-mobile-nav a:first-child {
      border-top: none;
    }

    .hx-mobile-nav a:hover {
      color: var(--color-brand-gold);
    }

    .hx-mobile-nav a:focus-visible {
      outline: 2px solid var(--color-brand-gold);
      outline-offset: 4px;
      border-radius: 4px;
    }
  }

  /* Motion (fade + slight rise + stagger) is opt-in behind `no-preference`
     only -- under `prefers-reduced-motion: reduce` none of these
     `transition`/opacity-offset declarations apply at all, so the panel,
     links and toggle bars simply snap between their open/closed end
     states instantly (those end states -- the X shape, visible links --
     are unconditional above, since they're the actual UI state, not the
     animation). Nothing extra to strip out under `reduce`. */
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .hx-mobile-toggle span {
      transition: transform 220ms ease, opacity 220ms ease;
    }

    .hx-mobile-nav {
      transition: opacity 220ms ease, visibility 220ms ease;
    }

    .hx-mobile-nav a {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 220ms ease, transform 220ms ease, color 180ms ease;
    }

    .hx-mobile-nav.hx-open a {
      opacity: 1;
      transform: translateY(0);
    }

    .hx-mobile-nav.hx-open a:nth-child(1) {
      transition-delay: 40ms;
    }

    .hx-mobile-nav.hx-open a:nth-child(2) {
      transition-delay: 80ms;
    }

    .hx-mobile-nav.hx-open a:nth-child(3) {
      transition-delay: 120ms;
    }

    .hx-mobile-nav.hx-open a:nth-child(4) {
      transition-delay: 160ms;
    }

    .hx-mobile-nav.hx-open a:nth-child(5) {
      transition-delay: 200ms;
    }

    .hx-mobile-nav.hx-open a:nth-child(6) {
      transition-delay: 240ms;
    }
  }

  /* Scroll lock: applied globally to <html>/<body> (outside this
     component's own scoped style, hence `:global`) while the mobile menu
     is open. Toggled from the <script> below via a plain class -- no
     `position: fixed` on body, no manual scrollY math, no ScrollTrigger
     involvement (it isn't even active below 900px -- see
     `isDesktopViewport()`/`evaluateMode()` further down). */
  :global(html.hx-mobile-nav-open),
  :global(body.hx-mobile-nav-open) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* Mobile Hero fix, up to 640px. CSS-only, scoped entirely to this media
     query -- does not touch HTML, <script>, GSAP/ScrollTrigger, .hx-wrap,
     .hx-pin, the mobile nav/toggle, the 641-899px tier, or the >=900px
     tier. .hx-portrait / .hx-portrait img and the side-card horizontal
     distribution (.hx-metrics, .hx-chip-card) are intentionally left
     untouched per explicit approval -- only the vertical architecture of
     .hx-aside-right (chip-card vs tagline) changes here.

     "First configuration" per real measurements supplied from 390x844
     (post-animation-settle), targeting the 5 reported collisions:
     "Software Engineer" x 2nd metric card, "Software Engineer" x
     tagline, "Data Science" x tagline, personal note x wordmark, and
     mobile toggle x wordmark. Starting values to visually validate, not
     guaranteed-final. */
  @media (max-width: 640px) {
    .hx-pin {
      --hx-wordmark-height: min(18svh, 30vw, 8rem);
    }

    .hx-wordmark {
      /* Was --hx-wordmark-top (4vh, ~34px at 844px tall) -- pushed down
         so its top clears the mobile toggle's own bottom edge (~60px).
         Centering (justify-content: center on the base rule) and all
         type/color/z-index untouched. */
      top: 4rem;
    }

    .hx-title-block {
      /* Was top: 44% -- moved down so it starts below the metrics/traits
         cards instead of overlapping them. Horizontal centering
         (left: var(--hx-figure-x) + transform: translateX(-50%)) is the
         base rule's existing mechanism and is left untouched here. */
      top: 51%;
      /* Base rule has no explicit width (shrink-to-fit); bounding it lets
         the title wrap onto its existing multi-line structure instead of
         overflowing the 390px viewport. */
      width: calc(100% - 2rem);
      max-width: 22rem;
      /* Was clamp(2.05rem, 4.1vw, 3.56rem) -- shrunk for this width so
         "Software Engineer" fits on one line at max-width without
         wrapping mid-word. font-family/weight/color/stroke/paint-order/
         line-height/highlight all untouched. */
      font-size: clamp(1.7rem, 7.2vw, 2rem);
    }

    .hx-title-line {
      white-space: nowrap;
    }

    /* .hx-chip-card (traits) is intentionally NOT overridden here -- its
       position stays governed by the base/unscoped .hx-aside-right flex
       flow, per explicit approval. Only the container is stretched
       downward so `justify-content: space-between` can push .hx-tagline
       (the second flex child) toward the container's own bottom edge,
       away from the traits card and clear of the title above it, without
       moving .hx-chip-card. */
    .hx-aside-right {
      bottom: 20vh;
      justify-content: space-between;
      /* Widen the container so it spans symmetrically between the same
         inset used on the right (--hx-aside-inset) mirrored on the left,
         centering the container itself on the viewport's horizontal
         center. max-width: none prevents the existing 18rem cap from
         forcing the box back to a smaller width, which would otherwise
         shift `right` (and with it .hx-chip-card's anchored edge) via
         the browser's absolute-positioning over-constraint resolution.
         .hx-chip-card is untouched: align-items: flex-end (unchanged,
         inherited from the base rule) keeps it flush with the
         container's right edge, which stays at the same `right` inset
         as before -- so its position is unaffected by this change. */
      left: var(--hx-aside-inset);
      max-width: none;
    }

    /* Only .hx-tagline is pulled out of the flex-end alignment inherited
       from .hx-aside-right; align-self: center centers its own box
       within the now-wider container (which is itself centered on the
       viewport), and text-align: center centers its line(s) inside that
       box. Width/max-width (20ch), font-size, line-height, color, and
       opacity are all untouched -- only the box's horizontal position
       and its internal text alignment change. */
    .hx-tagline {
      align-self: center;
      text-align: center;
    }

    .hx-actions {
      /* Was bottom: clamp(2.25rem, 6.5vh, 3.75rem) -- raised slightly to
         clear the personal note below it. */
      bottom: 4.75rem;
      /* Was gap: 1rem. */
      gap: 0.75rem;
      /* Was flex-wrap: wrap, which is why the two buttons were stacking
         vertically at this width; forced onto a single row instead.
         Button design/height/colors/text/links/hover/focus untouched. */
      flex-wrap: nowrap;
    }

    .hx-personal-note {
      /* No unscoped base rule exists for this selector at all below
         900px (confirmed by direct read of the source) -- it was
         rendering in normal document flow at the very top of the Hero,
         colliding with the wordmark. Given an explicit position here,
         plus the same font-size/line-height/color/opacity already used
         by the >=900px rule, so it reads exactly like the desktop/tablet
         copy instead of unstyled browser-default text. Centered via
         inset-inline + margin-inline: auto (not transform), per spec. */
      position: absolute;
      inset-inline: 0;
      bottom: 0.5rem;
      z-index: 4;
      width: calc(100% - 2rem);
      max-width: 22rem;
      margin-inline: auto;
      text-align: center;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--color-ink);
      opacity: 0.7;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Bundled with the `gsap` package already installed via `npm install` —
  // not an additional dependency.
  gsap.registerPlugin(ScrollTrigger);

  const wrap = document.querySelector<HTMLElement>(".hx-wrap");
  const pin = document.getElementById("hx-pin");
  const scrollMotion = document.getElementById("hx-scroll-motion");
  const introMotion = document.getElementById("hx-intro-motion");
  const wordmark = document.getElementById("hx-wordmark");
  const compactSidebar = document.getElementById("hx-compact-sidebar");

  const mobileToggle = document.getElementById("hx-mobile-toggle");
  const mobileNav = document.getElementById("hx-mobile-nav");
  const mobileLinks = mobileNav ? Array.from(mobileNav.querySelectorAll("a")) : [];

  const MOBILE_MENU_QUERY = "(max-width: 899px)";
  const SCROLL_LOCK_CLASS = "hx-mobile-nav-open";
  const TOGGLE_OPEN_LABEL = "Cerrar menú";
  const TOGGLE_CLOSED_LABEL = "Abrir menú";
  const mobileMenuMediaQuery = window.matchMedia(MOBILE_MENU_QUERY);

  // .hx-wrap and main.home-main (see src/pages/index.astro) are the only
  // two top-level siblings that make up the rest of the page around the
  // toggle/panel -- the toggle and panel are never inside either one, so
  // they can never end up inert themselves here.
  const backgroundInertTargets = [".hx-wrap", "main.home-main"]
    .map((selector) => document.querySelector(selector))
    .filter((el): el is HTMLElement => el !== null);
  const backgroundInertPriorState = new Map<HTMLElement, boolean>();
  let lastFocusedBeforeOpen: Element | null = null;

  function lockBackgroundScroll() {
    document.documentElement.classList.add(SCROLL_LOCK_CLASS);
    document.body.classList.add(SCROLL_LOCK_CLASS);
  }

  function unlockBackgroundScroll() {
    document.documentElement.classList.remove(SCROLL_LOCK_CLASS);
    document.body.classList.remove(SCROLL_LOCK_CLASS);
  }

  function setBackgroundInert(makeInert: boolean) {
    backgroundInertTargets.forEach((el) => {
      if (makeInert) {
        backgroundInertPriorState.set(el, el.hasAttribute("inert"));
        el.setAttribute("inert", "");
      } else {
        const hadInertBefore = backgroundInertPriorState.get(el) ?? false;
        if (!hadInertBefore) {
          el.removeAttribute("inert");
        }
        backgroundInertPriorState.delete(el);
      }
    });
  }

  function getMenuFocusOrder(): HTMLElement[] {
    return mobileToggle ? [mobileToggle, ...mobileLinks] : mobileLinks;
  }

  // Only attached while the panel is actually open (see openMobileMenu /
  // closeMobileMenu below) -- not a permanent document-wide listener.
  function handleMenuKeydown(event: KeyboardEvent) {
    if (!mobileNav?.classList.contains("hx-open")) return;

    if (event.key === "Escape") {
      event.preventDefault();
      closeMobileMenu({ returnFocus: true });
      return;
    }

    if (event.key !== "Tab") return;

    const order = getMenuFocusOrder();
    if (!order.length) return;
    const first = order[0];
    const last = order[order.length - 1];

    // Only the two true wrap-around edges need an explicit intercept
    // (Tab forward off the last link back to the toggle, Shift+Tab back
    // off the toggle to the last link) -- Tab forward from the toggle and
    // Shift+Tab back from the first link already land correctly on their
    // own, since the toggle and the first link are DOM-adjacent siblings.
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  // Clicking the panel's own empty background (not a link) closes it --
  // `event.target` is the <nav> itself only when the click didn't land on
  // a descendant link.
  function handleOverlayClick(event: MouseEvent) {
    if (event.target === mobileNav) {
      closeMobileMenu({ returnFocus: true });
    }
  }

  function openMobileMenu() {
    if (!mobileToggle || !mobileNav) return;
    if (!mobileMenuMediaQuery.matches) return;
    if (mobileNav.classList.contains("hx-open")) return;

    lastFocusedBeforeOpen = document.activeElement;

    mobileNav.removeAttribute("inert");
    mobileNav.setAttribute("aria-hidden", "false");
    mobileNav.classList.add("hx-open");
    mobileToggle.classList.add("hx-open");
    mobileToggle.setAttribute("aria-expanded", "true");
    mobileToggle.setAttribute("aria-label", TOGGLE_OPEN_LABEL);

    lockBackgroundScroll();
    setBackgroundInert(true);

    document.addEventListener("keydown", handleMenuKeydown);
    mobileNav.addEventListener("click", handleOverlayClick);

    const firstLink = mobileLinks[0];
    if (firstLink) {
      requestAnimationFrame(() => {
        firstLink.focus();
      });
    }
  }

  function closeMobileMenu(options?: { returnFocus?: boolean }) {
    const returnFocus = options?.returnFocus === true;
    if (!mobileToggle || !mobileNav) return;
    if (!mobileNav.classList.contains("hx-open")) return;

    // Move focus out of the panel BEFORE aria-hidden/inert are (re)applied
    // -- hiding/inert-ing a subtree that still contains the active focus
    // triggers a browser console warning and can strand keyboard focus.
    if (document.activeElement instanceof HTMLElement && mobileNav.contains(document.activeElement)) {
      document.activeElement.blur();
    }

    mobileNav.classList.remove("hx-open");
    mobileToggle.classList.remove("hx-open");
    mobileToggle.setAttribute("aria-expanded", "false");
    mobileToggle.setAttribute("aria-label", TOGGLE_CLOSED_LABEL);
    mobileNav.setAttribute("aria-hidden", "true");
    mobileNav.setAttribute("inert", "");

    unlockBackgroundScroll();
    setBackgroundInert(false);

    document.removeEventListener("keydown", handleMenuKeydown);
    mobileNav.removeEventListener("click", handleOverlayClick);

    if (returnFocus) {
      mobileToggle.focus();
    }
    lastFocusedBeforeOpen = null;
  }

  function toggleMobileMenu() {
    if (mobileNav?.classList.contains("hx-open")) {
      closeMobileMenu({ returnFocus: true });
    } else {
      openMobileMenu();
    }
  }

  mobileToggle?.addEventListener("click", () => {
    toggleMobileMenu();
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      // Anchor navigation is never prevented here -- the link's default
      // action (jumping to its #hash target) proceeds exactly as before;
      // this only resets the menu's own open state alongside it.
      closeMobileMenu({ returnFocus: false });
    });
  });

  const handleMobileMenuViewportChange = (event: MediaQueryListEvent) => {
    if (event.matches) return; // still <900px, nothing to clean up
    if (!mobileNav?.classList.contains("hx-open")) return;
    // The toggle itself is `display: none` at this width (the unscoped
    // >=900px base rule), so it's never a valid focus target here --
    // close without trying to move focus onto it.
    closeMobileMenu({ returnFocus: false });
  };
  mobileMenuMediaQuery.addEventListener("change", handleMobileMenuViewportChange);

  const prefersReducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  let prefersReducedMotion = prefersReducedMotionQuery.matches;

  // Progressive enhancement: if any of the scroll-driven pieces are
  // missing, the static markup (and the `.hx-static` CSS fallback) still
  // renders/functions without JS ever having run.
  if (wrap && pin && scrollMotion && introMotion && wordmark && compactSidebar) {
    const wrapEl: HTMLElement = wrap;
    const pinEl: HTMLElement = pin;
    // `scrollMotion` itself is intentionally left unassigned to a local
    // beyond the existence check above — `.hx-full-hero-scroll-motion` stays
    // in the DOM as a positioning/responsibility boundary (see the <style>
    // comment on `.hx-full-hero-scroll-motion`), but the scroll timeline no
    // longer transforms it as a unit, so there's nothing left to read it for.
    const introMotionEl: HTMLElement = introMotion;
    const wordmarkEl: HTMLElement = wordmark;
    const compactSidebarEl: HTMLElement = compactSidebar;

    const isDesktopViewport = () => window.innerWidth >= 900;

    // Every GSAP tween/ScrollTrigger created synchronously here — and every
    // one created later inside a `ctx.add(() => ...)` call — is tracked by
    // this context, so `ctx.revert()` fully tears the hero's animation
    // state back down (used on Astro view-transition navigation away from
    // the page, if that's ever enabled).
    const ctx = gsap.context(() => {
      // ---- Wordmark auto-fit ------------------------------------------
      // Adjusts `--hx-wordmark-font-size` (already read by every layout
      // calc() below it) so `CHISU`, laid out as one compact, centered,
      // non-stretched word, renders at ~94% of the viewport width instead
      // of relying on a guessed clamp() value alone. Also capped by a
      // HEIGHT budget: with only 5 letters (vs. the previous 8-letter
      // "CHIISSUU") filling the same width target, each glyph is much
      // bigger, and at wide-but-short viewports (e.g. 1901x902) a purely
      // width-driven size can grow tall enough to clip against
      // `.hx-pin`'s `overflow: clip` — the height cap trades a little
      // width for guaranteed "sin recortarse accidentalmente".
      //
      // Measures `.hx-wordmark-row` (the actual word, `width: max-content`
      // so it always reports its true shrink-to-fit content width) — NOT
      // `.hx-wordmark` (the outer positioning shell, which spans the full
      // viewport width via `inset-inline: 0` and would report ~100vw
      // regardless of the letters' real size, making the ratio below
      // meaningless). Font-size is read off an actual letter span, since
      // `.hx-wordmark`/`.hx-wordmark-row` never set `font-size`
      // themselves — only `.hx-wordmark-letter` does.
      function fitWordmarkWidth() {
        const targetWidth = window.innerWidth * 0.94;
        pinEl.style.removeProperty("--hx-wordmark-font-size");
        const rowEl = wordmarkEl.querySelector<HTMLElement>(".hx-wordmark-row");
        const firstLetter = wordmarkEl.querySelector<HTMLElement>(".hx-wordmark-letter");
        if (!rowEl || !firstLetter) return;
        const naturalWidth = rowEl.getBoundingClientRect().width;
        if (naturalWidth <= 0) return;
        const currentFontSize = parseFloat(getComputedStyle(firstLetter).fontSize);
        if (!Number.isFinite(currentFontSize) || currentFontSize <= 0) return;
        const widthFitted = currentFontSize * (targetWidth / naturalWidth);
        const lineHeight = parseFloat(getComputedStyle(pinEl).getPropertyValue("--hx-wordmark-line-height")) || 0.86;
        // The wordmark may use at most ~40% of the viewport height, leaving
        // room below it (via --hx-nav-top's calc() chain) for nav/metrics/
        // portrait/title.
        const heightBudget = window.innerHeight * 0.4;
        const heightCapped = heightBudget / lineHeight;
        const fitted = Math.min(widthFitted, heightCapped);
        pinEl.style.setProperty("--hx-wordmark-font-size", `${fitted.toFixed(2)}px`);
      }

      // ---- Entrance timeline (intro-motion elements only) --------------
      // Order preserved from the original spec: 1) letters in from the
      // right with a blur(10px)->0 wipe, 2) portrait rising from below,
      // 3) title lines revealed through a mask, 4) nav / cards / buttons
      // settling in last.
      // ---- Entrance / scroll-timeline handoff state --------------------
      // `playEntrance()` and `bootScrollTimeline()` are two independent
      // async chains that both eventually touch the same intro-motion
      // elements. Without an explicit handoff, a fast scroll right after
      // F5 could let `buildScrollTimeline()` (built by
      // `bootScrollTimeline()`) start writing scroll-driven
      // `opacity`/`transform` on those elements before the entrance's own
      // completion has cleared its OWN inline styles off them -- whichever
      // one runs last silently undoes the other, leaving
      // portrait/actions/personalNote stuck at full opacity over
      // `AboutSection`. `entranceSettled` is the single gate:
      // `bootScrollTimeline()` never constructs the scroll timeline until
      // this resolves, and it only ever resolves AFTER the entrance has
      // genuinely finished writing to the DOM -- whether by playing out
      // naturally, being skipped before it ever built a timeline, or being
      // interrupted mid-play.
      type EntranceState = "pending" | "playing" | "completed" | "interrupted";
      let entranceState: EntranceState = "pending";
      let entranceTl: gsap.core.Timeline | null = null;
      let entranceAllTargets: HTMLElement[] = [];
      let entranceSkipRequested = false;
      let entranceDisposed = false;
      let resolveEntranceSettled: (() => void) | null = null;
      const entranceSettled: Promise<void> = new Promise((resolve) => {
        resolveEntranceSettled = resolve;
      });

      // Active only while still awaiting fonts/decode -- i.e. before the
      // entrance has decided whether to play or skip. Records INTENT only:
      // never touches GSAP, never resolves `entranceSettled`, never moves
      // `entranceState` to a terminal value.
      function handleAwaitSkipRequest() {
        if (window.scrollY <= 0) return; // ignore non-movement/synthetic events
        entranceSkipRequested = true;
        window.removeEventListener("scroll", handleAwaitSkipRequest);
      }
      function attachAwaitSkipListener() {
        window.addEventListener("scroll", handleAwaitSkipRequest, { passive: true });
      }
      function detachAwaitSkipListener() {
        window.removeEventListener("scroll", handleAwaitSkipRequest);
      }

      // Active only while the entrance timeline is the current owner
      // (`entranceState === "playing"`).
      function handlePlayingInterrupt() {
        if (window.scrollY <= 0) return;
        finishPlayingEntrance("interrupted");
      }
      function attachPlayingInterruptListener() {
        window.addEventListener("scroll", handlePlayingInterrupt, { passive: true });
      }
      function detachPlayingInterruptListener() {
        window.removeEventListener("scroll", handlePlayingInterrupt);
      }

      // The single idempotent hand-off point for the "playing" branch --
      // covers natural completion (`onComplete`), a genuine mid-play
      // interrupt, and the zero-duration edge case. Only ever does real
      // work if `entranceState === "playing"` at the time it's called, so
      // whichever of those three sources reaches it first wins and every
      // other one becomes a guaranteed no-op.
      function finishPlayingEntrance(reason: "completed" | "interrupted") {
        if (entranceState !== "playing") return;
        detachPlayingInterruptListener();
        entranceState = reason;
        if (entranceTl) {
          entranceTl.pause();
          if (entranceTl.progress() !== 1) {
            entranceTl.progress(1, true); // suppressEvents -- onComplete never re-fires from this jump
          }
          entranceTl.kill();
          entranceTl = null;
        }
        gsap.set(entranceAllTargets, { clearProps: "transform,opacity,filter" });
        resolveEntranceSettled?.();
        resolveEntranceSettled = null;
      }

      async function playEntrance() {
        const letters = Array.from(wordmarkEl.querySelectorAll<HTMLElement>(".hx-wordmark-letter"));
        const portraitImg = introMotionEl.querySelector<HTMLElement>(".hx-portrait img");
        const titleLines = Array.from(introMotionEl.querySelectorAll<HTMLElement>(".hx-title-line"));
        const navLinks = Array.from(introMotionEl.querySelectorAll<HTMLElement>(".hx-nav .roll-link"));
        const metrics = introMotionEl.querySelector<HTMLElement>(".hx-metrics");
        const asideRight = introMotionEl.querySelector<HTMLElement>(".hx-aside-right");
        const actions = introMotionEl.querySelector<HTMLElement>(".hx-actions");
        const closingTargets = [...navLinks, metrics, asideRight, actions].filter(
          (el): el is HTMLElement => el !== null
        );
        // `.hx-personal-note` has no wrapping container inside
        // `closingTargets` (unlike `.hx-tagline`, which piggybacks on
        // `.hx-aside-right`'s own entry there) -- queried separately so it
        // can get its own equivalent "from" state below, without adding it
        // to `closingTargets`' existing array/stagger/count.
        const personalNote = introMotionEl.querySelector<HTMLElement>(".hx-personal-note");

        // Computed BEFORE any `await` -- guarantees `entranceAllTargets` is
        // always populated, even if an unexpected error aborts this
        // function early (see the `.catch()` on `playEntrance()` below).
        const allTargets = [...letters, portraitImg, ...titleLines, ...closingTargets, personalNote].filter(
          (el): el is HTMLElement => el !== null
        );
        entranceAllTargets = allTargets;

        attachAwaitSkipListener();

        try {
          await document.fonts.ready;
        } catch {
          // Older browsers without document.fonts — proceed anyway.
        }

        if (entranceDisposed) return;

        fitWordmarkWidth();

        if (portraitImg instanceof HTMLImageElement && typeof portraitImg.decode === "function") {
          try {
            await portraitImg.decode();
          } catch {
            // decode() can reject on cache/network races — the image still
            // renders, it just wasn't guaranteed decoded first.
          }
        }

        detachAwaitSkipListener();

        if (entranceDisposed) return;

        const shouldSkip = prefersReducedMotion || window.scrollY > 0 || entranceSkipRequested;

        if (shouldSkip) {
          // No timeline is ever constructed on this path -- nothing to
          // `.from()`, so there is no immediateRender "from" state to
          // worry about at all.
          gsap.set(allTargets, { clearProps: "transform,opacity,filter" });
          entranceState = "interrupted";
          resolveEntranceSettled?.();
          resolveEntranceSettled = null;
          return;
        }

        const tl = gsap.timeline({
          defaults: { ease: "power3.out" },
          paused: true,
          onComplete: () => finishPlayingEntrance("completed"),
        });
        entranceTl = tl;

        if (letters.length) {
          tl.from(
            letters,
            { xPercent: 60, opacity: 0, filter: "blur(10px)", duration: 0.55, stagger: 0.06 },
            0
          );
        }

        if (portraitImg) {
          tl.from(
            portraitImg,
            { yPercent: 14, opacity: 0, duration: 0.75, ease: "power2.out" },
            letters.length ? "-=0.35" : 0
          );
        }

        if (titleLines.length) {
          tl.from(titleLines, { yPercent: 110, duration: 0.6, stagger: 0.08 }, "-=0.3");
        }

        // Labels the exact timeline position `closingTargets` itself starts
        // from ("-=0.2" relative to the timeline's end at THIS point, before
        // either tween below is added). GSAP resolves a bare "-=0.2" against
        // the timeline's end AT THE MOMENT OF INSERTION -- a second "-=0.2"
        // added after the 9-element, 0.05-stagger `closingTargets` tween
        // (effective span ~0.9s) would resolve 0.9s later than this label,
        // not at the same instant, which is what previously put
        // `.hx-personal-note` ~0.7s behind `.hx-aside-right` (0.9s later
        // start, minus the shared 0.2s pull-back, minus the 0.35s offset
        // both were already accounting for). Anchoring both tweens below to
        // this one label keeps them mathematically tied to the same instant
        // regardless of `closingTargets`' own span.
        tl.addLabel("closingStart", "-=0.2");

        if (closingTargets.length) {
          tl.from(closingTargets, { y: 16, opacity: 0, duration: 0.5, stagger: 0.05 }, "closingStart");
        }

        if (personalNote) {
          // Replicates `.hx-aside-right`'s exact effective entrance --
          // `.hx-tagline` gets its own entrance for free by being a visual
          // descendant of that container, which IS one of the
          // `closingTargets` (same y/opacity/duration, same inherited
          // `power3.out` timeline default ease). Anchored to the
          // `closingStart` label above -- the SAME instant `closingTargets`
          // itself starts from -- with `asideRightDelay` (reproducing
          // `.hx-aside-right`'s own stagger-computed offset: its index
          // within `closingTargets` times that tween's own 0.05 stagger
          // amount) applied via the label's own position math, so both
          // phrases land on the same frame without touching
          // `closingTargets` itself in any way.
          const asideRightIndex = asideRight ? closingTargets.indexOf(asideRight) : -1;
          const asideRightDelay = asideRightIndex >= 0 ? asideRightIndex * 0.05 : 0;
          tl.from(personalNote, { y: 16, opacity: 0, duration: 0.5 }, `closingStart+=${asideRightDelay}`);
        }

        if (entranceDisposed) {
          tl.kill();
          entranceTl = null;
          return;
        }

        // The entrance must end EXACTLY at scroll progress 0 — it never
        // runs while scrolled, and its resting state (post clearProps) is
        // the same "natural" CSS state the scroll timeline treats as its
        // own progress-0 baseline, so there's no visual pop at the handoff.
        entranceState = "playing";
        attachPlayingInterruptListener();

        if (tl.duration() === 0) {
          finishPlayingEntrance("completed");
          return;
        }

        tl.play();
      }

      playEntrance().catch((err) => {
        console.error("[HeroExperience] playEntrance failed:", err);
        detachAwaitSkipListener();
        detachPlayingInterruptListener();
        entranceTl?.kill();
        entranceTl = null;
        gsap.set(entranceAllTargets, { clearProps: "transform,opacity,filter" });
        entranceState = "interrupted";
        resolveEntranceSettled?.();
        resolveEntranceSettled = null;
      });

      // ---- Scroll timeline (individual FLIP-style morph, sidebar
      // persistence) ------------------------------------------------------
      //
      // Every element tagged `data-morph-source="<key>"` inside the hero
      // travels — on its own, via a measured translate+scale, never as a
      // group — toward the sidebar element tagged `data-morph-target` with
      // the same key. Elements with no sidebar equivalent (portrait, title,
      // chip card, actions, nav separators) just fade out in place with at
      // most a tiny leftward drift. `.hx-full-hero-scroll-motion` itself is
      // never transformed. There are only 3 states now (A/B/C) — the old
      // 4th state ("About Me transition") was removed entirely (see the
      // <style> comment above `.hx-wrap`); State C's sidebar reveal is the
      // last thing that happens, ending exactly at local progress 1.0 so
      // the hero hands off directly into the real `AboutSection`. Every
      // position in `buildScrollTimeline()` below was rebalanced together
      // (not just State C in isolation) so motion continues across
      // practically the whole 0->1 range instead of finishing early and
      // leaving a visually-quiet stretch before the sidebar takes over —
      // combined with `.hx-wrap`'s shorter height (see the <style>
      // comment above `.hx-wrap`), this closes the gap both
      // proportionally and in absolute scroll distance.
      const SIDEBAR_ACTIVATE_AT = 0.58;

      // Union of a node's *children* rects rather than the node's own
      // `getBoundingClientRect()`. Needed because `.hx-wordmark` (and a few
      // other sources/targets) are stretched to fill their positioned
      // parent via `inset-inline: 0` etc. — their own box is much wider
      // than the content actually rendered inside them, which would throw
      // off the scale computed below. Falls back to the element's own rect
      // when it has no element children (e.g. `.hx-tagline`, a bare <p>).
      function contentRect(el: HTMLElement): DOMRect {
        const children = Array.from(el.children) as HTMLElement[];
        if (!children.length) return el.getBoundingClientRect();
        let left = Infinity;
        let top = Infinity;
        let right = -Infinity;
        let bottom = -Infinity;
        children.forEach((child) => {
          const r = child.getBoundingClientRect();
          left = Math.min(left, r.left);
          top = Math.min(top, r.top);
          right = Math.max(right, r.right);
          bottom = Math.max(bottom, r.bottom);
        });
        if (!Number.isFinite(left) || !Number.isFinite(top)) return el.getBoundingClientRect();
        return new DOMRect(left, top, Math.max(right - left, 1), Math.max(bottom - top, 1));
      }

      interface MorphPair {
        source: HTMLElement;
        target: HTMLElement;
      }

      function collectMorphPairs(): MorphPair[] {
        const sources = Array.from(introMotionEl.querySelectorAll<HTMLElement>("[data-morph-source]"));
        const pairs: MorphPair[] = [];
        sources.forEach((source) => {
          const key = source.getAttribute("data-morph-source");
          if (!key) return;
          const target = compactSidebarEl.querySelector<HTMLElement>(`[data-morph-target="${key}"]`);
          if (target) pairs.push({ source, target });
        });
        return pairs;
      }

      // Center-to-center delta (not edge-to-edge) so the source always
      // converges on its target's visual center regardless of aspect-ratio
      // differences between the two (e.g. the full wordmark vs. the small
      // compact mark). Scale is capped at 1 — every sidebar target is
      // smaller than its hero source, never larger — and uses the smaller
      // of the two axis ratios so text never stretches unevenly.
      //
      // Reproduced and confirmed with an isolated Playwright test before
      // this change: this center-to-center formula, with the default
      // `transform-origin: 50% 50%`, converges within a fraction of a
      // pixel — NOT a formula or origin bug. The real cause is a race:
      // `playEntrance()` and `bootScrollTimeline()` are two independent
      // async functions with no explicit ordering between them, and
      // `playEntrance()`'s very first tween (`tl.from(letters, {xPercent:
      // 60, ...})`) applies its FROM state — the wordmark translated 60%
      // of its own width to the right — the instant it's created
      // (`immediateRender`), before `.play()` even runs. If
      // `buildScrollTimeline()` happens to build (and therefore measure
      // this source) while that state is still applied, `sourceRect` is
      // captured offset ~60% of the wordmark's own width away from its
      // true resting position — in the reproduction, a 719px-wide source
      // measured there threw the computed `x` off by ~431px, sending the
      // source flying past its target and off the left edge of the
      // viewport once the tween played, exactly matching the reported
      // bug. `playEntrance()` itself is frozen (out of scope to touch),
      // so instead of trying to sequence around it, the source is forced
      // back to its true resting geometry immediately before it's
      // measured — synchronously, so nothing can race between the clear
      // and the read — regardless of what playEntrance (or a killed prior
      // scroll timeline) may have left on it. If playEntrance's own tween
      // is still actively ticking, it simply overwrites this again on its
      // very next frame — this can never desync or interfere with it.
      function computeMorph(source: HTMLElement, target: HTMLElement) {
        gsap.set(source, { clearProps: "transform" });
        const sourceRect = contentRect(source);
        const targetRect = contentRect(target);
        // `.hx-pin` is still `position: relative` (unpinned) whenever this
        // runs -- buildScrollTimeline() always executes before
        // ScrollTrigger.refresh() ever engages the pin (see the <script>
        // comment above buildScrollTimeline()). At scrollY=0 that
        // coincidentally matches the pinned frame, but after an F5 with a
        // restored non-zero scrollY, `sourceRect` (still inside natural
        // document flow) is offset by exactly -scrollY while `targetRect`
        // (position: fixed) is not, contaminating every computed `y` by
        // that same scrollY. Subtracting `pinRect.top` normalizes the
        // source's vertical position back to "where it sits inside the
        // pin", which is scroll-invariant -- matching the frame the pin
        // will actually occupy once ScrollTrigger does engage it (trigger
        // uses `start: "top top"`).
        const pinRect = pinEl.getBoundingClientRect();
        const sourceCenterX = sourceRect.left + sourceRect.width / 2;
        const sourceCenterY = sourceRect.top - pinRect.top + sourceRect.height / 2;
        const targetCenterX = targetRect.left + targetRect.width / 2;
        const targetCenterY = targetRect.top + targetRect.height / 2;
        const scale = Math.max(
          Math.min(targetRect.width / sourceRect.width, targetRect.height / sourceRect.height, 1),
          0.001
        );
        return {
          x: targetCenterX - sourceCenterX,
          y: targetCenterY - sourceCenterY,
          scale,
        };
      }

      function collectNoTargetGroup(): HTMLElement[] {
        const portraitImg = introMotionEl.querySelector<HTMLElement>(".hx-portrait img");
        const titleBlock = introMotionEl.querySelector<HTMLElement>(".hx-title-block");
        const chipCard = introMotionEl.querySelector<HTMLElement>(".hx-chip-card");
        const actionsEl = introMotionEl.querySelector<HTMLElement>(".hx-actions");
        // Previously missing from every group -- it had no data-morph-source
        // and wasn't listed here either, so the scroll timeline never
        // touched it: it stayed at full opacity for the whole transition,
        // including visually behind the sidebar once revealed. It has no
        // sidebar equivalent, so it belongs in this fade-only group, same
        // treatment as the portrait/title/chip-card/actions.
        const personalNote = introMotionEl.querySelector<HTMLElement>(".hx-personal-note");
        return [portraitImg, titleBlock, chipCard, actionsEl, personalNote].filter(
          (el): el is HTMLElement => el !== null
        );
      }

      const blurProxy = { blur: 0 };
      const navSepProxy = { opacity: 1 };

      function buildScrollTimeline() {
        const morphPairs = collectMorphPairs();
        const noTargetGroup = collectNoTargetGroup();
        const pinFadeEl = pinEl.querySelector<HTMLElement>(".hx-pin-fade");
        const glowEl = pinEl.querySelector<HTMLElement>(".hx-glow");

        // Structural fix (not another height/timing tweak): `.hx-wrap`/
        // `.hx-pin` are now both exactly one viewport tall (see the
        // <style> comment above `.hx-wrap`) and ScrollTrigger itself pins
        // `pinEl` — `position: sticky` is gone. `end: () =>
        // `+=${window.innerHeight}`` gives the pin exactly one additional
        // viewport height of scroll to live through, and `pinSpacing:
        // false` means the real `AboutSection` (immediately next in the
        // document, no spacer, no provisional panel) slides up in normal
        // flow beneath the fixed hero that whole time, reaching the
        // viewport top exactly as the pin releases at progress 1.0 — so
        // there is no leftover warm-background scroll distance regardless
        // of exactly how the timeline's internal tween positions are
        // balanced. `anticipatePin: 1` avoids a one-frame jump right as
        // pinning engages.
        const tl = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: wrapEl,
            start: "top top",
            end: () => `+=${window.innerHeight}`,
            scrub: 0.35,
            pin: pinEl,
            pinSpacing: false,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self: { progress: number }) => {
              const active = self.progress > SIDEBAR_ACTIVATE_AT;
              compactSidebarEl.classList.toggle("is-active", active);
              compactSidebarEl.setAttribute("aria-hidden", active ? "false" : "true");
            },
          },
        });

        // State A — 0% to 12%: hero completely still, only the portrait
        // starts blurring (0px -> ~12px). Sidebar stays fully invisible.
        // Unchanged by this pass — every other position below was
        // rebalanced around it, not this.
        tl.fromTo(
          blurProxy,
          { blur: 0 },
          {
            blur: 12,
            duration: 0.12,
            onUpdate: () => pinEl.style.setProperty("--portrait-blur", `${blurProxy.blur.toFixed(2)}px`),
          },
          0
        );

        // Nav separators ("|") have no sidebar equivalent and no position
        // tween of their own (only the surrounding nav-item TEXT travels) —
        // so they used to linger, visibly stationary, while the text
        // around them moved away, reading as orphaned floating bars.
        // Faded quickly and early (10%->28%) instead, so they're gone
        // before the nav items have travelled far.
        tl.fromTo(
          navSepProxy,
          { opacity: 1 },
          {
            opacity: 0,
            duration: 0.18,
            onUpdate: () => pinEl.style.setProperty("--nav-sep-opacity", navSepProxy.opacity.toFixed(3)),
          },
          0.1
        );

        // Elements with NO sidebar equivalent (portrait, title, chip
        // card, actions, personal note): fade out early and quickly
        // (10%->40%), well before the sidebar starts activating at
        // `SIDEBAR_ACTIVATE_AT` (58%) — clears the composition instead of
        // colliding with the morphing elements still travelling through
        // the same space.
        if (noTargetGroup.length) {
          tl.to(noTargetGroup, { x: -18, opacity: 0, duration: 0.3 }, 0.1);
        }

        // Every source with a sidebar equivalent travels (translate +
        // scale, computed above) toward its target — never as a group,
        // always toward the left-hand sidebar, never rightward — finishing
        // its travel (10%->60%) just as the sidebar itself starts
        // appearing (58%, see below), i.e. the sidebar reveals "while the
        // morphs are still finishing". Opacity is untouched here — the
        // source stays fully visible, sitting exactly on its destination,
        // until the fade-out tween below.
        morphPairs.forEach(({ source, target }) => {
          const morph = computeMorph(source, target);
          tl.to(source, { x: morph.x, y: morph.y, scale: morph.scale, duration: 0.5 }, 0.1);
        });

        // Sources only start hiding once their sidebar targets are
        // already visibly appearing (62%, i.e. after `SIDEBAR_ACTIVATE_AT`
        // has already been underway for a few points and after the travel
        // above has fully landed at 60%) — closing the old gap where the
        // source had already faded out before the sidebar had begun
        // showing anything at all. `brand` (CHISU -> CHIISSUU) goes
        // through this exact same mechanism: it travels/scales toward the
        // sidebar's brand slot like every other source, sits there fully
        // formed for a couple of points, then fades out while the
        // sidebar's own compact wordmark image (revealed in State C below)
        // crossfades in — a true crossfade, never a moment where both
        // copies are simultaneously fully opaque, never a moment where
        // neither is visible.
        morphPairs.forEach(({ source }) => {
          tl.to(source, { opacity: 0, duration: 0.24 }, 0.62);
        });

        // State C — sidebar reveal: starts at `SIDEBAR_ACTIVATE_AT` (58%),
        // deliberately before State B's morph travel fully finishes (60%)
        // and well before the sources start fading (62%) — the sidebar's
        // own container/background appears via OPACITY ONLY (no `x`, so it
        // never reads as sliding in from the left) while its targets —
        // positioned all along, just hidden by the container's own
        // opacity/visibility — crossfade into view along with it.
        // `.is-active` (visibility/pointer-events/aria-hidden) is handled
        // in `onUpdate` above, keyed off this same constant. Ends at 90%,
        // settled well before the pin actually releases at 100%.
        tl.fromTo(
          compactSidebarEl,
          { opacity: 0 },
          { opacity: 1, duration: 0.32 },
          SIDEBAR_ACTIVATE_AT
        );

        // Warm-to-black backdrop crossfade — fades `.hx-pin-fade` (the
        // gold background image) AND `.hx-glow` (the warm radial
        // highlights layered on top of it) together, so no warm-toned
        // layer is left lingering once the base beneath them is already
        // black. Spans the final 23% of the timeline (75%->98%), clearly
        // perceptible rather than the previous few visual tenths, and
        // finishes 2 points before the pin actually releases at 100% —
        // fully settled before the unpin, not exactly coincident with it.
        // By this point `AboutSection`'s real dark background has already
        // scrolled up to sit directly beneath the fixed pin (per
        // `pinSpacing: false` above), and `.hx-pin-fade`'s own solid base
        // color now matches `--section-dark-start` exactly (see the
        // <style> comment above `.hx-pin-fade`), so fading these two
        // layers reveals it smoothly with no beige/light flash at any
        // point along the way.
        if (pinFadeEl) {
          tl.to(pinFadeEl, { opacity: 0, duration: 0.23 }, 0.75);
        }
        if (glowEl) {
          tl.to(glowEl, { opacity: 0, duration: 0.23 }, 0.75);
        }

        // If this (re)build happens mid-scroll (e.g. a resize while already
        // past the activation point), sync the sidebar's active state to
        // the current scroll position immediately rather than waiting for
        // the next scroll event.
        const trigger = tl.scrollTrigger;
        if (trigger) {
          const active = trigger.progress > SIDEBAR_ACTIVATE_AT;
          compactSidebarEl.classList.toggle("is-active", active);
          compactSidebarEl.setAttribute("aria-hidden", active ? "false" : "true");
        }

        return tl;
      }

      function clearScrollDrivenState() {
        pinEl.style.removeProperty("--portrait-blur");
        pinEl.style.removeProperty("--nav-sep-opacity");
        const morphSources = Array.from(introMotionEl.querySelectorAll<HTMLElement>("[data-morph-source]"));
        const noTargetGroup = collectNoTargetGroup();
        gsap.set([...morphSources, ...noTargetGroup], { clearProps: "all" });
        gsap.set(compactSidebarEl, { clearProps: "opacity" });
        const pinFadeEl = pinEl.querySelector<HTMLElement>(".hx-pin-fade");
        if (pinFadeEl) gsap.set(pinFadeEl, { clearProps: "opacity" });
        const glowEl = pinEl.querySelector<HTMLElement>(".hx-glow");
        if (glowEl) gsap.set(glowEl, { clearProps: "opacity" });
        // Explicit `display: none` fallback for reduced-motion/mobile static
        // mode (see `.hx-wrap.hx-static + .hx-compact-sidebar` in the
        // <style> above) — this just resets the class/attribute state that
        // CSS rule depends on, so the sidebar never sits in an inert,
        // half-visible limbo.
        compactSidebarEl.classList.remove("is-active");
        compactSidebarEl.setAttribute("aria-hidden", "true");
      }

      let scrollTl: gsap.core.Timeline | null = null;

      function evaluateMode() {
        const shouldScroll = !prefersReducedMotion && isDesktopViewport();

        if (shouldScroll) {
          // Always rebuilt from scratch (never just `invalidate()`d): the
          // morph's x/y/scale values are baked in from measured rects at
          // build time, so a resize needs fresh measurements, not a replay
          // of stale ones.
          if (scrollTl) {
            scrollTl.scrollTrigger?.kill();
            scrollTl.kill();
            scrollTl = null;
          }
          wrapEl.classList.remove("hx-static");
          pinEl.classList.remove("hx-static");
          scrollTl = buildScrollTimeline();
        } else if (scrollTl) {
          scrollTl.scrollTrigger?.kill();
          scrollTl.kill();
          scrollTl = null;
          wrapEl.classList.add("hx-static");
          pinEl.classList.add("hx-static");
          clearScrollDrivenState();
        }
      }

      // The very first measurement pass must wait for fonts/portrait decode
      // — same readiness gate `playEntrance()` awaits — so the FLIP rects
      // above aren't taken against not-yet-laid-out text/wordmark sizing.
      // Deferred to a microtask/async boundary, so it re-enters the context
      // via `ctx.add()` just like the resize/motion-pref handlers below.
      async function bootScrollTimeline() {
        try {
          await document.fonts.ready;
        } catch {
          // Older browsers without document.fonts — proceed anyway.
        }
        const portraitImgEl = introMotionEl.querySelector<HTMLImageElement>(".hx-portrait img");
        if (portraitImgEl && typeof portraitImgEl.decode === "function") {
          try {
            await portraitImgEl.decode();
          } catch {
            // decode() can reject on cache/network races — proceed anyway.
          }
        }
        fitWordmarkWidth();
        await entranceSettled;
        if (entranceDisposed) return;
        ctx.add(() => evaluateMode());
        // Initial sync in case the page loads already scrolled mid-way
        // through a dark section (e.g. a deep link/anchor, or a reload
        // with scroll restoration) — otherwise every article would sit at
        // its default "warm" state until the next scroll event.
        checkArticleThemes();
        // Same reasoning as the article-theme sync above, but for which
        // sidebar link should read as active — built AFTER `evaluateMode()`
        // has already constructed (or torn down) the hero's own pin/morph
        // ScrollTrigger, so these measurements are taken against final
        // geometry, then `ScrollTrigger.refresh()` makes every trigger
        // (old and new) agree on final positions.
        ctx.add(() => createNavActiveTriggers());
        ScrollTrigger.refresh();
      }

      void bootScrollTimeline();

      let resizeTimer: ReturnType<typeof setTimeout> | undefined;
      const onResize = () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          fitWordmarkWidth();
          // Re-entering the context here (via `ctx.add`) means anything
          // `evaluateMode()` creates on this later, asynchronous call is
          // still tracked for cleanup — not just the very first call above.
          ctx.add(() => evaluateMode());
        }, 120);
      };
      window.addEventListener("resize", onResize);

      const onMotionPrefChange = (event: MediaQueryListEvent) => {
        prefersReducedMotion = event.matches;
        ctx.add(() => evaluateMode());
      };
      prefersReducedMotionQuery.addEventListener("change", onMotionPrefChange);

      // ---- Per-article sidebar theme sync (GSAP + ScrollTrigger only,
      // no React, no IntersectionObserver) --------------------------------
      //
      // The sidebar is transparent and each `.hx-sidebar-article` carries
      // its own constant translucent `.hx-glass` background (see the
      // <style> above) — so a section boundary crossing behind the
      // sidebar is already visible THROUGH a card via alpha blending
      // alone. What still needs deciding, independently per article, is
      // whether that article's TEXT/BORDER should read as "warm" or
      // "dark" for legibility. A single whole-sidebar toggle (the old
      // IntersectionObserver keyed to the viewport's vertical center)
      // forced every article to flip at once; here each article measures
      // its OWN `getBoundingClientRect()` overlap against every real
      // `.section-theme-dark` section and only that one article's colors
      // tween.
      const WARM_ART = {
        "--art-text": "#000000",
        "--art-text-muted": "#000000",
        "--art-border": "rgba(26, 25, 25, 0.14)",
        "--art-divider": "#000000",
      };
      const DARK_ART = {
        "--art-text": "#ffffff",
        "--art-text-muted": "#ffffff",
        "--art-border": "rgb(255 255 255 / 14%)",
        "--art-divider": "#ffffff",
      };

      interface ArticleThemeState {
        el: HTMLElement;
        isDark: boolean;
        isNav: boolean;
      }

      const sidebarArticleEls = Array.from(
        compactSidebarEl.querySelectorAll<HTMLElement>(".hx-sidebar-article")
      );
      const articleStates: ArticleThemeState[] = sidebarArticleEls.map((el) => ({
        el,
        isDark: false,
        // The nav article uses a higher (~35%-of-its-own-height) overlap
        // threshold than the others to avoid flicker — it's tall and thin,
        // so a small sliver of overlap at its very top/bottom edge would
        // otherwise flip it back and forth every few pixels of scroll.
        isNav: el.classList.contains("hx-sidebar-nav"),
      }));

      function checkArticleThemes() {
        if (!articleStates.length) return;
        const darkSections = Array.from(document.querySelectorAll<HTMLElement>(".section-theme-dark"));

        articleStates.forEach((state) => {
          const artRect = state.el.getBoundingClientRect();
          if (artRect.height <= 0) return;

          let maxOverlap = 0;
          darkSections.forEach((section) => {
            const secRect = section.getBoundingClientRect();
            const overlapTop = Math.max(artRect.top, secRect.top);
            const overlapBottom = Math.min(artRect.bottom, secRect.bottom);
            const overlap = Math.max(0, overlapBottom - overlapTop);
            if (overlap > maxOverlap) maxOverlap = overlap;
          });

          const overlapRatio = maxOverlap / artRect.height;
          // Brand/metrics/socials switch at the start of any real overlap;
          // the nav article needs ~35% of its own height covered first.
          const threshold = state.isNav ? 0.35 : 0.02;
          const shouldBeDark = overlapRatio >= threshold;

          // Only the article whose computed state actually CHANGED gets a
          // new tween — every other article's existing tween (or resting
          // state) is left alone, so nothing re-runs every scroll frame.
          if (shouldBeDark === state.isDark) return;
          state.isDark = shouldBeDark;
          state.el.setAttribute("data-theme", shouldBeDark ? "dark" : "warm");
          gsap.to(state.el, {
            ...(shouldBeDark ? DARK_ART : WARM_ART),
            duration: prefersReducedMotion ? 0 : 0.3,
            ease: "power1.out",
            overwrite: "auto",
          });
        });
      }

      const articleThemeTrigger = ScrollTrigger.create({
        start: 0,
        end: "max",
        onUpdate: checkArticleThemes,
        onRefresh: checkArticleThemes,
      });

      // ---- Sidebar active-link tracking (ScrollTrigger only, no new
      // deps) ---------------------------------------------------------
      //
      // One ScrollTrigger per SECTION GROUP, not per link — Servicios and
      // Tools are two nav entries but ONE shared visual section on the
      // home page (`#services-tools`, containing `#services`/`#tools` as
      // side-by-side columns), so they share a single trigger keyed to the
      // combined wrapper and both light up together. Every other group
      // has exactly one nav id. FAQ now gets its own group/trigger too
      // (previously it had none, so Contacto stayed active by default —
      // no longer the case: FAQ is now a real controlled link).
      // `data-nav-id` (set on each sidebar link's markup above) is the
      // section's real `id` — for Servicios/Tools that id belongs to the
      // HOME PAGE's in-page column, not the `/servicios/`/`/tools/`
      // subpage the link's `href` actually points to; the two are
      // deliberately decoupled (see `sidebarNavItems` in the frontmatter).
      const navLinkEls = Array.from(
        compactSidebarEl.querySelectorAll<HTMLAnchorElement>("[data-nav-id]")
      );

      const NAV_TRIGGER_GROUPS: { sectionId: string; navIds: string[] }[] = [
        { sectionId: "home", navIds: ["home"] },
        { sectionId: "about", navIds: ["about"] },
        { sectionId: "projects", navIds: ["projects"] },
        { sectionId: "services-tools", navIds: ["services", "tools"] },
        { sectionId: "contact", navIds: ["contact"] },
        { sectionId: "faq", navIds: ["faq"] },
      ];

      // Sets one or more links active at once — the ONLY case with more
      // than one is the Servicios+Tools group above. Always clears every
      // non-matching link first, so outside that one group there is still
      // never more than one active link at a time.
      function setActiveSections(ids: string[]) {
        navLinkEls.forEach((link) => {
          const navId = link.getAttribute("data-nav-id");
          const isMatch = !!navId && ids.includes(navId);
          link.classList.toggle("is-active", isMatch);
          // Servicios/Tools `href` points at a REAL, SEPARATE page
          // (`/servicios/`, `/tools/`) — even while their sidebar entry
          // reads as active (still on the home page, scrolled through
          // their combined block), `aria-current="location"` would
          // falsely claim that link represents the page currently
          // loaded. Only same-page anchor links (`href` starting with
          // "#") are eligible for it.
          const isSamePageLink = (link.getAttribute("href") ?? "").startsWith("#");
          if (isMatch && isSamePageLink) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      }

      let navSectionTriggers: ReturnType<typeof ScrollTrigger.create>[] = [];

      function createNavActiveTriggers() {
        navSectionTriggers.forEach((trigger) => trigger.kill());
        navSectionTriggers = [];

        NAV_TRIGGER_GROUPS.forEach((group) => {
          const sectionEl = document.getElementById(group.sectionId);
          if (!sectionEl) return;
          navSectionTriggers.push(
            ScrollTrigger.create({
              trigger: sectionEl,
              start: "top 45%",
              end: "bottom 45%",
              onEnter: () => setActiveSections(group.navIds),
              onEnterBack: () => setActiveSections(group.navIds),
            })
          );
        });

        // Initial sync: `onEnter`/`onEnterBack` only fire on a
        // direction-based crossing, so on first load (or a reload already
        // scrolled deep into the page via a deep link) none of them may
        // have fired yet. Pick whichever group's section top has already
        // passed the same "45% down the viewport" line each trigger above
        // uses, taking the LAST one that qualifies (i.e. the most
        // recently entered).
        const viewportLine = window.innerHeight * 0.45;
        let currentGroup: string[] | null = null;
        NAV_TRIGGER_GROUPS.forEach((group) => {
          const sectionEl = document.getElementById(group.sectionId);
          if (!sectionEl) return;
          const rect = sectionEl.getBoundingClientRect();
          if (rect.top <= viewportLine) {
            currentGroup = group.navIds;
          }
        });
        if (currentGroup) setActiveSections(currentGroup);
      }

      return () => {
        entranceDisposed = true;
        detachAwaitSkipListener();
        detachPlayingInterruptListener();
        if (entranceTl) {
          entranceTl.pause();
          entranceTl.kill();
          entranceTl = null;
        }
        // Resolving here (in addition to the `if (entranceDisposed) return;`
        // check inside `bootScrollTimeline()`) unblocks a `playEntrance()`
        // that was disposed while still "pending" (still awaiting
        // fonts/decode) -- without this, `await entranceSettled` in
        // `bootScrollTimeline()` would never resolve and that async chain
        // would hang forever instead of reaching its own disposed check.
        resolveEntranceSettled?.();
        resolveEntranceSettled = null;
        window.clearTimeout(resizeTimer);
        window.removeEventListener("resize", onResize);
        prefersReducedMotionQuery.removeEventListener("change", onMotionPrefChange);
        articleThemeTrigger.kill();
        navSectionTriggers.forEach((trigger) => trigger.kill());
      };
    }, wrapEl);

    document.addEventListener("astro:before-swap", () => ctx.revert());
  }
</script>
