---
import { withBase } from "../lib/paths.js";
import type { SimpleNavContent } from "../lib/content-types";
import type { Locale } from "../lib/i18n";

interface Props {
  t: SimpleNavContent;
  /** Home of the page's language ("/" or "/en/"). */
  home?: string;
  /** Language of this page and this same page in each language (ES | EN). */
  locale?: Locale;
  alternates?: Record<Locale, string>;
}

const { t, home: homeProp, locale = "es", alternates } = Astro.props as Props;
const home = homeProp ?? withBase("/");

const navItems = [
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#contact`, label: t.nav.contact },
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#tools`, label: t.nav.tools },
];
---

<nav class="rd-simple-nav">
  <a class="rd-simple-nav-logo" href={home}>CHIISSUU</a>
  <div class="rd-simple-nav-links">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  {alternates && (
    <div class="rd-simple-nav-lang" role="group" aria-label={t.hero.language.label}>
      {locale === "es" ? (
        <span class="is-current" lang="es" aria-current="true">ES</span>
      ) : (
        <a href={alternates.es} hreflang="es" lang="es" aria-label={t.hero.language.toEs}>ES</a>
      )}
      <span aria-hidden="true">|</span>
      {locale === "en" ? (
        <span class="is-current" lang="en" aria-current="true">EN</span>
      ) : (
        <a href={alternates.en} hreflang="en" lang="en" aria-label={t.hero.language.toEn}>EN</a>
      )}
    </div>
  )}
</nav>

<style>
  .rd-simple-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1.25rem, 6vw, 4rem);
    background: rgba(231, 232, 236, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .rd-simple-nav-logo {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .rd-simple-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .rd-simple-nav-links a:hover {
    color: var(--color-text);
  }

  .rd-simple-nav-lang {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .rd-simple-nav-lang a:hover {
    color: var(--color-text);
  }

  .rd-simple-nav-lang .is-current {
    font-weight: 700;
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .rd-simple-nav-links {
      display: none;
    }
  }
</style>
