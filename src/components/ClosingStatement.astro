---
import type { ClosingStatementContent } from "../lib/content-types";

interface Props {
  t: ClosingStatementContent;
}

const { t } = Astro.props as Props;
---

<div class="rd-closing">
  <p>{t.closing.text}</p>
  <p class="rd-closing-signature">{t.closing.signature}</p>
</div>

<style>
  .rd-closing {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .rd-closing-signature {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
  }
</style>
