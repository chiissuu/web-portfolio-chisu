---
// One preview card: index pill and optional status on top, an image slot
// (placeholder until real artwork exists), then title, text, tags and a gold
// arrow. Tags sit at the bottom because Spanish tags don't fit a narrow card's
// top row. With `href` the whole card is one link (the title link is stretched
// over it); without it the card is inert and its arrow is dimmed.
interface Props {
  number: string;
  title: string;
  text: string;
  tags: readonly string[];
  eyebrow?: string;
  href?: string;
}

const { number, title, text, tags, eyebrow, href } = Astro.props as Props;
---

<article class:list={["sc-card", { "sc-card--static": !href }]}>
  <div class="sc-top">
    <span class="sc-num" aria-hidden="true">{number}</span>
    {eyebrow && <p class="sc-eyebrow">{eyebrow}</p>}
  </div>

  <div class="sc-media" aria-hidden="true"></div>

  <div class="sc-body">
    <h3 class="sc-title">
      {href ? <a class="sc-link" href={href}>{title}</a> : title}
    </h3>
    <p class="sc-text">{text}</p>
    <ul class="sc-tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>

  <span class="sc-arrow" aria-hidden="true">&#8599;</span>
</article>

<style>
  .sc-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 26rem;
    padding: 1.1rem 1.1rem 1.1rem;
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    background: var(--theme-surface);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .sc-card:not(.sc-card--static):hover {
    transform: translateY(-6px);
    border-color: var(--color-brand-gold);
  }

  .sc-card:has(.sc-link:focus-visible) {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 4px;
  }

  .sc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 1.9rem;
  }

  .sc-num,
  .sc-tags li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    background: var(--sc-chip-bg, rgb(5 5 5 / 35%));
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.2;
    color: var(--theme-text-muted);
    white-space: nowrap;
  }

  .sc-tags li {
    padding: 0.25rem 0.6rem;
    font-size: 0.68rem;
  }

  .sc-num {
    color: var(--theme-text);
  }

  .sc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Image slot: a dashed placeholder, like the Proyectos cards. */
  .sc-media {
    flex: 1;
    min-height: 9rem;
    border: 1px dashed var(--theme-border);
    border-radius: 10px;
    background:
      linear-gradient(135deg, rgba(138, 106, 31, 0.16), transparent 55%),
      linear-gradient(315deg, rgba(184, 144, 44, 0.14), transparent 55%);
  }

  .sc-body {
    padding-inline-end: 3.4rem;
  }

  .sc-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-accent, var(--color-brand-gold));
  }

  .sc-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--theme-text);
  }

  .sc-link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole card is the click and tap target. */
  .sc-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .sc-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--theme-text-muted);
  }

  /* Gold metal arrow, same palette as the nav buttons. */
  .sc-arrow {
    position: absolute;
    inset-inline-end: 1.1rem;
    inset-block-end: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid transparent;
    border-radius: 50%;
    font-size: 1.15rem;
    line-height: 1;
    color: #1a1406;
    background:
      linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32) padding-box,
      linear-gradient(135deg, #efd683 8%, #b08a32 30%, #c19b3d 48%, #efd683 72%, #b08a32) border-box;
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 65%),
      inset 0 -1px 2px rgb(0 0 0 / 22%),
      0 2px 6px rgb(0 0 0 / 40%);
    transition: transform 0.25s ease;
  }

  .sc-card:not(.sc-card--static):hover .sc-arrow {
    transform: translate(2px, -2px);
  }

  .sc-card--static .sc-arrow {
    opacity: 0.35;
    filter: saturate(0.5);
  }

  @media (max-width: 900px) {
    .sc-card {
      min-height: 22rem;
    }
  }
</style>
