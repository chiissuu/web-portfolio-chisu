---
// FAQ, the last section: ivory paper with question marks. A centred head, one
// column of questions that open and close with a short animation (opening one
// closes the one that was open), shortcuts to the other sections inside the
// answers, a line to ask something that is not there, and the last words of the
// page with a round "back to top" button. The boundary from Contacto is the
// sunrise (FaqBridge).
import { ArrowUp } from "lucide-astro";
import type { FaqSectionContent } from "../lib/content-types";
import SectionHeadingCard from "./SectionHeadingCard.astro";
import SectionBackdrop from "./SectionBackdrop.astro";
import FaqBridge from "./FaqBridge.astro";

interface Props {
  t: FaqSectionContent;
}

const { t } = Astro.props as Props;
const { faq, closing } = t;
---

<section class="section-theme-warm bd-host bd-light faq-section" id="faq">
  <SectionBackdrop kind="ivory" edge={false} />
  <FaqBridge />
  <div class="section-inner">
    <SectionHeadingCard text={faq.title} image={faq.titleImage} as="h2" size="lg" />

    <p class="fq-lead">{faq.lead}</p>

    <div class="fq-list" data-fq>
      {faq.items.map((item, index) => (
        <details class="fq-item">
          <summary>
            <span class="fq-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="fq-q">{item.q}</span>
            <span class="fq-icon" aria-hidden="true"></span>
          </summary>
          <div class="fq-body">
            <div class="fq-body-inner">
              <p>{item.a}</p>
              {item.link && (
                <a class="fq-link" href={item.link.href}>
                  {item.link.label}<span aria-hidden="true"> &#8594;</span>
                </a>
              )}
            </div>
          </div>
        </details>
      ))}
    </div>

    <p class="fq-more">
      {faq.more.text}
      <a class="fq-more-link" href={faq.more.href}>{faq.more.linkLabel}<span aria-hidden="true"> &#8594;</span></a>
    </p>

    <footer class="fq-end">
      <p class="fq-end-text">{closing.text}</p>
      <p class="fq-end-sign">{closing.signature}</p>
      <a class="fq-top" href="#home" aria-label={closing.topLabel}>
        <ArrowUp size={20} aria-hidden="true" />
      </a>
    </footer>
  </div>
</section>

<style>
  .faq-section {
    background: #efe8d5;
  }

  .faq-section :global(.shc-art) {
    margin-inline: auto;
  }

  .fq-lead {
    max-width: 36rem;
    margin: 0 auto clamp(1.8rem, 3.5vw, 2.6rem);
    text-align: center;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--theme-text-muted);
    text-wrap: balance;
  }

  /* --- The questions: one column, paper cards ------------------------------ */
  .fq-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .fq-item {
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    background: rgb(255 255 255 / 55%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 70%) inset, 0 8px 24px rgb(96 72 24 / 7%);
    color: var(--theme-text);
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  .fq-item:hover {
    border-color: rgb(176 138 50 / 55%);
  }

  /* The open question: gold edge on the left and a lighter sheet. */
  .fq-item.is-open {
    border-color: rgb(176 138 50 / 70%);
    background: rgb(255 255 255 / 82%);
    box-shadow: inset 3px 0 0 #c19b3d, 0 10px 28px rgb(96 72 24 / 11%);
  }

  .fq-item summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    list-style: none;
    border-radius: 14px;
  }

  .fq-item summary::-webkit-details-marker {
    display: none;
  }

  .fq-item summary:focus-visible {
    outline: 2px solid #7a5a12;
    outline-offset: 3px;
  }

  .fq-num {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--theme-accent, #7a5a12);
  }

  .fq-q {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 700;
    line-height: 1.3;
  }

  /* A plus that turns into a minus: two bars, the vertical one folds away. */
  .fq-icon {
    position: relative;
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid rgb(143 108 36 / 55%);
    border-radius: 50%;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .fq-icon::before,
  .fq-icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 2px;
    margin: -1px 0 0 -0.35rem;
    border-radius: 1px;
    background: #7a5a12;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .fq-icon::after {
    transform: rotate(90deg);
  }

  .fq-item.is-open .fq-icon {
    border-color: #8f6c24;
    background: linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32);
  }

  .fq-item.is-open .fq-icon::before,
  .fq-item.is-open .fq-icon::after {
    background: #211b0e;
  }

  .fq-item.is-open .fq-icon::after {
    transform: rotate(0deg);
  }

  /* The answer's box is what the script animates (height and opacity). */
  .fq-body {
    overflow: hidden;
  }

  .fq-body-inner {
    padding: 0 1.3rem 1.3rem calc(1.3rem + 0.74rem * 2 + 1rem);
  }

  .fq-body-inner p {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--theme-text-muted);
  }

  .fq-link {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: #7a5a12;
    text-decoration: none;
  }

  .fq-link:hover,
  .fq-more-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fq-link:focus-visible,
  .fq-more-link:focus-visible {
    outline: 2px solid #7a5a12;
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* --- "Your question isn't here?" and the end of the page ------------------ */
  .fq-more {
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    text-align: center;
    color: var(--theme-text-muted);
  }

  .fq-more-link {
    margin-left: 0.4rem;
    font-weight: 700;
    color: #7a5a12;
    text-decoration: none;
  }

  .fq-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(1.6rem, 3vw, 2.2rem);
    border-top: 1px solid var(--theme-border);
    text-align: center;
  }

  .fq-end-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--theme-text);
  }

  .fq-end-sign {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--theme-text-muted);
  }

  /* The round gold button, the same metal as the arrows of the sidebar. */
  .fq-top {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    margin-top: 1.1rem;
    border: 2px solid transparent;
    border-radius: 50%;
    color: #1a1406;
    background:
      linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32) padding-box,
      linear-gradient(135deg, #efd683 8%, #b08a32 30%, #c19b3d 48%, #efd683 72%, #b08a32) border-box;
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 65%),
      inset 0 -1px 2px rgb(0 0 0 / 22%),
      0 3px 8px rgb(96 72 24 / 35%);
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .fq-top:hover {
    transform: translateY(-3px);
    filter: brightness(1.08);
  }

  .fq-top:focus-visible {
    outline: 2px solid #7a5a12;
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .fq-item summary {
      padding: 1rem;
    }

    .fq-body-inner {
      padding: 0 1rem 1.1rem;
    }
  }
</style>

<script>
  // One question open at a time: opening one closes the one that was open.
  // The answer's box grows and shrinks (height and opacity) with the Web
  // Animations API; with "reduce motion" it just switches. `is-open` is the
  // logical state (the `open` attribute stays on while the closing plays).
  document.querySelectorAll<HTMLElement>("[data-fq]").forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>(".fq-item"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const running = new WeakMap<HTMLElement, Animation>();

    const body = (item: HTMLDetailsElement) => item.querySelector<HTMLElement>(".fq-body")!;

    const open = (item: HTMLDetailsElement) => {
      running.get(item)?.cancel();
      item.open = true;
      item.classList.add("is-open");
      if (reduce) return;
      const box = body(item);
      const animation = box.animate(
        { height: ["0px", box.scrollHeight + "px"], opacity: [0, 1] },
        { duration: 320, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" }
      );
      running.set(item, animation);
      animation.onfinish = () => running.delete(item);
    };

    const close = (item: HTMLDetailsElement) => {
      running.get(item)?.cancel();
      item.classList.remove("is-open");
      if (reduce || !item.open) {
        item.open = false;
        return;
      }
      const box = body(item);
      const animation = box.animate(
        { height: [box.offsetHeight + "px", "0px"], opacity: [1, 0] },
        { duration: 240, easing: "ease" }
      );
      running.set(item, animation);
      animation.onfinish = () => {
        item.open = false;
        running.delete(item);
      };
    };

    items.forEach((item) => {
      item.querySelector("summary")?.addEventListener("click", (event) => {
        event.preventDefault();
        if (item.classList.contains("is-open")) {
          close(item);
          return;
        }
        items.filter((other) => other !== item && other.classList.contains("is-open")).forEach(close);
        open(item);
      });
    });
  });
</script>
