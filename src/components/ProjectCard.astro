---
// One project on the horizontal rail: a tall card with a tinted artwork area
// (a gold line illustration until real screenshots exist), an index pill and
// the tags on top, title and text over a dark fade at the bottom, and a gold
// arrow. With `href` the whole card is one link; without it the card is inert
// and its arrow is dimmed. `data-sc-card` lets the rail know which cards are
// projects (counter, focus).
import ProjectArt from "./ProjectArt.astro";

interface Props {
  number: string;
  title: string;
  text: string;
  tags: readonly string[];
  eyebrow?: string;
  href?: string;
  /** Illustration motif (see ProjectArt). */
  art?: string;
  /** A headline figure shown big over the illustration. */
  metric?: { value: string; label: string };
  /** Shows a pulsing dot before the eyebrow (project in progress). */
  live?: boolean;
}

const { number, title, text, tags, eyebrow, href, art, metric, live = false } = Astro.props as Props;

// Placeholder artwork: a different tint per card so the rail reads as a
// sequence while it is being tested.
const tints = [
  ["#6b4f1d", "#1b1408"],
  ["#2a5457", "#0b1819"],
  ["#4a3a6b", "#14101f"],
  ["#5b5a1f", "#17170a"],
  ["#6b3a22", "#1d0f08"],
  ["#2f4d6b", "#0c141d"],
];
const index = Math.max(0, parseInt(number, 10) - 1) % tints.length;
const [tintA, tintB] = tints[index];
// Repositories and live pages open in a new tab.
const external = href ? /^https?:/.test(href) : false;
---

<article
  class:list={["pj-card", { "pj-card--static": !href }]}
  style={`--pj-a:${tintA};--pj-b:${tintB}`}
  data-sc-card
>
  <div class="pj-media" aria-hidden="true"></div>

  {art && (
    <div class="pj-art" aria-hidden="true">
      <ProjectArt kind={art} />
      {metric && (
        <p class="pj-metric">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </p>
      )}
    </div>
  )}

  <div class="pj-top">
    <span class="pj-num" aria-hidden="true">{number}</span>
    <ul class="pj-tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>

  <div class="pj-body">
    {eyebrow && (
      <p class="pj-eyebrow">
        {live && <span class="pj-live" aria-hidden="true"></span>}
        {eyebrow}
      </p>
    )}
    <h3 class="pj-title">
      {href ? (
        <a class="pj-link" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{title}</a>
      ) : title}
    </h3>
    <p class="pj-text">{text}</p>
  </div>

  <span class="pj-arrow" aria-hidden="true">&#8599;</span>
</article>

<style>
  .pj-card {
    --pj-y: 0px;
    --pj-s: 1;
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 0 0 clamp(17rem, 25vw, 25rem);
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 5 / 7;
    padding: 1.1rem;
    overflow: hidden;
    text-align: left;
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    background: var(--pj-b);
    transform: translateY(var(--pj-y)) scale(var(--pj-s));
    transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.35s ease, border-color 0.3s ease;
  }

  .pj-card:not(.pj-card--static):hover {
    --pj-y: -6px;
    border-color: var(--color-brand-gold);
  }

  /* The card the rail is currently at grows a little; the others step back
     (only while the rail is pinned and sliding). */
  .pj-card.is-focus {
    --pj-s: 1.03;
  }

  :global(.sc-rail[data-pinned]) .pj-card:not(.is-focus) {
    opacity: 0.82;
  }

  .pj-card:has(.pj-link:focus-visible) {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 4px;
  }

  /* Placeholder artwork, filling the whole card; swapped for a real image later. */
  .pj-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 70% at 75% 15%, color-mix(in srgb, var(--pj-a) 85%, white 8%), transparent 62%),
      radial-gradient(90% 60% at 10% 85%, color-mix(in srgb, var(--pj-a) 55%, black), transparent 70%),
      linear-gradient(160deg, var(--pj-a), var(--pj-b));
    transition: transform 0.6s ease;
  }

  .pj-card:not(.pj-card--static):hover .pj-media {
    transform: scale(1.05);
  }

  /* Dark fade so the text stays readable over any image. */
  .pj-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(5 5 5 / 25%) 0, transparent 30%, transparent 45%, rgb(5 5 5 / 85%) 100%);
  }

  /* The illustration sits in the middle of the card, between the pills and the text. */
  .pj-art {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 19%;
    height: 34%;
    z-index: -1;
    color: #efd683;
    transition: transform 0.6s ease;
  }

  .pj-card:not(.pj-card--static):hover .pj-art {
    transform: scale(1.04);
  }

  .pj-metric {
    position: absolute;
    right: -4%;
    bottom: -14%;
    margin: 0;
    text-align: right;
    line-height: 1;
    text-shadow: 0 0 18px rgb(239 214 131 / 55%);
  }

  .pj-metric strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.2vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff3c4;
  }

  .pj-metric span {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #efd683;
  }

  .pj-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .pj-num,
  .pj-tags li {
    padding: 0.3rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    background: rgb(5 5 5 / 40%);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.2;
    color: #f3f4f5;
    white-space: nowrap;
  }

  .pj-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pj-body {
    padding-inline-end: 3.4rem;
  }

  .pj-eyebrow {
    display: flex;
    align-items: center;
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-gold);
  }

  .pj-live {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: #efd683;
    animation: pj-pulse 1.8s ease-out infinite;
  }

  @keyframes pj-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(239 214 131 / 60%);
    }
    100% {
      box-shadow: 0 0 0 0.55rem rgb(239 214 131 / 0%);
    }
  }

  .pj-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: #f3f4f5;
  }

  .pj-link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole card is the click and tap target. */
  .pj-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .pj-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #cfd2d4;
  }

  /* Gold metal arrow, same palette as the nav buttons. */
  .pj-arrow {
    position: absolute;
    inset-inline-end: 1.1rem;
    inset-block-end: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid transparent;
    border-radius: 50%;
    font-size: 1.15rem;
    line-height: 1;
    color: #1a1406;
    background:
      linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32) padding-box,
      linear-gradient(135deg, #efd683 8%, #b08a32 30%, #c19b3d 48%, #efd683 72%, #b08a32) border-box;
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 65%),
      inset 0 -1px 2px rgb(0 0 0 / 22%),
      0 2px 6px rgb(0 0 0 / 40%);
    transition: transform 0.25s ease;
  }

  .pj-card:not(.pj-card--static):hover .pj-arrow {
    transform: translate(2px, -2px);
  }

  .pj-card--static .pj-arrow {
    opacity: 0.35;
    filter: saturate(0.5);
  }

  @media (max-width: 899px) {
    .pj-card {
      flex-basis: min(78vw, 20rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-live {
      animation: none;
    }
  }
</style>
