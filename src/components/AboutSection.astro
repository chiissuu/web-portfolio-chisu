---
import type { AboutSectionContent } from "../lib/content-types";

interface Props {
  t: AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const about = t.about;
const titleImage = about.aboutMe.titleImage;
// Hide the PNG's transparent canvas margins without editing the original.
const titleImageStyle = titleImage && {
  "aspect-ratio": `${titleImage.crop.width} / ${titleImage.crop.height}`,
  "--ab-title-image-width": `${100 * titleImage.width / titleImage.crop.width}%`,
  "--ab-title-image-left": `${-100 * titleImage.crop.x / titleImage.crop.width}%`,
  "--ab-title-image-top": `${-100 * titleImage.crop.y / titleImage.crop.height}%`,
};

type ProsePart =
  | { text: string; kind: "text" | "strong" | "location" | "closing" }
  | { text: string; kind: "link"; href: string }
  | { text: string; kind: "emoji"; symbol: string }
  | { text: string; kind: "flag"; country: string };
const accents = about.aboutMe.accents;
const strongAnnotations: ProsePart[] = accents.strong.map((text) => ({ text, kind: "strong" }));
const annotations = ([
  { text: about.aboutMe.closingPhrase, kind: "closing" },
  ...accents.links.map(({ text, href }) => ({ text, href, kind: "link" as const })),
  ...strongAnnotations,
  ...accents.emojis.map(({ text, symbol }) => ({ text, symbol, kind: "emoji" as const })),
  { text: accents.location, kind: "location" },
  ...accents.flags.map(({ text, country }) => ({ text, country, kind: "flag" as const })),
] satisfies ProsePart[]).filter(({ text }) => text.length > 0);

// Preserve authored paragraphs; only their presentation is grouped.
const introParagraphCount = 3;
const proseGroups = [
  {
    headingId: "ab-intro-heading",
    title: about.aboutMe.groupLabels.intro,
    paragraphs: about.aboutMe.paragraphs.slice(0, introParagraphCount),
    offset: 0,
  },
  {
    headingId: "ab-difference-heading",
    title: about.aboutMe.groupLabels.difference,
    paragraphs: about.aboutMe.paragraphs.slice(introParagraphCount),
    offset: introParagraphCount,
  },
].filter(({ paragraphs }) => paragraphs.length > 0);

// Keep authored copy as plain text: Astro escapes every part, including accents.
function decorateParagraph(paragraph: string, rules: readonly ProsePart[] = annotations): ProsePart[] {
  const parts: ProsePart[] = [];
  let cursor = 0;
  while (cursor < paragraph.length) {
    const next = rules
      .map((annotation) => ({ ...annotation, index: paragraph.indexOf(annotation.text, cursor) }))
      .filter(({ index }) => index >= 0)
      .sort((a, b) => a.index - b.index || b.text.length - a.text.length)[0];
    if (!next) {
      parts.push({ text: paragraph.slice(cursor), kind: "text" });
      break;
    }
    if (next.index > cursor) parts.push({ text: paragraph.slice(cursor, next.index), kind: "text" });
    parts.push(next);
    cursor = next.index + next.text.length;
  }
  return parts;
}

---

<section
  class="section-theme-dark ab-section"
  id="about"
  style={`--ab-texture: url("${base}/assets/images/hero-background-gold-alternative.png")`}
>
  <div class="section-inner ab-inner">
    <div class="ab-body">
      <div class="ab-content">
        <!-- The title keeps its existing reveal; the biography is readable immediately. -->
        <header class="ab-cover">
          <h2 class:list={["ab-title", "rd-reveal", { "ab-title--art": !!titleImage }]}>
            {titleImage ? (
              <>
                <span class="ab-title-text">{about.aboutMe.title}</span>
                <span class="ab-title-art" style={titleImageStyle} aria-hidden="true">
                  <img
                    class="ab-title-image"
                    src={`${base}${titleImage.src}`}
                    alt=""
                    width={titleImage.width}
                    height={titleImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </>
            ) : about.aboutMe.title}
          </h2>
          <div class="ab-cover-prose">
            {proseGroups.map((group) => (
              <section
                class="ab-prose-group"
                aria-labelledby={group.headingId}
              >
                <h3 class="ab-group-title" id={group.headingId}>{group.title}</h3>
                <div class="ab-prose-copy">
                  {group.paragraphs.map((paragraph, groupIndex) => {
                    const index = group.offset + groupIndex;
                    return (
                      <p class:list={{ "ab-lead": index === 0, "ab-languages": index === 2 }}>
                        {decorateParagraph(paragraph).map((part) => (
                          part.kind === "strong" ? <strong>{part.text}</strong> :
                          part.kind === "closing" ? <span class="ab-closing-line">{part.text}</span> :
                          part.kind === "link" ? (
                            <a class="ab-inline-link" href={part.href} target="_blank" rel="noopener noreferrer">
                              {decorateParagraph(part.text, strongAnnotations).map((bit) => (
                                bit.kind === "strong" ? <strong>{bit.text}</strong> : bit.text
                              ))}
                            </a>
                          ) : part.kind === "emoji" ? (
                            <span class="ab-icon-word"><span class="ab-emoji" aria-hidden="true">{part.symbol}</span>{part.text}</span>
                          ) : part.kind === "location" ? (
                            <strong class="ab-location">
                              <img class="ab-flag" src={`${base}/assets/icons/flags/es.svg`} alt="" aria-hidden="true" />
                              <span class="ab-spain-text">{part.text}</span>
                            </strong>
                          ) : part.kind === "flag" ? (
                            <span class="ab-icon-word">
                              <img class="ab-flag" src={`${base}/assets/icons/flags/${part.country}.svg`} alt="" aria-hidden="true" />
                              {part.text}
                            </span>
                          ) : part.text
                        ))}
                      </p>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </header>

        <section class="ab-skills" aria-labelledby="ab-skills-heading">
          <h3 id="ab-skills-heading" class="ab-section-title">{about.skillsTitle}</h3>
          <div class="ab-stack">
            {about.skillGroups.map((group) => (
              <section class="ab-stack-group" aria-labelledby={`ab-stack-${group.id}`}>
                <h4 class="ab-stack-category" id={`ab-stack-${group.id}`}>{group.title}</h4>
                <ul class="ab-stack-items">
                  {group.items.map(([name, icon]) => (
                    <li class="ab-stack-item">
                      <span class="ab-stack-icon" aria-hidden="true">
                        {icon && <img src={`${base}/assets/skills/${icon}`} alt="" width="48" height="48" loading="lazy" decoding="async" />}
                      </span>
                      <span>{name}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>


<style>
  .ab-section {
    position: relative;
    /* Let the content and backdrop straddle the pinned Hero's z-index.
       Isolating this section would trap both beneath its opaque backdrop. */
    --ab-blend-height: clamp(10rem, 20svh, 14rem);
    --ab-accent: var(--color-brand-gold);
    --ab-copy: #d4d6d8;
    --theme-text: #f3f4f5;
    --theme-text-muted: #adb2b6;
    --theme-border: rgb(196 204 209 / 18%);
    --theme-surface: rgb(255 255 255 / 4%);
    --theme-surface-strong: rgb(255 255 255 / 8%);
    /* Preserve the Hero seam, then keep warm graphite through the stack. */
    background:
      repeating-linear-gradient(
        0deg,
        rgb(255 255 255 / 0.8%) 0 1px,
        transparent 1px 4px
      ),
      linear-gradient(
        180deg,
        var(--section-dark-start) 0,
        #24221f var(--ab-blend-height),
        #24221f 100%
      );
  }

  /* Reuse the Hero asset; only its decorative layer is desaturated.
     Feather both edges to avoid a hard seam during the Hero crossfade. */
  .ab-section::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: min(1400px, 100%);
    z-index: 0;
    pointer-events: none;
    background-image: var(--ab-texture);
    background-size: cover;
    background-position: center top;
    filter: grayscale(1) brightness(0.65);
    opacity: 0.12;
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 var(--ab-blend-height),
      rgb(0 0 0 / 80%) 45%,
      transparent 100%
    );
  }

  .ab-inner {
    position: relative;
    z-index: 3;
    display: block;
  }

  .ab-body {
    display: block;
  }

  .ab-content {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  /* ---------------------------------------------------------------------
     Cover
     --------------------------------------------------------------------- */
  .ab-cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, 66rem);
    margin-inline: auto;
    justify-items: start;
    text-align: left;
    gap: clamp(1.5rem, 2vw, 2rem);
  }

  .ab-cover-prose {
    width: min(100%, 66rem);
    text-align: left;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.1vw, 1.2rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.8;
  }

  .ab-title {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--theme-text);
  }

  .ab-title--art {
    width: min(100%, 40rem);
  }

  /* A static glow follows the title at every breakpoint, without moving it. */
  .ab-title::before {
    content: "";
    position: absolute;
    inset: -55% 0 -70%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 45%,
      rgb(193 155 61 / 15%) 0,
      rgb(193 155 61 / 6%) 40%,
      transparent 72%
    );
  }

  .ab-title-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ab-title-art {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .ab-title-image {
    position: absolute;
    display: block;
    width: var(--ab-title-image-width);
    max-width: none;
    height: auto;
    left: var(--ab-title-image-left);
    top: var(--ab-title-image-top);
    /* Show the original gold artwork without changing its crop or geometry. */
  }

  .ab-cover-prose p {
    color: var(--ab-copy);
    margin: 0;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .ab-prose-group {
    display: grid;
    gap: 1.5rem;
  }

  .ab-prose-group:first-child {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--theme-border);
  }

  .ab-prose-copy {
    min-width: 0;
    max-width: 58ch;
    width: 100%;
  }

  .ab-cover-prose p + p {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .ab-prose-group + .ab-prose-group {
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--theme-border);
  }

  .ab-group-title {
    margin: 0;
    color: var(--ab-accent);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-wrap: balance;
  }

  .ab-cover-prose p.ab-lead {
    font-size: clamp(1.2rem, 1.4vw, 1.5rem);
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: var(--theme-text);
  }

  .ab-cover-prose p.ab-languages {
    font-size: 0.95em;
    color: var(--theme-text-muted);
  }

  .ab-closing-line {
    display: block;
    max-width: 34ch;
    margin: 1.75rem 0 0;
    padding-inline-start: 1.25rem;
    border-inline-start: 2px solid var(--ab-accent);
    color: var(--theme-text);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.8vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
    text-wrap: balance;
  }

  .ab-cover-prose strong {
    color: var(--theme-text);
    font-weight: 600;
  }

  .ab-inline-link {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(196 204 209 / 45%);
    text-underline-offset: 0.2em;
    text-decoration-skip-ink: auto;
    transition: text-decoration-color 0.2s ease;
  }

  .ab-inline-link:hover,
  .ab-inline-link:focus-visible {
    text-decoration-color: var(--theme-text);
  }

  .ab-inline-link:focus-visible {
    outline: 2px solid var(--ab-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ab-flag {
    display: inline-block;
    width: 1.15em;
    height: 0.77em;
    margin-inline-end: 0.35em;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 2px;
    vertical-align: -0.02em;
  }

  .ab-location {
    font-weight: 600;
  }

  .ab-spain-text {
    color: inherit;
  }

  .ab-emoji {
    display: inline-block;
    margin-inline-end: 0.3em;
    font-size: 0.85em;
    vertical-align: 0.04em;
    filter: grayscale(1);
  }

  .ab-icon-word {
    white-space: normal;
  }

  .ab-skills {
    width: min(100%, 66rem);
    margin-inline: auto;
  }

  .ab-section-title {
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    text-align: left;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    letter-spacing: -0.015em;
    text-transform: none;
    color: var(--ab-accent);
    line-height: 1.15;
    text-wrap: balance;
  }

  /* Compact reference rows keep the stack secondary to the biography. */
  .ab-stack-group {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.23fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
    padding-block: 0.9rem;
    border-top: 1px solid var(--theme-border);
  }

  .ab-stack-group:last-child {
    border-bottom: 1px solid var(--theme-border);
  }

  .ab-stack-category {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--theme-text);
    overflow-wrap: anywhere;
  }

  .ab-stack-items {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin: 0;
    padding: 0;
  }

  .ab-stack-item {
    display: flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    gap: 0.5rem;
    color: var(--ab-copy);
    font-size: 0.85rem;
    line-height: 1.35;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .ab-stack-icon {
    display: grid;
    place-items: center;
    flex: 0 0 1.75rem;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.3rem;
    border-radius: 0.4rem;
    background: #ebebeb;
  }

  .ab-stack-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 1200px) {
    :global(body.redesign-home) .ab-inner {
      /* Sidebar width includes transparent padding. Center in the space
         from its visible cards' right edge to the page's right edge. */
      max-width: none;
      margin-inline-start: calc(var(--hx-sidebar-width) - var(--hx-sidebar-padding-inline));
      margin-inline-end: 0;
      padding-inline: 2rem;
    }

    .ab-body {
      max-width: calc(var(--container) - 4rem);
      margin-inline: auto;
    }

    .ab-cover,
    .ab-prose-group {
      grid-template-columns: minmax(9rem, 0.27fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }

    .ab-title {
      grid-column: 2;
      justify-self: start;
    }

    .ab-cover-prose {
      grid-column: 1 / -1;
    }

    .ab-group-title {
      max-width: 14ch;
      padding-block-start: 0.15em;
    }
  }

  @media (max-width: 899px) {
    .ab-stack-group {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  @media (max-width: 640px) {
    .ab-stack-items {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem 0.75rem;
    }
  }
</style>
