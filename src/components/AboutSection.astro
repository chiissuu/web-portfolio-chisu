---
import { Blocks, TrendingUp, Lightbulb, Zap } from "lucide-astro";
import type { AboutSectionContent } from "../lib/content-types";

interface Props {
  t: AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const about = t.about;

// Keep the existing scene keys while sharing About's neutral accent.
const TONE_COLORS: Record<string, string> = {
  cyan: "var(--ab-accent)",
  violet: "var(--ab-accent)",
  gold: "var(--ab-accent)",
  coral: "var(--ab-accent)",
};

const SCENE_ICONS: Record<string, typeof Blocks> = {
  foundations: Blocks,
  direction: TrendingUp,
  product: Lightbulb,
  drive: Zap,
};

// Styling hints only: source copy remains in site.js, in both languages.
const SCENE_EMPHASIS: Record<string, readonly string[]> = {
  foundations: ["Java", "MegatronixOS", "Astro"],
  direction: ["Data Science", "machine learning"],
  product: ["modelos de negocio", "diseño gráfico", "business models", "graphic design"],
  drive: ["rendimiento colectivo", "experiencia de usuario", "collective performance", "user experience"],
};

// Preserve every sentence and its order. Foundations groups its opening
// two sentences, then gives each project/conclusion a separate paragraph.
// The last group size repeats; other scenes keep pairs of sentences.
function splitIntoBlocks(text: string, groupSizes: readonly number[] = [2]): string[] {
  const sentences = text.split(/(?<=[.!?])\s+/);
  const blocks: string[] = [];
  for (let i = 0; i < sentences.length;) {
    const size = groupSizes[Math.min(blocks.length, groupSizes.length - 1)];
    blocks.push(sentences.slice(i, i + size).join(" "));
    i += size;
  }
  return blocks;
}

// Render ordinary text/strong nodes rather than injecting HTML from copy.
function emphasize(text: string, sceneId: string) {
  const phrases = SCENE_EMPHASIS[sceneId] ?? [];
  if (!phrases.length) return [{ text, strong: false }];
  const pattern = phrases.map((phrase) => phrase.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|");
  return text.split(new RegExp(`(${pattern})`, "gi")).map((part) => ({
    text: part,
    strong: phrases.some((phrase) => phrase.toLowerCase() === part.toLowerCase()),
  }));
}

const formacionFacts = [
  { label: about.formacion.labels.institution, value: about.formacion.entry.institution },
  { label: about.formacion.labels.program, value: about.formacion.entry.program },
  { label: about.formacion.labels.specialization, value: about.formacion.entry.specialization },
  { label: about.formacion.labels.status, value: about.formacion.entry.status },
];
---

<section
  class="section-theme-dark ab-section"
  id="about"
  style={`--ab-texture: url("${base}/assets/images/hero-background-gold-alternative.png")`}
>
  <div class="section-inner ab-inner">
    <div class="ab-body">
      <div class="ab-content">
        <!-- 1. Typographic cover — no card/button treatment, no
             SectionHeadingCard. `SOBRE MÍ`/`ABOUT ME` is an editorial
             eyebrow label, not a second heading; the single semantic <h2>
             is the stacked 3-line title. A single column (heading
             block followed by prose) gives the introduction the width it needs.
             Center this introduction in the space beside the sidebar. -->
        <header class="ab-cover rd-reveal">
          <div class="ab-cover-heading">
            <p class="ab-eyebrow">{about.aboutMe.eyebrow}</p>
            <h2 class="ab-title">
              {about.aboutMe.titleLines.map((line) => (
                <span class="ab-title-line">
                  {line.map((seg) => (
                    <span class:list={["ab-title-seg", seg.tone && `ab-tone-${seg.tone}`]}>{seg.text}</span>
                  ))}
                </span>
              ))}
            </h2>
            <p class="ab-language-line">{about.aboutMe.languageLine}</p>
          </div>
          <div class="ab-cover-prose editorial-text">
            {splitIntoBlocks(about.aboutMe.paragraphs[0]).map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </header>

        <!-- 2. The four editorial scenes retain their existing anchors. -->
        <div class="ab-scenes">
          {about.scenes.map((scene) => {
            const SceneIcon = SCENE_ICONS[scene.id] ?? Blocks;
            const paragraphs = scene.paragraphs.flatMap((paragraph) =>
              splitIntoBlocks(paragraph, scene.id === "foundations" ? [2, 1] : [2])
            );
            return (
            <section
              class:list={[
                "ab-scene",
                "rd-reveal",
                { "ab-scene-reverse": scene.id === "direction" || scene.id === "drive" },
              ]}
              id={`about-scene-${scene.id}`}
              aria-labelledby={`ab-scene-${scene.id}-heading`}
              style={`--ab-tone: ${TONE_COLORS[scene.tone]}`}
            >
              <div class="ab-scene-grid">
                <div class="ab-scene-copy">
                  <div class="ab-scene-head">
                    <span class="ab-scene-icon" aria-hidden="true"><SceneIcon size={22} stroke-width={1.6} /></span>
                    <h3 id={`ab-scene-${scene.id}-heading`} class="ab-scene-title">{scene.title}</h3>
                  </div>
                  <p class="ab-scene-highlight">{scene.highlight}</p>
                  <div class="ab-scene-prose editorial-text">
                    {paragraphs.map((paragraph) => (
                      <p>{emphasize(paragraph, scene.id).map((part) => (
                        part.strong ? <strong>{part.text}</strong> : part.text
                      ))}</p>
                    ))}
                    {scene.cta && (
                      <a
                        class="ab-cta-btn"
                        href={scene.cta.href}
                        aria-label={scene.cta.ariaLabel}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {scene.cta.label}
                      </a>
                    )}
                  </div>
                </div>

                <!-- Compact visuals share a top alignment; reading order
                     stays copy first, visual second on smaller screens. -->
                <div class="ab-scene-visual">
                  {scene.networkBranches && (
                    <div class="ab-network">
                      <p class="ab-network-hub">{scene.networkHub}</p>
                      <ul class="ab-network-branches">
                        {scene.networkBranches.map((branch) => (
                          <li class="ab-network-branch">
                            <p class="ab-network-tech">{branch.tech}</p>
                            <p class="ab-network-project">{branch.project}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {scene.pipeline && (
                    <div class="ab-pipeline">
                      {scene.pipeline.flatMap((stage, i) =>
                        i < scene.pipeline!.length - 1
                          ? [
                              <span class="ab-pipeline-stage">{stage}</span>,
                              <span class="ab-pipeline-arrow" aria-hidden="true">&#8595;</span>,
                            ]
                          : [<span class="ab-pipeline-stage">{stage}</span>]
                      )}
                    </div>
                  )}

                  {scene.triangleVertices && (
                    <div class="ab-triangle">
                      <svg class="ab-triangle-shape" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                        <polygon points="50,20 15,78 85,78"></polygon>
                      </svg>
                      <span class="ab-triangle-vertex ab-triangle-top">{scene.triangleVertices[0]}</span>
                      <span class="ab-triangle-vertex ab-triangle-left">{scene.triangleVertices[1]}</span>
                      <span class="ab-triangle-vertex ab-triangle-right">{scene.triangleVertices[2]}</span>
                      <span class="ab-triangle-center">{scene.triangleCenter}</span>
                    </div>
                  )}

                  {scene.words && (
                    <ul class="ab-word-cluster">
                      {scene.words.map((word) => <li class="ab-word">{word}</li>)}
                    </ul>
                  )}
                </div>
              </div>
            </section>
            );
          })}
        </div>

        <!-- 3. Formación + Idiomas — closes the personal-profile half of
             the section before Skills takes over as the visual culmination. -->
        <section class="ab-foundation rd-reveal" aria-labelledby="ab-foundation-heading">
          <h3 id="ab-foundation-heading" class="ab-section-title">{about.foundationTitle}</h3>
          <div class="ab-foundation-grid">
            <a
              class="ab-formacion-card"
              href={about.formacion.entry.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <p class="ab-foundation-label">{about.formacion.title}</p>
              <dl class="ab-formacion-facts">
                {formacionFacts.map((fact) => (
                  <div class="ab-formacion-fact">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
              <span class="ab-formacion-arrow" aria-hidden="true">&#8599;</span>
            </a>

            <div class="ab-idiomas-card">
              <p class="ab-foundation-label">{about.idiomas.title}</p>
              <ul class="ab-languages">
                {about.idiomas.items.map((item) => (
                  <li class="ab-language-chip">
                    <span class="ab-language-name">{item.language}</span>
                    <span class="ab-language-level">{item.level}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- 4. Skills — the section's bento culmination and closing block.
             No CTA after this — About ends here and Proyectos begins
             immediately (see the corrective pass's CTA removal). -->
        <section class="ab-skills rd-reveal" aria-labelledby="ab-skills-heading">
          <h3 id="ab-skills-heading" class="ab-section-title">{about.skillsTitle}</h3>
          <div class="ab-bento">
            {about.skillGroups.map((group) => (
              <div class={`ab-bento-card ab-bento-${group.id}`}>
                <p class="ab-bento-title">{group.title}</p>
                <div class="ab-bento-tags">
                  {group.items.map(([name, icon]) => (
                    <span class="ab-bento-tag">
                      {icon && <img src={`${base}/assets/skills/${icon}`} alt="" aria-hidden="true" />}
                      {name}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>


<style>
  .ab-section {
    position: relative;
    /* Let the content and backdrop straddle the pinned Hero's z-index.
       Isolating this section would trap both beneath its opaque backdrop. */
    --ab-blend-height: clamp(10rem, 20svh, 14rem);
    --ab-accent: #c9c9c9;
    --theme-text: #f2f2f2;
    --theme-text-muted: #bdbdbd;
    --theme-border: rgb(255 255 255 / 18%);
    --theme-surface: rgb(255 255 255 / 4%);
    --theme-surface-strong: rgb(255 255 255 / 8%);
    /* Match the exposed Hero wrapper at the section edge, then gradually
       introduce charcoal. The texture below must also start transparent. */
    background: linear-gradient(
      180deg,
      var(--section-dark-start) 0,
      #191919 var(--ab-blend-height),
      #121212 1400px,
      #0d0d0d 100%
    );
  }

  /* Reuse the Hero asset; only its decorative layer is desaturated.
     Feather both edges to avoid a hard seam during the Hero crossfade. */
  .ab-section::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: min(1400px, 100%);
    z-index: 0;
    pointer-events: none;
    background-image: var(--ab-texture);
    background-size: cover;
    background-position: center top;
    filter: grayscale(1) brightness(0.65);
    opacity: 0.55;
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 var(--ab-blend-height),
      rgb(0 0 0 / 80%) 45%,
      transparent 100%
    );
  }

  .ab-inner {
    position: relative;
    z-index: 3;
    display: block;
  }

  .ab-body {
    display: block;
  }

  .ab-content {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  /* ---------------------------------------------------------------------
     Cover
     --------------------------------------------------------------------- */
  .ab-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  .ab-cover-heading {
    width: 100%;
  }

  .ab-cover-prose {
    width: min(100%, 60ch);
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    line-height: 1.65;
  }

  .ab-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ab-accent);
    margin: 0 0 1.1rem;
  }

  .ab-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.98;
  }

  .ab-title-line {
    display: block;
    font-size: clamp(2.1rem, 6.4vw, 4.6rem);
  }

  .ab-title-seg {
    color: var(--theme-text);
  }

  .ab-tone-cool {
    color: var(--ab-accent);
  }

  .ab-tone-gold {
    color: var(--ab-accent);
  }

  .ab-language-line {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    letter-spacing: 0.04em;
    color: var(--theme-text-muted);
    margin: 0;
  }

  .ab-cover-prose p {
    color: var(--theme-text);
    max-width: 62ch;
    margin-inline: auto;
  }

  .ab-cover-prose p + p {
    margin-top: 1.4rem;
  }

  /* ---------------------------------------------------------------------
     Scenes
     --------------------------------------------------------------------- */
  .ab-scenes {
    display: flex;
    flex-direction: column;
  }

  .ab-scene {
    display: flex;
    flex-direction: column;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--theme-border);
    padding-bottom: clamp(2.5rem, 4vw, 4rem);
  }

  .ab-scenes .ab-scene:first-child {
    padding-top: 0;
    border-top: none;
  }

  .ab-scene-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .ab-scene-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--theme-surface-strong);
    border: 1px solid var(--theme-border);
    color: var(--ab-tone);
    line-height: 1;
  }

  .ab-scene-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    letter-spacing: -0.01em;
    color: var(--theme-text);
  }

  .ab-scene-highlight {
    margin: 0 0 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--ab-tone);
    max-width: 60ch;
    font-family: var(--font-editorial);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--theme-text);
  }

  .ab-scene-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .ab-scene-copy {
    min-width: 0;
  }

  .ab-scene-prose {
    max-width: 60ch;
    line-height: 1.7;
  }

  .ab-scene-prose strong {
    font-weight: 600;
    color: var(--theme-text);
  }

  .ab-scene-prose p {
    color: var(--theme-text-muted);
    max-width: 62ch;
  }

  .ab-scene-prose p + p {
    margin-top: 1.25rem;
  }

  .ab-scene-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: start;
    width: 100%;
    max-width: 24rem;
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--theme-border);
    border-radius: 16px;
    background: var(--theme-surface);
  }

  .ab-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 1.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--theme-border);
    background: var(--theme-surface-strong);
    color: var(--theme-text);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .ab-cta-btn:hover,
  .ab-cta-btn:focus-visible {
    transform: translateY(-2px);
    border-color: var(--ab-tone, var(--ab-accent));
  }

  /* --- Scene 1: three project cards joined by a discreet spine -------- */
  .ab-network {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .ab-network-hub {
    margin: 0 0 1.25rem;
    color: var(--theme-text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ab-network-branches {
    width: 100%;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 1px solid var(--theme-border);
  }

  .ab-network-branch {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem;
    border: 1px solid var(--theme-border);
    border-radius: 10px;
    background: var(--theme-surface);
  }

  .ab-network-branch::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -1rem;
    width: 1rem;
    height: 1px;
    background: var(--theme-border);
  }

  .ab-network-tech {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ab-tone);
  }

  .ab-network-project {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--theme-text-muted);
  }

  /* --- Scene 2: equal-width stages, with arrows on the shared axis ----- */
  .ab-pipeline {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .ab-pipeline-stage {
    width: 100%;
    text-align: center;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--ab-tone);
    border-radius: 10px;
    background: var(--theme-surface);
    color: var(--theme-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }

  .ab-pipeline-arrow {
    color: var(--ab-tone);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* --- Scene 3: triangle ------------------------------------------------ */
  .ab-triangle {
    position: relative;
    width: 100%;
    height: 16rem;
  }

  .ab-triangle-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ab-triangle-shape polygon {
    fill: none;
    stroke: var(--ab-tone);
    stroke-width: 0.6;
    opacity: 0.7;
  }

  .ab-triangle-vertex {
    position: absolute;
    max-width: 8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--theme-text);
    text-align: center;
  }

  .ab-triangle-top {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .ab-triangle-left {
    bottom: 0;
    left: 0;
  }

  .ab-triangle-right {
    bottom: 0;
    right: 0;
  }

  .ab-triangle-center {
    position: absolute;
    top: 62%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8.5rem;
    max-width: 60%;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    background: var(--theme-surface-strong);
    border: 1px solid var(--ab-tone);
    color: var(--theme-text);
    font-weight: 700;
    font-size: 0.72rem;
    text-align: center;
    line-height: 1.25;
  }

  @media (max-width: 640px) {
    .ab-triangle {
      height: auto;
    }

    .ab-triangle-shape {
      display: none;
    }

    .ab-triangle {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }

    .ab-triangle-vertex,
    .ab-triangle-center {
      position: static;
      transform: none !important;
      max-width: none;
    }
  }

  /* --- Scene 4: six concepts with equal visual weight ----------------- */
  .ab-word-cluster {
    width: 100%;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 0;
    margin: 0;
  }

  .ab-word {
    min-width: 0;
    padding: 0.85rem 0.4rem;
    border: 1px solid var(--theme-border);
    border-radius: 8px;
    background: var(--theme-surface);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.85rem);
    font-weight: 600;
    color: var(--theme-text);
    text-align: center;
    line-height: 1.4;
  }

  /* ---------------------------------------------------------------------
     Formación + Idiomas
     --------------------------------------------------------------------- */
  .ab-section-title {
    margin: 0 0 1.75rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    letter-spacing: -0.01em;
    color: var(--theme-text);
  }

  .ab-foundation-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .ab-foundation-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
  }

  .ab-formacion-card {
    display: block;
    position: relative;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ab-formacion-card:hover,
  .ab-formacion-card:focus-visible {
    border-color: var(--ab-accent);
    transform: translateY(-2px);
  }

  .ab-formacion-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }

  .ab-formacion-fact dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
    margin-bottom: 0.25rem;
  }

  .ab-formacion-fact dd {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 0.95rem;
    color: var(--theme-text);
  }

  .ab-formacion-arrow {
