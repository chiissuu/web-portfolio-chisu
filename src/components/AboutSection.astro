---
import type { AboutSectionContent } from "../lib/content-types";
import SectionHeadingCard from "./SectionHeadingCard.astro";

interface Props {
  t: AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const about = t.about;
---

<section class="section-theme-dark" id="about">
  <div class="section-inner ab-inner">
    <!-- 1. Sobre mí / About Me -->
    <header class="ab-block ab-intro rd-reveal">
      <p class="ab-eyebrow">{about.aboutMe.eyebrow}</p>
      <SectionHeadingCard text={about.aboutMe.title} as="h2" size="lg" />
      <div class="ab-prose editorial-text">
        {about.aboutMe.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </header>

    <!-- 2. Beyond Software Engineering -->
    <section class="ab-block rd-reveal" aria-labelledby="ab-beyond-heading">
      <h3 id="ab-beyond-heading" class="ab-subheading">{about.beyondSoftwareEngineering.heading}</h3>
      <div class="ab-prose editorial-text">
        {about.beyondSoftwareEngineering.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a class="ab-cta-btn" href={about.designArchiveHref} target="_blank" rel="noopener noreferrer">
        {about.beyondSoftwareEngineering.gfxButtonLabel}
      </a>
    </section>

    <!-- 3. Personal Background -->
    <section class="ab-block rd-reveal" aria-labelledby="ab-background-heading">
      <h3 id="ab-background-heading" class="ab-subheading">{about.personalBackground.heading}</h3>
      <div class="ab-prose editorial-text">
        {about.personalBackground.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a
        class="ab-cta-btn"
        href={about.personalBackground.esportsHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {about.personalBackground.esportsButtonLabel}
      </a>
      <div class="ab-prose editorial-text ab-prose-after-cta">
        <p>{about.personalBackground.closingParagraph}</p>
      </div>
    </section>

    <!-- 4. Current Focus -->
    <section class="ab-block rd-reveal" aria-labelledby="ab-focus-heading">
      <h3 id="ab-focus-heading" class="ab-subheading">{about.currentFocus.heading}</h3>
      <ul class="ab-focus-grid">
        {about.currentFocus.items.map((item) => (
          <li class="ab-focus-item editorial-text">{item}</li>
        ))}
      </ul>
    </section>

    <!-- 5. Skills — content/organization unchanged, only the presentation. -->
    <section class="ab-block rd-reveal" aria-labelledby="ab-skills-heading">
      <SectionHeadingCard text={about.skillsTitle} as="h3" size="md" />
      <div class="ab-skills-grid">
        {about.skillGroups.map((group) => (
          <div class="ab-skill-card">
            <p class="ab-skill-card-title">{group.title}</p>
            <div class="ab-skill-tags">
              {group.items.map(([name, icon]) => (
                <span>
                  {icon && <img src={`${base}/assets/skills/${icon}`} alt="" aria-hidden="true" />}
                  {name}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Formación -->
    <section class="ab-block rd-reveal" aria-labelledby="ab-formacion-heading">
      <SectionHeadingCard text={about.formacion.title} as="h3" size="md" />
      <a
        class="ab-formacion-card"
        href={about.formacion.entry.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="editorial-text">{about.formacion.entry.text}</span>
        <span class="ab-formacion-arrow" aria-hidden="true">&#8599;</span>
      </a>
    </section>

    <!-- 7. Idiomas -->
    <section class="ab-block rd-reveal" aria-labelledby="ab-idiomas-heading">
      <SectionHeadingCard text={about.idiomas.title} as="h3" size="md" />
      <ul class="ab-languages">
        {about.idiomas.items.map((item) => (
          <li class="ab-language-chip">{item}</li>
        ))}
      </ul>
    </section>
  </div>
</section>

<style>
  /* Layout.astro's shared `.section-theme-dark` background (`is:global`)
     is a 3-stop vertical gradient (dark -> slightly lighter center ->
     dark) computed against EACH section's own total height. About is by
     far the tallest `.section-theme-dark` section (7 stacked content
     blocks), and that combination produces a visible horizontal
     discontinuity partway down, around the "Más allá de la Ingeniería
     del Software" block. The shared rule itself lives in Layout.astro,
     outside this pass's authorized file scope, and editing it directly
     would also repaint Projects/Servicios y Tools/Contacto/FAQ — none of
     which were reported as broken and none of which are in scope here.
     Astro's automatic style scoping solves both problems at once: a
     same-selector rule written in THIS component's own <style> block
     only ever matches the <section> this component itself renders (Astro
     attaches a component-specific attribute to it), so it can never
     affect the other four sections that reuse the same shared class, and
     it never touches Layout.astro. Replacing the height-dependent
     gradient with its own solid start/end color is the one change that
     provably guarantees zero internal seam regardless of the section's
     total height — a flat color has no internal variation to produce a
     discontinuity from. The decorative center-lightening effect is
     dropped rather than reproduced in another form, since guaranteed
     continuity was the explicit requirement, not preserving the vignette. */
  .section-theme-dark {
    background: var(--section-dark-start);
  }

  .ab-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .ab-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
    margin-bottom: 1rem;
  }

  .ab-subheading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
    color: var(--theme-text);
  }

  .ab-prose p {
    color: var(--theme-text-muted);
  }

  .ab-prose p + p {
    margin-top: 1.1rem;
  }

  .ab-prose-after-cta {
    margin-top: 1.5rem;
  }

  .ab-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 1.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--theme-border);
    background: var(--theme-surface-strong);
    color: var(--theme-text);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .ab-cta-btn:hover,
  .ab-cta-btn:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-brand-gold);
  }

  .ab-focus-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .ab-focus-item {
    max-width: none;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--theme-border);
    border-radius: 10px;
    background: var(--theme-surface);
    color: var(--theme-text-muted);
    position: relative;
    padding-left: 1.6rem;
  }

  .ab-focus-item::before {
    content: "";
    position: absolute;
    left: 0.9rem;
    top: 1.15rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-gold);
  }

  .ab-skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .ab-skill-card {
    padding: 1.1rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ab-skill-card:hover {
    border-color: var(--color-brand-gold);
    transform: translateY(-3px);
  }

  .ab-skill-card-title {
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
    color: var(--theme-text);
  }

  .ab-skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ab-skill-tags span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: var(--theme-surface-strong);
    color: var(--theme-text-muted);
    font-size: 0.78rem;
  }

  .ab-skill-tags img {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  .ab-formacion-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ab-formacion-card:hover,
  .ab-formacion-card:focus-visible {
    border-color: var(--color-brand-gold);
    transform: translateY(-2px);
  }

  .ab-formacion-card .editorial-text {
    max-width: 60ch;
    color: var(--theme-text);
  }

  .ab-formacion-arrow {
    flex-shrink: 0;
    font-size: 1.3rem;
    color: var(--color-brand-gold);
  }

  .ab-languages {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .ab-language-chip {
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    background: var(--theme-surface);
    color: var(--theme-text);
    font-family: var(--font-editorial);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .ab-skills-grid,
    .ab-focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
