---
import type { AboutSectionContent } from "../lib/content-types";

interface Props {
  t: AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const about = t.about;

type ProsePart =
  | { text: string; kind: "text" | "strong" | "location" | "closing" }
  | { text: string; kind: "link"; href: string }
  | { text: string; kind: "emoji"; symbol: string }
  | { text: string; kind: "flag"; country: string };
const accents = about.aboutMe.accents;
const strongAnnotations: ProsePart[] = accents.strong.map((text) => ({ text, kind: "strong" }));
const annotations = ([
  { text: about.aboutMe.closingPhrase, kind: "closing" },
  ...accents.links.map(({ text, href }) => ({ text, href, kind: "link" as const })),
  ...strongAnnotations,
  ...accents.emojis.map(({ text, symbol }) => ({ text, symbol, kind: "emoji" as const })),
  { text: accents.location, kind: "location" },
  ...accents.flags.map(({ text, country }) => ({ text, country, kind: "flag" as const })),
] satisfies ProsePart[]).filter(({ text }) => text.length > 0);

// Preserve authored paragraphs; only their presentation is grouped.
const introParagraphCount = 3;
const proseGroups = [
  {
    headingId: "ab-intro-heading",
    title: about.aboutMe.groupLabels.intro,
    paragraphs: about.aboutMe.paragraphs.slice(0, introParagraphCount),
    offset: 0,
  },
  {
    headingId: "ab-difference-heading",
    title: about.aboutMe.groupLabels.difference,
    paragraphs: about.aboutMe.paragraphs.slice(introParagraphCount),
    offset: introParagraphCount,
  },
].filter(({ paragraphs }) => paragraphs.length > 0);

// Keep authored copy as plain text: Astro escapes every part, including accents.
function decorateParagraph(paragraph: string, rules: readonly ProsePart[] = annotations): ProsePart[] {
  const parts: ProsePart[] = [];
  let cursor = 0;
  while (cursor < paragraph.length) {
    const next = rules
      .map((annotation) => ({ ...annotation, index: paragraph.indexOf(annotation.text, cursor) }))
      .filter(({ index }) => index >= 0)
      .sort((a, b) => a.index - b.index || b.text.length - a.text.length)[0];
    if (!next) {
      parts.push({ text: paragraph.slice(cursor), kind: "text" });
      break;
    }
    if (next.index > cursor) parts.push({ text: paragraph.slice(cursor, next.index), kind: "text" });
    parts.push(next);
    cursor = next.index + next.text.length;
  }
  return parts;
}

---

<section
  class="section-theme-dark ab-section"
  id="about"
  style={`--ab-texture: url("${base}/assets/images/hero-background-gold-alternative.png")`}
>
  <div class="section-inner ab-inner">
    <div class="ab-body">
      <div class="ab-content">
        <!-- Reveal each reading group separately so long mobile prose stays visible. -->
        <header class="ab-cover">
          <h2 class="ab-title rd-reveal">{about.aboutMe.title}</h2>
          <div class="ab-cover-prose editorial-text">
            {proseGroups.map((group) => (
              <section class="ab-prose-group rd-reveal" aria-labelledby={group.headingId}>
                <h3 class="ab-group-title" id={group.headingId}>{group.title}</h3>
                {group.paragraphs.map((paragraph, groupIndex) => {
                  const index = group.offset + groupIndex;
                  return (
                    <p class:list={{ "ab-lead": index === 0 }}>
                      {index === 0 && <span class="ab-emoji" aria-hidden="true">👋</span>}
                      {index === 1 && <span class="ab-emoji" aria-hidden="true">💻</span>}
                      {decorateParagraph(paragraph).map((part) => (
                        part.kind === "strong" ? <strong>{part.text}</strong> :
                        part.kind === "closing" ? <span class="ab-closing-line">{part.text}</span> :
                        part.kind === "link" ? (
                          <a class="ab-inline-link" href={part.href} target="_blank" rel="noopener noreferrer">
                            {decorateParagraph(part.text, strongAnnotations).map((bit) => (
                              bit.kind === "strong" ? <strong>{bit.text}</strong> : bit.text
                            ))}
                          </a>
                        ) : part.kind === "emoji" ? (
                          <span class="ab-icon-word"><span class="ab-emoji" aria-hidden="true">{part.symbol}</span>{part.text}</span>
                        ) : part.kind === "location" ? (
                          <strong class="ab-location">
                            <img class="ab-flag" src={`${base}/assets/icons/flags/es.svg`} alt="" aria-hidden="true" />
                            <span class="ab-spain-text">{part.text}</span>
                          </strong>
                        ) : part.kind === "flag" ? (
                          <span class="ab-icon-word">
                            <img class="ab-flag" src={`${base}/assets/icons/flags/${part.country}.svg`} alt="" aria-hidden="true" />
                            {part.text}
                          </span>
                        ) : part.text
                      ))}
                    </p>
                  );
                })}
              </section>
            ))}
          </div>
        </header>

        <section class="ab-skills" aria-labelledby="ab-skills-heading">
          <h3 id="ab-skills-heading" class="ab-section-title rd-reveal">{about.skillsTitle}</h3>
          <div class="ab-stack">
            {about.skillGroups.map((group) => (
              <section class="ab-stack-group rd-reveal" aria-labelledby={`ab-stack-${group.id}`}>
                <h4 class="ab-stack-category" id={`ab-stack-${group.id}`}>{group.title}</h4>
                <ul class="ab-stack-items">
                  {group.items.map(([name, icon]) => (
                    <li class="ab-stack-item">
                      <span class="ab-stack-icon" aria-hidden="true">
                        {icon && <img src={`${base}/assets/skills/${icon}`} alt="" width="48" height="48" loading="lazy" decoding="async" />}
                      </span>
                      <span>{name}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>


<style>
  .ab-section {
    position: relative;
    /* Let the content and backdrop straddle the pinned Hero's z-index.
       Isolating this section would trap both beneath its opaque backdrop. */
    --ab-blend-height: clamp(10rem, 20svh, 14rem);
    --ab-accent: #c9c9c9;
    --theme-text: #f2f2f2;
    --theme-text-muted: #bdbdbd;
    --theme-border: rgb(255 255 255 / 18%);
    --theme-surface: rgb(255 255 255 / 4%);
    --theme-surface-strong: rgb(255 255 255 / 8%);
    /* Match the exposed Hero wrapper at the section edge, then gradually
       introduce charcoal. The texture below must also start transparent. */
    background: linear-gradient(
      180deg,
      var(--section-dark-start) 0,
      #191919 var(--ab-blend-height),
      #121212 1400px,
      #0d0d0d 100%
    );
  }

  /* Reuse the Hero asset; only its decorative layer is desaturated.
     Feather both edges to avoid a hard seam during the Hero crossfade. */
  .ab-section::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: min(1400px, 100%);
    z-index: 0;
    pointer-events: none;
    background-image: var(--ab-texture);
    background-size: cover;
    background-position: center top;
    filter: grayscale(1) brightness(0.65);
    opacity: 0.55;
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 var(--ab-blend-height),
      rgb(0 0 0 / 80%) 45%,
      transparent 100%
    );
  }

  .ab-inner {
    position: relative;
    z-index: 3;
    display: block;
  }

  .ab-body {
    display: block;
  }

  .ab-content {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  /* ---------------------------------------------------------------------
     Cover
     --------------------------------------------------------------------- */
  .ab-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(3rem, 5vw, 4.5rem);
  }

  .ab-cover-prose {
    width: min(100%, 62ch);
    text-align: left;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.85;
  }

  .ab-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--theme-text);
  }

  .ab-cover-prose p {
    color: #d0d0d0;
    max-width: 62ch;
    margin-inline: auto;
  }

  .ab-cover-prose p + p {
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }

  .ab-prose-group + .ab-prose-group {
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--theme-border);
  }

  .ab-group-title {
    margin: 0 0 2rem;
    color: var(--theme-text);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
    text-wrap: balance;
  }

  .ab-cover-prose p.ab-lead {
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
    line-height: 1.8;
  }

  .ab-closing-line {
    display: block;
    max-width: 32ch;
    margin: 2.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--theme-border);
    color: var(--theme-text);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
    text-wrap: balance;
  }

  .ab-cover-prose strong {
    color: var(--theme-text);
    font-weight: 600;
  }

  .ab-inline-link {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(242 242 242 / 50%);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.2s ease;
  }

  .ab-inline-link:hover,
  .ab-inline-link:focus-visible {
    text-decoration-color: var(--theme-text);
  }

  .ab-inline-link:focus-visible {
    outline: 2px solid var(--ab-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ab-flag {
    display: inline-block;
    width: 1.15em;
    height: 0.77em;
    margin-inline-end: 0.35em;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 2px;
    vertical-align: -0.02em;
  }

  .ab-location {
    display: inline-block;
    white-space: nowrap;
  }

  .ab-spain-text {
    display: inline-block;
    line-height: 1.3;
  }

  @supports (background-clip: text) {
    .ab-spain-text {
      /* Light red/yellow stripes stay legible over the charcoal texture. */
      background-image: linear-gradient(
        180deg,
        #ff9292 0% 25%,
        #ffe599 25% 75%,
        #ff9292 75% 100%
      );
      background-color: #ff9292;
      background-size: 100% 0.85em;
      background-position: center;
      background-repeat: no-repeat;
      background-clip: text;
      color: transparent;
    }
  }

  .ab-emoji {
    display: inline-block;
    margin-inline-end: 0.3em;
    font-size: 0.9em;
    vertical-align: 0.04em;
  }

  .ab-icon-word {
    display: inline-block;
    white-space: nowrap;
  }

  .ab-section-title {
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    letter-spacing: -0.025em;
    color: var(--theme-text);
    line-height: 1.15;
    text-wrap: balance;
  }

  /* Category rows keep the full stack visible without empty bento cards. */
  .ab-stack-group {
    display: grid;
    grid-template-columns: minmax(10rem, 0.24fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--theme-border);
  }

  .ab-stack-group:last-child {
    border-bottom: 1px solid var(--theme-border);
  }

  .ab-stack-category {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--theme-text);
    overflow-wrap: anywhere;
  }

  .ab-stack-items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5rem, 1fr));
    gap: 1.4rem 1rem;
    margin: 0;
    padding: 0;
  }

  .ab-stack-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    color: #d0d0d0;
    font-size: 0.85rem;
    line-height: 1.35;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .ab-stack-icon {
    display: grid;
    place-items: center;
    width: 3.8rem;
    height: 3.8rem;
    padding: 0.7rem;
    border-radius: 1rem;
    background: #ebebeb;
  }

  .ab-stack-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 1200px) {
    :global(body.redesign-home) .ab-inner {
      /* Sidebar width includes transparent padding. Center in the space
         from its visible cards' right edge to the page's right edge. */
      max-width: none;
      margin-inline-start: calc(var(--hx-sidebar-width) - var(--hx-sidebar-padding-inline));
      margin-inline-end: 0;
      padding-inline: 2rem;
    }

    .ab-body {
      max-width: calc(var(--container) - 4rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 899px) {
    .ab-stack-group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .ab-stack-items {
      grid-template-columns: repeat(auto-fit, minmax(4.5rem, 1fr));
    }
  }

  @media (max-width: 640px) {
    .ab-stack-items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 0.6rem;
    }

    .ab-stack-icon {
      width: 3.4rem;
      height: 3.4rem;
    }

    .ab-stack-item {
      font-size: 0.78rem;
    }
  }
</style>
