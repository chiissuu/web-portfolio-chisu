---
import type { AboutSectionContent } from "../lib/content-types";

interface Props {
  t: AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const about = t.about;

type ProsePart =
  | { text: string; kind: "text" | "strong" | "circle" | "underline" | "location" }
  | { text: string; kind: "link"; href: string }
  | { text: string; kind: "emoji"; symbol: string }
  | { text: string; kind: "flag"; country: string };
const accents = about.aboutMe.accents;
const strongAnnotations: ProsePart[] = accents.strong.map((text) => ({ text, kind: "strong" }));
const annotations = ([
  ...accents.links.map(({ text, href }) => ({ text, href, kind: "link" as const })),
  ...strongAnnotations,
  ...accents.circle.map((text) => ({ text, kind: "circle" as const })),
  ...accents.underline.map((text) => ({ text, kind: "underline" as const })),
  ...accents.emojis.map(({ text, symbol }) => ({ text, symbol, kind: "emoji" as const })),
  { text: accents.location, kind: "location" },
  ...accents.flags.map(({ text, country }) => ({ text, country, kind: "flag" as const })),
] satisfies ProsePart[]).filter(({ text }) => text.length > 0);

// Keep authored copy as plain text: Astro escapes every part, including accents.
function decorateParagraph(paragraph: string, rules: readonly ProsePart[] = annotations): ProsePart[] {
  const parts: ProsePart[] = [];
  let cursor = 0;
  while (cursor < paragraph.length) {
    const next = rules
      .map((annotation) => ({ ...annotation, index: paragraph.indexOf(annotation.text, cursor) }))
      .filter(({ index }) => index >= 0)
      .sort((a, b) => a.index - b.index || b.text.length - a.text.length)[0];
    if (!next) {
      parts.push({ text: paragraph.slice(cursor), kind: "text" });
      break;
    }
    if (next.index > cursor) parts.push({ text: paragraph.slice(cursor, next.index), kind: "text" });
    parts.push(next);
    cursor = next.index + next.text.length;
  }
  return parts;
}

const formacionFacts = [
  { label: about.formacion.labels.institution, value: about.formacion.entry.institution },
  { label: about.formacion.labels.program, value: about.formacion.entry.program },
  { label: about.formacion.labels.specialization, value: about.formacion.entry.specialization },
  { label: about.formacion.labels.status, value: about.formacion.entry.status },
];
---

<section
  class="section-theme-dark ab-section"
  id="about"
  style={`--ab-texture: url("${base}/assets/images/hero-background-gold-alternative.png")`}
>
  <div class="section-inner ab-inner">
    <div class="ab-body">
      <div class="ab-content">
        <!-- Three introductory paragraphs followed by the personal profile. -->
        <header class="ab-cover rd-reveal">
          <h2 class="ab-title">{about.aboutMe.title}</h2>
          <div class="ab-cover-prose editorial-text">
            {about.aboutMe.paragraphs.map((paragraph, index) => (
              <p class:list={{ "ab-profile-start": index === 3 }}>
                {index === 0 && <span class="ab-emoji" aria-hidden="true">👋</span>}
                {index === 1 && <span class="ab-emoji" aria-hidden="true">💻</span>}
                {decorateParagraph(paragraph).map((part) => (
                  part.kind === "strong" ? <strong>{part.text}</strong> :
                  part.kind === "link" ? (
                    <a class="ab-inline-link" href={part.href} target="_blank" rel="noopener noreferrer">
                      {decorateParagraph(part.text, strongAnnotations).map((bit) => (
                        bit.kind === "strong" ? <strong>{bit.text}</strong> : bit.text
                      ))}
                    </a>
                  ) : part.kind === "emoji" ? (
                    <span class="ab-icon-word"><span class="ab-emoji" aria-hidden="true">{part.symbol}</span>{part.text}</span>
                  ) : part.kind === "location" ? (
                    <strong class="ab-location">
                      <img class="ab-flag" src={`${base}/assets/icons/flags/es.svg`} alt="" aria-hidden="true" />
                      <span class="ab-spain-text">{part.text}</span>
                    </strong>
                  ) : part.kind === "flag" ? (
                    <span class="ab-icon-word">
                      <img class="ab-flag" src={`${base}/assets/icons/flags/${part.country}.svg`} alt="" aria-hidden="true" />
                      {part.text}
                    </span>
                  ) : part.kind === "circle" ? (
                    <span class="ab-annotation ab-annotation-circle">
                      {part.text}
                      <svg viewBox="0 0 100 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <path pathLength="1" d="M 94 16 C 87 3, 47 1, 20 7 C -3 12, -1 34, 23 39 C 49 44, 89 40, 96 28 C 102 16, 85 5, 61 5" />
                      </svg>
                    </span>
                  ) : part.kind === "underline" ? (
                    <span class="ab-annotation ab-annotation-underline">
                      {part.text}
                      <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <path pathLength="1" d="M 2 6 C 24 2, 53 8, 98 3" />
                      </svg>
                    </span>
                  ) : part.text
                ))}
              </p>
            ))}
          </div>
        </header>

        <!-- 2. Formación + Idiomas — closes the personal-profile half of
             the section before Skills takes over as the visual culmination. -->
        <section class="ab-foundation rd-reveal" aria-labelledby="ab-foundation-heading">
          <h3 id="ab-foundation-heading" class="ab-section-title">{about.foundationTitle}</h3>
          <div class="ab-foundation-grid">
            <a
              class="ab-formacion-card"
              href={about.formacion.entry.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <p class="ab-foundation-label">{about.formacion.title}</p>
              <dl class="ab-formacion-facts">
                {formacionFacts.map((fact) => (
                  <div class="ab-formacion-fact">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
              <span class="ab-formacion-arrow" aria-hidden="true">&#8599;</span>
            </a>

            <div class="ab-idiomas-card">
              <p class="ab-foundation-label">{about.idiomas.title}</p>
              <ul class="ab-languages">
                {about.idiomas.items.map((item) => (
                  <li class="ab-language-chip">
                    <span class="ab-language-name">{item.language}</span>
                    <span class="ab-language-level">{item.level}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- 3. Skills — the section's bento culmination and closing block.
             No CTA after this — About ends here and Proyectos begins
             immediately (see the corrective pass's CTA removal). -->
        <section class="ab-skills rd-reveal" aria-labelledby="ab-skills-heading">
          <h3 id="ab-skills-heading" class="ab-section-title">{about.skillsTitle}</h3>
          <div class="ab-bento">
            {about.skillGroups.map((group) => (
              <div class={`ab-bento-card ab-bento-${group.id}`}>
                <p class="ab-bento-title">{group.title}</p>
                <div class="ab-bento-tags">
                  {group.items.map(([name, icon]) => (
                    <span class="ab-bento-tag">
                      {icon && <img src={`${base}/assets/skills/${icon}`} alt="" aria-hidden="true" />}
                      {name}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>


<style>
  .ab-section {
    position: relative;
    /* Let the content and backdrop straddle the pinned Hero's z-index.
       Isolating this section would trap both beneath its opaque backdrop. */
    --ab-blend-height: clamp(10rem, 20svh, 14rem);
    --ab-accent: #c9c9c9;
    --theme-text: #f2f2f2;
    --theme-text-muted: #bdbdbd;
    --theme-border: rgb(255 255 255 / 18%);
    --theme-surface: rgb(255 255 255 / 4%);
    --theme-surface-strong: rgb(255 255 255 / 8%);
    /* Match the exposed Hero wrapper at the section edge, then gradually
       introduce charcoal. The texture below must also start transparent. */
    background: linear-gradient(
      180deg,
      var(--section-dark-start) 0,
      #191919 var(--ab-blend-height),
      #121212 1400px,
      #0d0d0d 100%
    );
  }

  /* Reuse the Hero asset; only its decorative layer is desaturated.
     Feather both edges to avoid a hard seam during the Hero crossfade. */
  .ab-section::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: min(1400px, 100%);
    z-index: 0;
    pointer-events: none;
    background-image: var(--ab-texture);
    background-size: cover;
    background-position: center top;
    filter: grayscale(1) brightness(0.65);
    opacity: 0.55;
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 var(--ab-blend-height),
      rgb(0 0 0 / 80%) 45%,
      transparent 100%
    );
  }

  .ab-inner {
    position: relative;
    z-index: 3;
    display: block;
  }

  .ab-body {
    display: block;
  }

  .ab-content {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  /* ---------------------------------------------------------------------
     Cover
     --------------------------------------------------------------------- */
  .ab-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  .ab-cover-prose {
    width: min(100%, 60ch);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.75;
  }

  .ab-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--theme-text);
  }

  .ab-cover-prose p {
    color: #d0d0d0;
    max-width: 62ch;
    margin-inline: auto;
  }

  .ab-cover-prose p + p {
    margin-top: 1.25rem;
  }

  .ab-cover-prose p + p.ab-profile-start {
    margin-top: 2.5rem;
  }

  .ab-cover-prose strong {
    color: var(--theme-text);
    font-weight: 600;
  }

  .ab-inline-link {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(242 242 242 / 50%);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.2s ease;
  }

  .ab-inline-link:hover,
  .ab-inline-link:focus-visible {
    text-decoration-color: var(--theme-text);
  }

  .ab-inline-link:focus-visible {
    outline: 2px solid var(--ab-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ab-flag {
    display: inline-block;
    width: 1.15em;
    height: 0.77em;
    margin-inline-end: 0.35em;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 2px;
    vertical-align: -0.02em;
  }

  .ab-location {
    display: inline-block;
    white-space: nowrap;
  }

  .ab-spain-text {
    display: inline-block;
    line-height: 1.3;
  }

  @supports (background-clip: text) {
    .ab-spain-text {
      /* Light red/yellow stripes stay legible over the charcoal texture. */
      background-image: linear-gradient(
        180deg,
        #ff9292 0% 25%,
        #ffe599 25% 75%,
        #ff9292 75% 100%
      );
      background-color: #ff9292;
      background-size: 100% 0.85em;
      background-position: center;
      background-repeat: no-repeat;
      background-clip: text;
      color: transparent;
    }
  }

  .ab-emoji {
    display: inline-block;
    margin-inline-end: 0.3em;
    font-size: 0.9em;
    vertical-align: 0.04em;
  }

  .ab-icon-word,
  .ab-annotation {
    display: inline-block;
    white-space: nowrap;
  }

  .ab-annotation {
    position: relative;
    color: var(--theme-text);
    font-weight: 500;
  }

  .ab-annotation-circle {
    padding-inline: 0.25em;
  }

  .ab-annotation svg {
    position: absolute;
    pointer-events: none;
    overflow: visible;
    fill: none;
    stroke: var(--ab-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ab-annotation path {
    vector-effect: non-scaling-stroke;
  }

  .ab-annotation-circle svg {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ab-annotation-underline svg {
    left: 0;
    bottom: 0.08em;
    width: 100%;
    height: 0.35em;
  }

  /* Reuse the existing one-time reveal. Static strokes remain visible
     when motion is reduced; no new scroll listener or dependency is needed. */
  @media (prefers-reduced-motion: no-preference) {
    .ab-cover.rd-in .ab-annotation path {
      stroke-dasharray: 1;
      animation: ab-draw-accent 0.7s ease-out 0.3s both;
    }

    .ab-cover.rd-in .ab-annotation-underline path {
      animation-delay: 0.6s;
    }
  }

  @keyframes ab-draw-accent {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  /* ---------------------------------------------------------------------
     Formación + Idiomas
     --------------------------------------------------------------------- */
  .ab-section-title {
    margin: 0 0 1.75rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    letter-spacing: -0.01em;
    color: var(--theme-text);
  }

  .ab-foundation-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .ab-foundation-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
  }

  .ab-formacion-card {
    display: block;
    position: relative;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ab-formacion-card:hover,
  .ab-formacion-card:focus-visible {
    border-color: var(--ab-accent);
    transform: translateY(-2px);
  }

  .ab-formacion-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }

  .ab-formacion-fact dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
    margin-bottom: 0.25rem;
  }

  .ab-formacion-fact dd {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 0.95rem;
    color: var(--theme-text);
  }

  .ab-formacion-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    font-size: 1.3rem;
    color: var(--ab-accent);
  }

  .ab-idiomas-card {
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
  }

  .ab-languages {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .ab-language-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    background: var(--theme-surface-strong);
  }

  .ab-language-name {
    font-family: var(--font-editorial);
    font-size: 0.92rem;
    color: var(--theme-text);
  }

  .ab-language-level {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ab-accent);
  }

  /* ---------------------------------------------------------------------
     Skills bento
     --------------------------------------------------------------------- */
  .ab-bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(90px, auto);
    gap: 1rem;
  }

  .ab-bento-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    background: var(--theme-surface);
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .ab-bento-card:hover,
  .ab-bento-card:focus-within {
    border-color: var(--ab-accent);
    background: var(--theme-surface-strong);
    box-shadow: 0 0 20px -10px var(--ab-accent);
  }

  .ab-bento-software,
  .ab-bento-data {
    grid-column: span 2;
    grid-row: span 2;
  }

  .ab-bento-web,
  .ab-bento-databases {
    grid-column: span 2;
    grid-row: span 1;
  }

  .ab-bento-tools,
  .ab-bento-design {
    grid-column: span 2;
    grid-row: span 1;
    padding: 1rem 1.1rem;
  }

  .ab-bento-title {
    margin: 0 0 0.85rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--theme-text);
  }

  .ab-bento-software .ab-bento-title,
  .ab-bento-data .ab-bento-title {
    font-size: 1.1rem;
  }

  .ab-bento-tools .ab-bento-title,
  .ab-bento-design .ab-bento-title {
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .ab-bento-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-content: flex-start;
  }

  .ab-bento-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: var(--theme-surface-strong);
    color: var(--theme-text-muted);
    font-size: 0.78rem;
  }

  .ab-bento-tag img {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  /* Preserve the existing tablet layout alongside the main sidebar. */
  @media (min-width: 900px) {
    .ab-cover {
      display: flex;
      gap: 2rem;
    }

    .ab-foundation-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    :global(body.redesign-home) .ab-inner {
      /* Sidebar width includes transparent padding. Center in the space
         from its visible cards' right edge to the page's right edge. */
      max-width: none;
      margin-inline-start: calc(var(--hx-sidebar-width) - var(--hx-sidebar-padding-inline));
      margin-inline-end: 0;
      padding-inline: 2rem;
    }

    .ab-body {
      max-width: calc(var(--container) - 4rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 899px) {
    .ab-formacion-facts {
      grid-template-columns: 1fr;
    }

    .ab-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ab-bento-software,
    .ab-bento-data,
    .ab-bento-web,
    .ab-bento-databases,
    .ab-bento-tools,
    .ab-bento-design {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .ab-bento {
      grid-template-columns: 1fr;
    }

    .ab-bento-software,
    .ab-bento-data,
    .ab-bento-web,
    .ab-bento-databases,
    .ab-bento-tools,
    .ab-bento-design {
      grid-column: span 1;
    }
  }
</style>
