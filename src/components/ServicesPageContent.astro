---
import ServicesForm from "./ServicesForm.astro";
import type { ServicesSectionContent } from "../lib/content-types";

interface Props {
  t: ServicesSectionContent;
}

const { t } = Astro.props as Props;
const page = t.services.page;
---

<main class="rd-page">
  <section class="rd-section rd-page-hero">
    <p class="rd-eyebrow">{page.eyebrow}</p>
    <h1 class="rd-title">{page.title}</h1>
    <p class="rd-note">{page.intro}</p>
  </section>

  <section class="rd-section rd-page-articles">
    <div class="rd-article-grid">
      {page.articles.map((article) => (
        <article class="rd-article-card rd-reveal">
          <h2>{article.title}</h2>
          <p>{article.text}</p>
          <div class="rd-tags">
            {article.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="rd-section rd-page-form">
    <ServicesForm t={t} />
  </section>
</main>

<style>
  .rd-page-hero {
    border-top: none;
    padding-top: clamp(6rem, 12vw, 8rem);
  }

  .rd-article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .rd-article-card {
    display: flex;
    flex-direction: column;
    min-height: 220px;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
  }

  .rd-article-card h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }

  .rd-article-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .rd-article-card .rd-tags {
    margin-top: auto;
    padding-top: 1.1rem;
  }

  .rd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rd-tags span {
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  @media (max-width: 900px) {
    .rd-article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
