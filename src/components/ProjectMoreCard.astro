---
// Last item of the projects row: a way on to the rest of the work (GitHub).
interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props as Props;
---

<a class="pm-card" href={href} target="_blank" rel="noopener noreferrer">
  <svg class="pm-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
    />
  </svg>
  <span class="pm-label">{label}</span>
  <span class="pm-arrow" aria-hidden="true">&#8599;</span>
</a>

<style>
  .pm-card {
    flex: 0 0 clamp(13rem, 16vw, 17rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    aspect-ratio: 5 / 7;
    padding: 1.5rem;
    border: 2px dashed rgb(122 90 18 / 45%);
    border-radius: 14px;
    text-align: center;
    text-decoration: none;
    color: var(--theme-text);
    background: rgb(255 255 255 / 30%);
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }

  .pm-card:hover,
  .pm-card:focus-visible {
    transform: translateY(-6px);
    border-color: var(--color-brand-gold);
    background: rgb(255 255 255 / 55%);
  }

  .pm-card:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 4px;
  }

  .pm-icon {
    width: 3.2rem;
    height: 3.2rem;
    color: #1c1a17;
  }

  .pm-label {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .pm-arrow {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid transparent;
    border-radius: 50%;
    font-size: 1.15rem;
    color: #1a1406;
    background:
      linear-gradient(180deg, #dfc357, #c19b3d 48%, #b08a32) padding-box,
      linear-gradient(135deg, #efd683 8%, #b08a32 30%, #c19b3d 48%, #efd683 72%, #b08a32) border-box;
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 65%), inset 0 -1px 2px rgb(0 0 0 / 22%), 0 2px 6px rgb(0 0 0 / 40%);
    transition: transform 0.25s ease;
  }

  .pm-card:hover .pm-arrow,
  .pm-card:focus-visible .pm-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 899px) {
    .pm-card {
      flex-basis: min(60vw, 14rem);
    }
  }
</style>
