---
import type { ServicesHomeSectionContent } from "../lib/content-types";
import ShowcaseSection from "./ShowcaseSection.astro";
import ShowcaseCard from "./ShowcaseCard.astro";
import ServiceArt from "./ServiceArt.astro";
import ServicesBridge from "./ServicesBridge.astro";
import ServicesProcess from "./ServicesProcess.astro";

interface Props {
  t: ServicesHomeSectionContent;
}

const { t } = Astro.props as Props;
const copy = t.servicesTools.services;
const articles = t.services.page.articles;
---

<ShowcaseSection
  id="services"
  title={copy.title}
  titleImage={copy.titleImage}
  backdrop="blueprint"
  center
  edge="flat"
  ctaHref="#contact"
  ctaLabel={copy.ctaLabel}
>
  <ServicesBridge slot="bridge" />

  <p slot="intro">
    {copy.description.map((segment) =>
      segment.strong ? <strong>{segment.text}</strong> : segment.text
    )}
  </p>

  {articles.map((article, index) => (
    <ShowcaseCard
      number={String(index + 1).padStart(2, "0")}
      title={article.title}
      text={article.text}
      tags={article.tags}
      arrow={false}
    >
      {article.art && <ServiceArt slot="media" kind={article.art} />}
    </ShowcaseCard>
  ))}

  <ServicesProcess slot="after" process={copy.process} />
  <div slot="after" class="sv-rule" aria-hidden="true"></div>
</ShowcaseSection>

<style is:global>
  /* The first line of the blueprint grid (and the first pulse that runs along
     it) would cross just under the title like an underline: the grid starts
     below the head instead. */
  #services .bd-grid {
    mask-image: linear-gradient(180deg, transparent 0, transparent 21rem, #000 30rem, #000 calc(100% - 22rem), transparent calc(100% - 9rem));
  }

  /* The closing rule: the rails end on it, at their second pair of diamonds;
     the gold button sits under it. */
  #services .sv-rule {
    height: 2px;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: rgb(193 155 61 / 55%);
  }

  /* Room under the button for the gradient out of Servicios into Tools (see
     ToolsBridge, .tb-fade) and for the threads that go round the button. */
  #services .sc-cta {
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: clamp(6rem, 9vw, 8rem);
  }

  #services .bd-pulse[style*="--row:1;"] {
    display: none;
  }

  /* Three cards between the rails: a tighter gap gives each one more width. */
  #services .sc-grid {
    gap: 1.25rem;
  }
</style>
