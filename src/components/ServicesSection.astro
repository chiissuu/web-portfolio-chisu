---
import { withBase } from "../lib/paths.js";
import type { ServicesHomeSectionContent } from "../lib/content-types";
import ShowcaseSection from "./ShowcaseSection.astro";
import ShowcaseCard from "./ShowcaseCard.astro";

interface Props {
  t: ServicesHomeSectionContent;
}

const { t } = Astro.props as Props;
const servicesHref = withBase("/servicios/");
const copy = t.servicesTools.services;
const articles = t.services.page.articles;
---

<ShowcaseSection
  id="services"
  title={copy.title}
  titleImage={copy.titleImage}
  ctaHref={servicesHref}
  ctaLabel={copy.ctaLabel}
>
  <p slot="intro">
    {copy.description.map((segment) =>
      segment.strong ? <strong>{segment.text}</strong> : segment.text
    )}
  </p>

  {articles.map((article, index) => (
    <ShowcaseCard
      number={String(index + 1).padStart(2, "0")}
      title={article.title}
      text={article.text}
      tags={article.tags}
      href={servicesHref}
    />
  ))}
</ShowcaseSection>
