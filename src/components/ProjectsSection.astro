---
// Projects in the same format as Servicios and Tools (artwork title, intro,
// preview cards), followed by the stack of tools used to build them. It is the
// first of the graphite sections, so it fades in from the black of Sobre mí.
import type { AboutSectionContent, ProjectsSectionContent } from "../lib/content-types";
import ShowcaseSection from "./ShowcaseSection.astro";
import ShowcaseCard from "./ShowcaseCard.astro";
import SkillsStack from "./SkillsStack.astro";

interface Props {
  t: ProjectsSectionContent & AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<ShowcaseSection id="projects" title={t.projects.title} titleImage={t.projects.titleImage} blend>
  <p slot="intro">{t.projects.note}</p>

  {t.projects.items.map((project) => (
    <ShowcaseCard
      number={project.id}
      eyebrow={project.category}
      title={project.title}
      text={project.status}
      tags={project.tags}
    />
  ))}

  <SkillsStack slot="after" title={t.about.skillsTitle} groups={t.about.skillGroups} base={base} />
</ShowcaseSection>
