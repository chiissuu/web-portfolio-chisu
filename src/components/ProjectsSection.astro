---
// Projects as a horizontal rail: on desktop the section pins and scrolling
// slides the cards sideways (see ShowcaseSection), with a counter and a
// progress line, and the card at the current position in focus. The stack of
// tools used to build them follows. Light section (satin champagne) after the
// dark Sobre mí.
import type { AboutSectionContent, ProjectsSectionContent } from "../lib/content-types";
import ShowcaseSection from "./ShowcaseSection.astro";
import ProjectCard from "./ProjectCard.astro";
import ProjectMoreCard from "./ProjectMoreCard.astro";
import SkillsStack from "./SkillsStack.astro";
import ProjectArt from "./ProjectArt.astro";

interface Props {
  t: ProjectsSectionContent & AboutSectionContent;
}

const { t } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The introduction is authored plain; the key phrases listed in the content are
// set in bold, like the accents of Sobre mí.
const escape = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const keys = t.projects.noteStrong ?? [];
const noteParts = keys.length
  ? t.projects.note.split(new RegExp(`(${keys.map(escape).join("|")})`, "g")).filter(Boolean)
  : [t.projects.note];

// Taken from the projects themselves so it follows the content: the
// illustrations of the first two projects (the ones listed first are the ones
// featured) at the sides of the head.
const [left, right] = t.projects.items.filter((project) => project.art);
---

<ShowcaseSection id="projects" title={t.projects.title} titleImage={t.projects.titleImage} backdrop="champagne" rail iris center>
  <Fragment slot="deco">
    {left && (
      <div class="pj-motif pj-motif--l" data-deco-l>
        <ProjectArt kind={left.art ?? ""} />
      </div>
    )}
    {right && (
      <div class="pj-motif pj-motif--r" data-deco-r>
        <ProjectArt kind={right.art ?? ""} />
      </div>
    )}
  </Fragment>

  <p slot="intro">
    {noteParts.map((part) => (keys.includes(part) ? <strong>{part}</strong> : part))}
  </p>

  {t.projects.items.map((project) => (
    <ProjectCard
      number={project.id}
      eyebrow={project.status ? `${project.category} · ${project.status}` : project.category}
      title={project.title}
      text={project.description}
      tags={project.tags}
      href={project.href}
      art={project.art}
      metric={project.metric}
      live={!!project.status}
    />
  ))}

  <ProjectMoreCard label={t.projects.moreLabel} href={t.projects.moreHref} />

  <SkillsStack slot="after" title={t.about.skillsTitle} groups={t.about.skillGroups} base={base} />
</ShowcaseSection>

<style>
  /* The illustrations of the first two projects, large and faint. */
  .pj-motif {
    position: absolute;
    top: 4%;
    width: clamp(7rem, 21%, 20rem);
    color: rgb(150 112 34 / 62%);
    will-change: transform;
  }

  .pj-motif--l {
    left: -5rem;
  }

  .pj-motif--r {
    right: -3.5rem;
    top: 10%;
  }

  /* The illustrations knock their lines out with a dark fill; here the
     background is champagne. */
  .pj-motif :global(circle[fill="#0f0e0a"]) {
    fill: #e6dcc2;
  }

  .pj-motif :global(.pj-art-svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
