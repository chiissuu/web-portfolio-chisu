---
// Gold line illustrations for the service cards of the home page, one motif per
// service (see `art` in ServiceArticle). Decorative: the card's text says what
// the service is. Same drawing language as ProjectArt (200x130, `currentColor`
// strokes, nodes filled with the card's dark so lines pass behind them).
interface Props {
  kind?: string;
}

const { kind } = Astro.props as Props;
---

<svg
  class="sv-art"
  viewBox="0 0 200 130"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  aria-hidden="true"
>
  {kind === "flow" && (
    <>
      <rect x="8" y="46" width="40" height="40" rx="6" />
      <path d="M18 58h20M18 66h14M18 74h20" stroke-opacity="0.6" />
      <path d="M48 66h26M68 60l6 6-6 6" />
      <path d="M100 42l24 24-24 24-24-24z" />
      <circle cx="100" cy="66" r="4.5" fill="currentColor" stroke="none" />
      <path d="M124 66h22M140 60l6 6-6 6" />
      <rect x="148" y="46" width="44" height="40" rx="6" fill="currentColor" fill-opacity="0.18" />
      <path d="M159 67l8 8 15-16" />
      <path d="M170 46C170 14 30 14 28 44" stroke-dasharray="3 5" stroke-opacity="0.75" />
      <path d="M22 37l6 8 6-8" />
      <path d="M12 108h40M12 118h26M148 108h44" stroke-opacity="0.35" />
    </>
  )}
  {kind === "web" && (
    <>
      <rect x="16" y="12" width="168" height="106" rx="8" />
      <path d="M16 32h168" />
      <circle cx="28" cy="22" r="2.6" />
      <circle cx="38" cy="22" r="2.6" />
      <circle cx="48" cy="22" r="2.6" />
      <rect x="62" y="17" width="70" height="10" rx="5" stroke-opacity="0.45" />
      <rect x="28" y="44" width="74" height="12" rx="3" fill="currentColor" fill-opacity="0.4" />
      <path d="M28 66h62M28 76h46" stroke-opacity="0.6" />
      <rect x="28" y="90" width="32" height="12" rx="6" />
      <rect x="116" y="44" width="56" height="48" rx="5" />
      <path d="M120 86l14-17 11 11 8-8 15 14" stroke-opacity="0.75" />
      <circle cx="152" cy="56" r="4.2" />
      <path d="M142 96v14l4.5-4 3.5 8 3.6-1.6-3.5-7.6h6.4z" fill="currentColor" fill-opacity="0.55" />
    </>
  )}
  {kind === "audit" && (
    <>
      <rect x="22" y="10" width="86" height="110" rx="8" />
      {[0, 1, 2, 3].map((i) => (
        <>
          <rect x="36" y={28 + i * 21} width="11" height="11" rx="2.5" />
          <path d={`M55 ${33.5 + i * 21}h${i === 1 ? 34 : i === 3 ? 26 : 40}`} stroke-opacity="0.6" />
        </>
      ))}
      <path d="M38.5 33.5l3 3.2 5-6.2" />
      <path d="M38.5 54.5l3 3.2 5-6.2" />
      <circle cx="140" cy="66" r="29" fill="#0f0e0a" fill-opacity="0.7" />
      <path d="M126 59a17 17 0 0 1 15-12" stroke-opacity="0.65" />
      <path d="M160 87l26 28" stroke-width="5" />
    </>
  )}
</svg>
