---
import Layout from "../layouts/Layout.astro";
import { pathFor, type Locale } from "../lib/i18n";
import { content } from "../content/site.js";

// The 404 page of one language (src/pages/404.astro and src/pages/en/404.astro).
interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const nf = content[locale].notFound;
const home = pathFor(locale, "/");
---

<Layout title={`${nf.seo.title} | chiissuu`} description={nf.seo.description} bodyClass="redesign" lang={locale} noindex>
  <main class="nf">
    <div class="nf-thread" aria-hidden="true">
      <span class="nf-line"></span>
      <span class="nf-spark"></span>
      <span class="nf-diamond"></span>
    </div>

    <div class="nf-body">
      <p class="nf-eyebrow">{nf.eyebrow}</p>
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="nf-title">{nf.title}</h1>
      <p class="nf-text">{nf.text}</p>
      <a class="ct-metal" href={home}>
        <span>{nf.cta}</span>
        <span class="ct-metal-icon" aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  /* The site's graphite page with the thread of light cut short: it comes down
     from the top, and the diamond at its end flickers like a lost signal. */
  .nf {
    --nf-gold: #efd683;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100svh;
    overflow-x: clip;
    text-align: center;
    color: #f3f4f5;
    background: linear-gradient(180deg, #050505 0%, #1b1b1f 52%, #050505 100%);
  }

  .nf::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 46% at 50% 40%, rgb(185 154 69 / 20%), transparent 70%);
  }

  .nf-thread {
    position: relative;
    flex: none;
    width: 2px;
    height: clamp(5rem, 20vh, 11rem);
  }

  .nf-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, #c19b3d 40%, var(--nf-gold));
    box-shadow: 0 0 12px 1px rgb(239 214 131 / 35%);
  }

  .nf-spark {
    position: absolute;
    left: -2px;
    top: 0;
    width: 6px;
    height: 22px;
    border-radius: 3px;
    background: linear-gradient(180deg, transparent, #fff3c4);
    filter: blur(0.5px);
    opacity: 0;
    animation: nf-fall 3.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .nf-diamond {
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border: 2px solid var(--nf-gold);
    background: #0b0b0c;
    box-shadow: 0 0 14px 2px rgb(239 214 131 / 55%);
    transform: rotate(45deg);
    animation: nf-flicker 3.2s steps(1, end) infinite;
  }

  .nf-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 38rem;
    padding: 2.5rem clamp(1.25rem, 6vw, 4rem) clamp(3rem, 10vh, 6rem);
  }

  .nf-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-gold);
  }

  .nf-code {
    margin: 0.4rem 0 0.2rem;
    font-family: var(--font-wordmark);
    font-size: clamp(6rem, 24vw, 13rem);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, #f6e3a0 0%, #c19b3d 52%, #7a5a1c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 8px 28px rgb(185 154 69 / 28%));
  }

  .nf-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  .nf-text {
    max-width: 34rem;
    margin-bottom: 2.25rem;
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    color: #adb2b6;
  }

  @keyframes nf-fall {
    0% {
      top: 0;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    70% {
      top: calc(100% - 20px);
      opacity: 1;
    }
    78%,
    100% {
      top: calc(100% - 20px);
      opacity: 0;
    }
  }

  @keyframes nf-flicker {
    0%,
    72% {
      opacity: 1;
    }
    74% {
      opacity: 0.25;
    }
    78% {
      opacity: 1;
    }
    82% {
      opacity: 0.4;
    }
    86%,
    100% {
      opacity: 1;
    }
  }
</style>
