---
import { Mail } from "lucide-astro";
import ContactForm from "./ContactForm.astro";
import type { ContactSectionContent } from "../lib/content-types";
import SectionHeadingCard from "./SectionHeadingCard.astro";
import SectionBackdrop from "./SectionBackdrop.astro";

interface Props {
  t: ContactSectionContent;
}

const { t } = Astro.props as Props;
const links = t.contact.links;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="section-theme-dark ct-section bd-host" id="contact">
  <SectionBackdrop kind="dawn" />
  <div class="section-inner">
    <SectionHeadingCard text={t.contact.title} image={t.contact.titleImage} halo as="h2" size="lg" />

    <p class="ct-lead">{t.contact.text}</p>

    <div class="ct-layout">
      <div class="ct-form-card">
        <ContactForm t={t} />
      </div>

      <aside class="ct-aside">
        <p class="ct-aside-text">{t.contact.emailIntro}</p>

        <a class="ct-channel ct-channel-email" href={`mailto:${links.email}`}>
          <Mail class="ct-channel-icon" size={20} aria-hidden="true" />
          <span class="ct-channel-label">{links.email}</span>
          <span class="ct-channel-arrow" aria-hidden="true">&#8599;</span>
        </a>

        <ul class="ct-channels">
          <li>
            <!-- LinkedIn: no real URL exists anywhere in the content system, so
                 this is intentionally not a link — `aria-disabled`, focusable,
                 with an accessible tooltip (not a permanent "Próximamente"). -->
            <span
              class="ct-channel ct-channel-disabled"
              aria-disabled="true"
              tabindex="0"
              aria-describedby="ct-linkedin-tooltip"
            >
              <img class="ct-channel-logo" src={`${base}/assets/icons/social/linkedin-gold.png`} alt="" aria-hidden="true" width="96" height="96" loading="lazy" decoding="async" />
              <span class="ct-channel-label">{links.linkedinLabel}</span>
              <span class="ct-tooltip" role="tooltip" id="ct-linkedin-tooltip">{links.linkedinTooltip}</span>
            </span>
          </li>
          <li>
            <a class="ct-channel" href={links.github} target="_blank" rel="noopener noreferrer">
              <img class="ct-channel-logo" src={`${base}/assets/icons/social/github-gold.png`} alt="" aria-hidden="true" width="96" height="96" loading="lazy" decoding="async" />
              <span class="ct-channel-label">{links.githubLabel}</span>
              <span class="ct-channel-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </li>
          <li>
            <a class="ct-channel" href={links.linktree} target="_blank" rel="noopener noreferrer">
              <img class="ct-channel-logo" src={`${base}/assets/icons/social/linktree-gold.png`} alt="" aria-hidden="true" width="96" height="96" loading="lazy" decoding="async" />
              <span class="ct-channel-label">{links.linktreeLabel}</span>
              <span class="ct-channel-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Dark section; its background is the "dawn" SectionBackdrop layer. */
  .ct-section {
    --theme-text: #f3f4f5;
    --theme-text-muted: #adb2b6;
    --theme-border: rgb(196 204 209 / 18%);
    --theme-surface: rgb(255 255 255 / 4%);
    --theme-surface-strong: rgb(255 255 255 / 8%);
    color-scheme: dark;
    background: #0b0a09;
  }

  .ct-lead {
    max-width: 46rem;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--theme-text-muted);
    text-wrap: pretty;
  }

  .ct-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* The form panel is a size container: its fields go to one column when the
     panel itself is narrow, whatever the viewport width is. */
  .ct-form-card {
    container-type: inline-size;
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    background: var(--theme-surface);
  }

  .ct-aside {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .ct-aside-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--theme-text-muted);
  }

  .ct-channels {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ct-channel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    min-height: 3.4rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    background: var(--theme-surface);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--theme-text);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .ct-channel-email {
    font-size: 0.9rem;
    border-color: rgb(224 197 139 / 45%);
    background:
      linear-gradient(135deg, rgba(138, 106, 31, 0.16), transparent 60%),
      var(--theme-surface);
  }

  .ct-channel:not(.ct-channel-disabled):hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-gold);
  }

  .ct-channel:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 3px;
  }

  .ct-channel-logo {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .ct-channel :global(.ct-channel-icon) {
    flex-shrink: 0;
    color: var(--color-brand-gold);
  }

  .ct-channel-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ct-channel-arrow {
    color: var(--color-brand-gold);
  }

  .ct-channel-disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .ct-tooltip {
    position: absolute;
    inset-block-end: calc(100% + 0.5rem);
    inset-inline-start: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--theme-border);
    border-radius: 8px;
    background: #0d0d0d;
    color: var(--theme-text);
    font-size: 0.78rem;
    font-weight: 400;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .ct-channel-disabled:hover .ct-tooltip,
  .ct-channel-disabled:focus-visible .ct-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 1100px) {
    .ct-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
