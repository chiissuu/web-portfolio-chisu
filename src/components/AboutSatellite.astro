---
// Decorative gold line illustration that sits in the empty half beside a
// journey card (see AboutSection.astro), joined to the thread by a short
// branch. It repeats no facts beyond what the card already says, adds no
// copy of its own (only short, language-neutral labels) and is hidden from
// assistive technology. It lights up together with its card.
interface Props {
  kind: string;
  base: string;
}

const { kind, base } = Astro.props as Props;
const flag = (country: string) => `${base}/assets/icons/flags/${country}.svg`;

const bars = [30, 56, 40, 76, 50, 68, 34, 60, 24];
---

<div class="ab-sat" data-sat={kind} aria-hidden="true">
  <span class="ab-sat-link"></span>
  <span class="ab-sat-dot"></span>
  <svg class="ab-sat-art" viewBox="0 0 240 150" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {kind === "terminal" && (
      <>
        <rect class="d" pathLength="1" style="--i:0" x="6" y="8" width="228" height="134" rx="10" />
        <path class="d" pathLength="1" style="--i:2" d="M6 34 H234" />
        <circle class="f" style="--i:3" cx="22" cy="21" r="3.2" fill="currentColor" stroke="none" />
        <circle class="f" style="--i:4" cx="35" cy="21" r="3.2" fill="currentColor" stroke="none" />
        <circle class="f" style="--i:5" cx="48" cy="21" r="3.2" fill="currentColor" stroke="none" />
        <text class="t mono" style="--i:6" x="20" y="62" stroke="none">$ whoami</text>
        <text class="t mono hi" style="--i:9" x="20" y="84" stroke="none">jesus-leon</text>
        <text class="t mono dim" style="--i:12" x="20" y="106" stroke="none"># U-TAD · Madrid</text>
        <rect class="t cursor" style="--i:14" x="20" y="116" width="7" height="13" fill="currentColor" stroke="none" />
      </>
    )}
    {kind === "stack" && (
      <>
        <rect class="d" pathLength="1" style="--i:4" x="64" y="14" width="168" height="30" rx="8" />
        <rect class="d" pathLength="1" style="--i:2" x="64" y="56" width="168" height="30" rx="8" />
        <rect class="d" pathLength="1" style="--i:0" x="64" y="98" width="168" height="30" rx="8" />
        <path class="d" pathLength="1" style="--i:3" d="M148 44 V56 M144 52 L148 56 L152 52" />
        <path class="d" pathLength="1" style="--i:1" d="M148 86 V98 M144 94 L148 98 L152 94" />
        <text class="t mono" style="--i:5" x="80" y="33" stroke="none">UI</text>
        <text class="t mono" style="--i:3" x="80" y="75" stroke="none">API</text>
        <text class="t mono" style="--i:1" x="80" y="117" stroke="none">BD</text>
        <rect class="d" pathLength="1" style="--i:6" x="176" y="22" width="44" height="14" rx="3" />
        <path class="d" pathLength="1" style="--i:6" d="M176 28 H220" />
        <path class="d" pathLength="1" style="--i:4" d="M178 66 H214 M207 60 L214 66 L207 72 M214 77 H178 M185 71 L178 77 L185 83" />
        <ellipse class="d" pathLength="1" style="--i:2" cx="198" cy="106" rx="16" ry="4" />
        <path class="d" pathLength="1" style="--i:2" d="M182 106 V120 A16 4 0 0 0 214 120 V106 M182 113 A16 4 0 0 0 214 113" />
      </>
    )}
    {kind === "languages" && (
      <>
        <image class="f" style="--i:0" href={flag("es")} x="8" y="18" width="24" height="18" />
        <text class="t mono" style="--i:1" x="42" y="31" stroke="none">ES</text>
        <rect class="d dimline" pathLength="1" style="--i:1" x="100" y="23" width="132" height="8" rx="4" />
        <rect class="bar" style="--i:2;--w:1" x="100" y="23" width="132" height="8" rx="4" fill="currentColor" stroke="none" />

        <image class="f" style="--i:2" href={flag("gb")} x="8" y="64" width="24" height="18" />
        <text class="t mono" style="--i:3" x="42" y="77" stroke="none">EN · C1</text>
        <rect class="d dimline" pathLength="1" style="--i:3" x="100" y="69" width="132" height="8" rx="4" />
        <rect class="bar" style="--i:4;--w:.83" x="100" y="69" width="132" height="8" rx="4" fill="currentColor" stroke="none" />

        <image class="f" style="--i:4" href={flag("de")} x="8" y="110" width="24" height="18" />
        <text class="t mono" style="--i:5" x="42" y="123" stroke="none">DE · A2</text>
        <rect class="d dimline" pathLength="1" style="--i:5" x="100" y="115" width="132" height="8" rx="4" />
        <rect class="bar" style="--i:6;--w:.33" x="100" y="115" width="132" height="8" rx="4" fill="currentColor" stroke="none" />
      </>
    )}
    {kind === "venn" && (
      <>
        <circle class="d" pathLength="1" style="--i:0" cx="120" cy="48" r="36" />
        <circle class="d" pathLength="1" style="--i:2" cx="92" cy="92" r="36" />
        <circle class="d" pathLength="1" style="--i:4" cx="148" cy="92" r="36" />
        <circle class="f" style="--i:7" cx="120" cy="78" r="4" fill="#efd683" stroke="none" />
        <text class="t mono" style="--i:3" x="164" y="30" stroke="none">TECH</text>
        <text class="t mono" style="--i:5" x="48" y="128" text-anchor="end" stroke="none">DESIGN</text>
        <text class="t mono" style="--i:7" x="190" y="128" stroke="none">BUSINESS</text>
      </>
    )}
    {kind === "team" && (
      <>
        <circle class="d" pathLength="1" style="--i:0" cx="76" cy="75" r="42" />
        <circle class="d" pathLength="1" style="--i:2" cx="76" cy="75" r="11" />
        <path class="d" pathLength="1" style="--i:3" d="M76 25 V50 M76 100 V125 M26 75 H51 M101 75 H126" />
        <circle class="f" style="--i:5" cx="76" cy="75" r="2.4" fill="#efd683" stroke="none" />
        <path class="d" pathLength="1" style="--i:4" d="M150 75 H230" />
        <circle class="f dot" style="--i:5" cx="150" cy="75" r="6.5" fill="currentColor" />
        <circle class="f dot" style="--i:6" cx="170" cy="75" r="6.5" fill="currentColor" />
        <circle class="f dot" style="--i:7" cx="190" cy="75" r="6.5" fill="currentColor" />
        <circle class="f dot" style="--i:8" cx="210" cy="75" r="6.5" fill="currentColor" />
        <circle class="f dot" style="--i:9" cx="230" cy="75" r="6.5" fill="currentColor" />
        <text class="t mono dim" style="--i:10" x="190" y="104" text-anchor="middle" stroke="none">TEAM-FIRST</text>
      </>
    )}
    {kind === "culture" && (
      <>
        {bars.map((h, i) => (
          <rect class="f eq" style={`--i:${i}`} x={10 + i * 13} y={118 - h} width="7" height={h} rx="2.5" fill="currentColor" stroke="none" />
        ))}
        <g transform="rotate(-6 158 38)">
          <rect class="d" pathLength="1" style="--i:1" x="138" y="14" width="40" height="48" rx="6" />
          <path class="d" pathLength="1" style="--i:3" d="M158 26 L162 34 L170 38 L162 42 L158 50 L154 42 L146 38 L154 34 Z" />
        </g>
        <g transform="rotate(5 204 50)">
          <rect class="d" pathLength="1" style="--i:2" x="184" y="26" width="40" height="48" rx="6" />
          <path class="d" pathLength="1" style="--i:4" d="M204 61 C190 51 192 41 199 41 C202 41 204 43 204 45 C204 43 206 41 209 41 C216 41 218 51 204 61 Z" />
        </g>
        <g transform="rotate(3 183 103)">
          <rect class="d" pathLength="1" style="--i:3" x="161" y="78" width="44" height="50" rx="6" />
          <path class="d" pathLength="1" style="--i:5" d="M180 92 A3.6 3.6 0 1 1 185 95 L183 99 M183 99 L167 112 Q165 115 169 115 H197 Q201 115 199 112 Z" />
        </g>
      </>
    )}
    {kind === "layers" && (
      <>
        <path class="d lay" pathLength="1" style="--i:0" d="M110 90 L170 110 L110 130 L50 110 Z" />
        <path class="d lay" pathLength="1" style="--i:2" d="M110 64 L170 84 L110 104 L50 84 Z" />
        <path class="d lay" pathLength="1" style="--i:4" d="M110 38 L170 58 L110 78 L50 58 Z" />
        <path class="d lay" pathLength="1" style="--i:6" d="M110 12 L170 32 L110 52 L50 32 Z" />
        <text class="t mono" style="--i:1" x="178" y="114" stroke="none">CODE</text>
        <text class="t mono" style="--i:3" x="178" y="88" stroke="none">DESIGN</text>
        <text class="t mono" style="--i:5" x="178" y="62" stroke="none">BUSINESS</text>
        <text class="t mono" style="--i:7" x="178" y="36" stroke="none">CULTURE</text>
      </>
    )}
    {kind === "project" && (
      <>
        <rect class="d dimline" pathLength="1" style="--i:0" x="40" y="22" width="150" height="104" rx="10" />
        <rect class="d dimline" pathLength="1" style="--i:1" x="30" y="14" width="150" height="104" rx="10" />
        <rect class="d" pathLength="1" style="--i:3" x="20" y="6" width="150" height="104" rx="10" />
        <rect class="d" pathLength="1" style="--i:4" x="30" y="16" width="130" height="46" rx="5" />
        <path class="d" pathLength="1" style="--i:5" d="M30 54 L62 34 L84 48 L106 28 L160 58" />
        <path class="d" pathLength="1" style="--i:6" d="M30 74 H120 M30 86 H92" />
        <rect class="f" style="--i:8" x="30" y="95" width="44" height="8" rx="4" fill="currentColor" stroke="none" />
        <path class="d" pathLength="1" style="--i:7" d="M206 20 L211 33 L224 38 L211 43 L206 56 L201 43 L188 38 L201 33 Z" />
        <path class="d" pathLength="1" style="--i:9" d="M222 74 L225 81 L232 84 L225 87 L222 94 L219 87 L212 84 L219 81 Z" />
        <path class="d" pathLength="1" style="--i:10" d="M180 124 H228 M219 116 L228 124 L219 132" />
      </>
    )}
  </svg>
</div>

<style>
  .ab-sat {
    position: absolute;
    top: 0;
    width: 100%;
    color: #f2dc92;
    pointer-events: none;
  }

  /* Soft gold backlight behind the drawing, lit with it. */
  .ab-sat::before {
    content: "";
    position: absolute;
    top: -2rem;
    z-index: -1;
    width: min(100%, 22rem);
    height: 15rem;
    background: radial-gradient(closest-side, rgb(239 214 131 / 20%), rgb(224 197 139 / 7%) 60%, transparent);
    transition: opacity 0.9s ease 0.3s;
  }

  :global(.ab-step--left) .ab-sat::before {
    left: 0;
  }

  :global(.ab-step--right) .ab-sat::before {
    right: 0;
  }

  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .ab-sat::before {
    opacity: 0;
    transition-delay: 0s;
  }

  :global(.ab-step--left) .ab-sat {
    left: calc(100% + var(--ab-gutter));
  }

  :global(.ab-step--right) .ab-sat {
    right: calc(100% + var(--ab-gutter));
  }

  /* The branch runs from the card's node across the gutter to a small dot,
     the "point between points", which the illustration hangs from. */
  .ab-sat-link,
  .ab-sat-dot {
    position: absolute;
    top: 1.75rem;
  }

  .ab-sat-link {
    width: var(--ab-gutter);
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    transition: transform 0.45s ease 0.1s;
  }

  :global(.ab-step--left) .ab-sat-link {
    left: calc(-1 * var(--ab-gutter));
    background: linear-gradient(90deg, rgb(239 214 131 / 90%), rgb(224 197 139 / 35%));
    transform-origin: left center;
  }

  :global(.ab-step--right) .ab-sat-link {
    right: calc(-1 * var(--ab-gutter));
    background: linear-gradient(270deg, rgb(239 214 131 / 90%), rgb(224 197 139 / 35%));
    transform-origin: right center;
  }

  .ab-sat-dot {
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: #efd683;
    box-shadow: 0 0 0 4px rgb(224 197 139 / 16%), 0 0 12px rgb(224 197 139 / 55%);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s, opacity 0.2s ease 0.5s;
  }

  :global(.ab-step--left) .ab-sat-dot {
    left: -4.5px;
  }

  :global(.ab-step--right) .ab-sat-dot {
    right: -4.5px;
  }

  .ab-sat-art {
    display: block;
    width: min(100%, 17rem);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 0 5px rgb(239 214 131 / 55%)) drop-shadow(0 0 16px rgb(224 197 139 / 32%));
  }

  :global(.ab-step--left) .ab-sat-art {
    margin-inline-start: 1.5rem;
  }

  :global(.ab-step--right) .ab-sat-art {
    margin-inline-start: auto;
    margin-inline-end: 1.5rem;
  }

  .mono {
    font: 600 10.5px/1 var(--font-mono, ui-monospace, "Cascadia Mono", Consolas, monospace);
    letter-spacing: 0.04em;
    fill: currentColor;
  }

  .mono.hi {
    fill: #efd683;
  }

  .mono.dim {
    fill: rgb(239 214 131 / 78%);
  }

  .dimline {
    stroke: rgb(239 214 131 / 58%);
  }

  .dot {
    stroke: none;
  }

  /* Drawn strokes use pathLength="1" so one dash pattern fits every shape. */
  .d {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.9s ease calc(0.6s + var(--i, 0) * 0.08s),
      stroke-opacity 0s linear calc(0.6s + var(--i, 0) * 0.08s);
  }

  .lay {
    fill: rgb(224 197 139 / 9%);
    transition: stroke-dashoffset 0.9s ease calc(0.6s + var(--i, 0) * 0.08s),
      stroke-opacity 0s linear calc(0.6s + var(--i, 0) * 0.08s),
      fill 0.8s ease calc(0.9s + var(--i, 0) * 0.08s);
  }

  .f,
  .t {
    transition: opacity 0.6s ease calc(0.7s + var(--i, 0) * 0.08s);
  }

  .bar {
    transform: scaleX(var(--w, 1));
    transform-box: fill-box;
    transform-origin: left center;
    transition: transform 1s ease calc(0.7s + var(--i, 0) * 0.12s);
  }

  .eq {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  /* Unlit (script on): everything is held back, and switches off quickly. */
  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .ab-sat-link {
    transform: scaleX(0);
    transition-delay: 0s;
    transition-duration: 0.2s;
  }

  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .ab-sat-dot {
    transform: scale(0);
    opacity: 0;
    transition-delay: 0s;
    transition-duration: 0.2s;
  }

  /* A zero-length dash with round caps still paints a dot, so the stroke is
     also made invisible once it has been retracted (and shown again just as
     the drawing starts). */
  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .d {
    stroke-dashoffset: 1;
    stroke-opacity: 0;
    transition: stroke-dashoffset 0.2s ease, stroke-opacity 0s linear 0.2s;
  }

  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .lay {
    fill: transparent;
    transition: stroke-dashoffset 0.2s ease, stroke-opacity 0s linear 0.2s, fill 0.2s ease;
  }

  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .f,
  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .t {
    opacity: 0;
    transition-delay: 0s;
    transition-duration: 0.2s;
  }

  :global(.ab-journey.ab-js .ab-step:not(.is-lit)) .bar {
    transform: scaleX(0);
    transition-delay: 0s;
    transition-duration: 0.2s;
  }

  /* Alive once lit: the equalizer dances and the terminal cursor blinks. */
  :global(.ab-journey.ab-js .ab-step.is-lit) .eq {
    animation: ab-sat-eq 1s ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * -0.17s);
  }

  :global(.ab-journey.ab-js .ab-step.is-lit) .cursor {
    animation: ab-sat-blink 1.1s steps(1) 1.4s infinite;
  }

  @keyframes ab-sat-eq {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes ab-sat-blink {
    50% {
      opacity: 0;
    }
  }

  /* Born switched off without a fade (first frames of the script). */
  :global(.ab-journey.ab-nt) .ab-sat *,
  :global(.ab-journey.ab-nt) .ab-sat-link,
  :global(.ab-journey.ab-nt) .ab-sat-dot {
    transition: none !important;
  }

  /* No room beside the cards in the single-column layout. */
  @media (max-width: 899px) {
    .ab-sat {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ab-journey .ab-step) .eq,
    :global(.ab-journey .ab-step) .cursor {
      animation: none;
    }
  }
</style>
